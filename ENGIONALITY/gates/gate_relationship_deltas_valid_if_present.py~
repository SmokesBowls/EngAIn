from __future__ import annotations

from engain_control.gate_result import GateResult

def gate_relationship_deltas_valid_if_present() -> GateResult:
    for entity in TEST_PACKET.get("entities", []):
        rel_deltas = entity.get("relationship_deltas")
        
        # BYPASS CONDITION: Field is optional. If missing, step aside cleanly.
        if rel_deltas is None:
            return GateResult(
                "gate_relationship_deltas_valid_if_present",
                "SKIPPED",
                "BYPASS: relationship_deltas is optional and absent",
            )
        
        if not isinstance(rel_deltas, list):
            return GateResult("gate_relationship_deltas_valid_if_present", "FALSE", "relationship_deltas must be a list")
            
        for rel in rel_deltas:
            if "target_id" not in rel or "axis" not in rel or "delta" not in rel:
                return GateResult("gate_relationship_deltas_valid_if_present", "FALSE", "relationship_delta missing required fields (target_id, axis, delta)")
            if not isinstance(rel["delta"], (int, float)) or not (-1.0 <= rel["delta"] <= 1.0):
                return GateResult("gate_relationship_deltas_valid_if_present", "FALSE", f"relationship_delta out of bounds: {rel['delta']}")

    return GateResult("gate_relationship_deltas_valid_if_present", "TRUE", "relationship_deltas validated successfully")