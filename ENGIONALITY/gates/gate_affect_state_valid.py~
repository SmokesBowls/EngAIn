from __future__ import annotations

from engain_control.gate_result import GateResult

def gate_affect_state_present_and_string() -> GateResult:
    for entity in TEST_PACKET.get("entities", []):
        affect_state = entity.get("affect_state")
        if affect_state is None:
            return GateResult("gate_affect_state_present_and_string", "FALSE", f"Missing affect_state for {entity.get('entity_id')}")
        if not isinstance(affect_state, str) or len(affect_state.strip()) == 0:
            return GateResult("gate_affect_state_present_and_string", "FALSE", f"affect_state must be a non-empty string")
    return GateResult("gate_affect_state_present_and_string", "TRUE", "All entities have valid string affect_state")