from __future__ import annotations

from engain_control.gate_result import GateResult

def gate_scene_mood_valid_if_present() -> GateResult:
    scene_mood = TEST_PACKET.get("scene_mood")
    
    # BYPASS CONDITION: Field is optional.
    if scene_mood is None:
        return GateResult(
            "gate_scene_mood_valid_if_present",
            "SKIPPED",
            "BYPASS: scene_mood is optional and absent",
        )
    
    if not isinstance(scene_mood, dict):
        return GateResult("gate_scene_mood_valid_if_present", "FALSE", "scene_mood must be a dictionary")
    if "dominant" not in scene_mood or not isinstance(scene_mood["dominant"], str):
        return GateResult("gate_scene_mood_valid_if_present", "FALSE", "scene_mood missing valid 'dominant' string")
    if "intensity" not in scene_mood or not (0.0 <= scene_mood["intensity"] <= 1.0):
        return GateResult("gate_scene_mood_valid_if_present", "FALSE", "scene_mood intensity missing or out of bounds [0.0, 1.0]")

    return GateResult("gate_scene_mood_valid_if_present", "TRUE", "scene_mood validated successfully")