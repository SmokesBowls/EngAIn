def build_scene_shell(
    scene_id: str,
    chapter_text: str,
    config: WorldGridConfig,
    corpus_hints: Optional[Dict[str, str]] = None,
    world_tags: Optional[List[str]] = None,
    snapshot: Optional[Dict[str, Any]] = None,
) -> List[Dict]:
    """
    Build a list of world deltas describing a scene "shell"
    inferred from narrative.

    Mutation sequence:
      1. Initialize temp_snapshot (from provided snapshot or empty grid).
      2. Generate beach bands → add to deltas → mutate temp_snapshot.
      3. Generate pier → add to deltas → mutate temp_snapshot.
      4. Generate secret path → add to deltas → mutate temp_snapshot.
      5. Generate construction → add to deltas.

    This ensure later features can see and avoid earlier features.
    """
    hints = SceneHints(
        scene_id=scene_id,
        chapter_text=chapter_text,
        corpus_hints=corpus_hints,
        world_tags=world_tags,
    )

    flags = classify_scene(hints)

    # Internal state for placement logic
    current_snapshot = snapshot
    if current_snapshot is None:
        cells = create_empty_grid(config)
        current_snapshot = {
            "trixel_world": {
                "cells": cells,
                "features": {},
                "skin_table": {},
                "tick": 0.0,
            }
        }

    deltas: List[Dict] = []

    # 1. Base terrain: if it's a beach-y scene, lay down canonical bands.
    if flags["is_beach"]:
        beach_deltas = _generate_beach_bands(config)
        deltas.extend(beach_deltas)
        current_snapshot, _, _ = step_trixel_world(
            current_snapshot, beach_deltas, config
        )

    # 2. Pier / dock feature
    if flags["has_pier"]:
        pier_deltas = _generate_pier_feature(
            config,
            scene_id,
            snapshot=current_snapshot,
            assume_beach=flags["is_beach"],
        )
        deltas.extend(pier_deltas)
        current_snapshot, _, _ = step_trixel_world(current_snapshot, pier_deltas, config)

    # 3. Secret path / hidden route
    if flags["has_secret"]:
        secret_deltas = _generate_secret_path(
            config,
            scene_id,
            snapshot=current_snapshot,
            assume_beach=flags["is_beach"],
        )
        deltas.extend(secret_deltas)
        current_snapshot, _, _ = step_trixel_world(
            current_snapshot, secret_deltas, config
        )

    # 4. Construction / pyramid zone
    if flags["has_construction"]:
        con_deltas = _generate_construction_site(scene_id, config, current_snapshot)
        deltas.extend(con_deltas)
        # (Last one in sequence, no need to update snapshot unless we add more steps)

    # Tag deltas with scene_id for provenance
    for d in deltas:
        payload = d.setdefault("payload", {})
        if "scene_id" not in payload:
            payload["scene_id"] = scene_id

    return deltas


