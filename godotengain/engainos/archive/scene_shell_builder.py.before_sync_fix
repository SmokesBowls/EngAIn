def _make_region(
    x_min: int,
    y_min: int,
    x_max: int,
    y_max: int,
    terrain: TerrainType,
    skin_id: Optional[str] = None,
) -> Dict:
    payload: Dict[str, object] = {
        "x_min": x_min,
        "y_min": y_min,
        "x_max": x_max,
        "y_max": y_max,
        "terrain_type": terrain.value,
    }
    if skin_id is not None:
        payload["skin_id"] = skin_id
    return {
        "id": f"fill_{terrain.value}_{x_min}_{y_min}_{x_max}_{y_max}",
        "type": "fill_region",
        "payload": payload,
    }


def _make_feature(
    feature_id: str,
    feature_type: str,
    cell_ids: List[str],
    narrative_source: str,
    confidence: str,
) -> Dict:
    return {
        "id": f"feat_{feature_id}",
        "type": "add_feature",
        "payload": {
            "feature_id": feature_id,
            "feature_type": feature_type,
            "cell_ids": cell_ids,
            "narrative_source": narrative_source,
            "confidence": confidence,
            "activation_conditions": [],
        },
    }


def _make_secret_override(scene_id: str, cell_ids: List[str]) -> Dict:
    return {
        "id": f"override_secret_path_{scene_id}",
        "type": "add_override",
        "payload": {
            "cell_ids": cell_ids,
            "tag": "secret_path",
        },
    }



def _stable_hash_int(*parts: object) -> int:
    blob = "|".join(str(p) for p in parts).encode("utf-8")
    return int.from_bytes(sha256(blob).digest()[:8], "big", signed=False)


def _world_view(snapshot: Dict[str, Any]) -> Dict[str, Any]:
    """
    Normalize snapshot to the inner world dict.

    Accepts either:
      { "trixel_world": {...} }
    or:
      { "cells": ..., "features": ..., "skin_table": ..., "tick": ... }

    Returns the inner world mapping.
    """
    return snapshot.get("trixel_world", snapshot)


def _stable_index(key: str, count: int) -> int:
    """
    Deterministic, cross-run-stable index in [0, count).

    Uses SHA-256 over the provided key. Python's built-in hash()
    is salted per process, so we avoid it.
    """
    if count <= 0:
        raise ValueError("count must be > 0")
    digest = sha256(key.encode("utf-8")).digest()
    value = int.from_bytes(digest[:8], "big")
    return value % count


def _find_construction_footprint(
    scene_id: str,
    config: WorldGridConfig,
    snapshot: Dict[str, Any],
) -> Optional[List[str]]:
    """
    Find a 3×3 construction footprint on sand, buffered inland from shoreline,
    avoiding protected cells and existing explicit features.

    Returns:
        List of 9 cell_ids, or None if no valid spot.
    """
    world = _world_view(snapshot)
    cells = world.get("cells", {})
    features = world.get("features", {})

    grid_w = config.grid_width
    grid_h = config.grid_height

    shoreline_rows: set[int] = set()
    sand_rows: set[int] = set()

    for cid, c in cells.items():
        t = c.get("terrain_type")
        y = c.get("y")
        # Fallback if y is not explicitly in the cell dict
        if y is None:
            parts = cid.split("_")
            if len(parts) >= 4:
                y = int(parts[3])

        if t == TerrainType.SHORELINE.value:
            if y is not None:
                shoreline_rows.add(y)
        elif t == TerrainType.SAND.value:
            if y is not None:
                sand_rows.add(y)

    if not sand_rows:
        return None

    shore_max = max(shoreline_rows) if shoreline_rows else -1
    # Buffer of one sand row above shoreline
    inland_rows = [r for r in sorted(sand_rows) if r > shore_max + 1]
    if not inland_rows:
        return None

    # Protected mask
    protected: set[str] = set()
    for cid, c in cells.items():
        if (
            c.get("feature_ids")
            or c.get("override_tags")
            or c.get("socket_ids")
            or c.get("state_flags")
        ):
            protected.add(cid)

    for fid, f in features.items():
        conf = f.get("confidence", "").lower()
        if conf == "explicit":
            for cid in f.get("cell_ids", []):
                protected.add(cid)

    candidates: List[List[str]] = []

    for y in inland_rows:
        if y + 2 >= grid_h:
            continue
        for x in range(0, grid_w - 2):
            block_ids: List[str] = []
            ok = True
            for yy in range(y, y + 3):
                for xx in range(x, x + 3):
                    cid = make_cell_id(xx, yy)
                    cell = cells.get(cid)
                    if not cell:
                        ok = False
                        break
                    if cell.get("terrain_type") != TerrainType.SAND.value:
                        ok = False
                        break
                    if cid in protected:
                        ok = False
                        break
                    block_ids.append(cid)
                if not ok:
                    break
            if ok and len(block_ids) == 9:
                candidates.append(block_ids)

    if not candidates:
        return None

    idx = _stable_index(f"{scene_id}:pyramid_site_01", len(candidates))
    return candidates[idx]




def _extract_snapshot_cells(snapshot: Optional[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    if not snapshot:
        return {}

    world = _world_view(snapshot)
    cells = world.get("cells", {})
    if isinstance(cells, dict):
        return cells

    return {}


def _build_synthetic_terrain_lookup(config: WorldGridConfig, assume_beach: bool) -> Dict[str, str]:
    terrain_by_cell: Dict[str, str] = {}

    for y in range(config.grid_height):
        for x in range(config.grid_width):
            terrain_by_cell[make_cell_id(x, y)] = config.default_terrain

    if not assume_beach:
        return terrain_by_cell

    for y in range(config.grid_height):
        if y <= 2:
            terrain = TerrainType.DEEP_WATER.value
        elif y <= 4:
            terrain = TerrainType.SHALLOW_WATER.value
        elif y == 5:
            terrain = TerrainType.SHORELINE.value
        elif y <= 10:
            terrain = TerrainType.SAND.value
        elif y <= 13:
            terrain = TerrainType.GRASS.value
        elif y <= 15:
            terrain = TerrainType.FOREST_EDGE.value
        else:
            terrain = config.default_terrain

        for x in range(config.grid_width):
            terrain_by_cell[make_cell_id(x, y)] = terrain

    return terrain_by_cell


def _cell_terrain(
    x: int,
    y: int,
    config: WorldGridConfig,
    snapshot_cells: Dict[str, Dict[str, Any]],
    synthetic_terrain: Dict[str, str],
) -> str:
    if x < 0 or y < 0 or x >= config.grid_width or y >= config.grid_height:
        return config.default_terrain

    cid = make_cell_id(x, y)
    cell = snapshot_cells.get(cid)
    if isinstance(cell, dict):
        terrain = cell.get("terrain_type")
        if isinstance(terrain, str) and terrain:
            return terrain
    return synthetic_terrain.get(cid, config.default_terrain)


def _cell_bool_flag(
    x: int,
    y: int,
    config: WorldGridConfig,
    snapshot_cells: Dict[str, Dict[str, Any]],
    key: str,
) -> bool:
    if x < 0 or y < 0 or x >= config.grid_width or y >= config.grid_height:
        return True

    cell = snapshot_cells.get(make_cell_id(x, y), {})
    if not isinstance(cell, dict):
        return False
    return bool(cell.get(key, False))


def _cell_has_payload(
    x: int,
    y: int,
    config: WorldGridConfig,
    snapshot_cells: Dict[str, Dict[str, Any]],
    key: str,
) -> bool:
    if x < 0 or y < 0 or x >= config.grid_width or y >= config.grid_height:
        return True

    cell = snapshot_cells.get(make_cell_id(x, y), {})
    if not isinstance(cell, dict):
        return False

    value = cell.get(key, ())
    if value is None:
        return False
    return len(tuple(value)) > 0


def _cell_is_protected(
    x: int,
    y: int,
    config: WorldGridConfig,
    snapshot_cells: Dict[str, Dict[str, Any]],
) -> bool:
    return any(
        (
            _cell_has_payload(x, y, config, snapshot_cells, "feature_ids"),
            _cell_has_payload(x, y, config, snapshot_cells, "override_tags"),
            _cell_has_payload(x, y, config, snapshot_cells, "socket_ids"),
            _cell_has_payload(x, y, config, snapshot_cells, "state_flags"),
        )
    )


def _pick_secret_path_cells(
    scene_id: str,
    config: WorldGridConfig,
    snapshot: Optional[Dict[str, Any]] = None,
    assume_beach: bool = False,
) -> List[str]:
    if config.grid_height < 15:
        return []

    snapshot_cells = _extract_snapshot_cells(snapshot)
    synthetic_terrain = _build_synthetic_terrain_lookup(config, assume_beach)

    y0 = 14
    y1 = min(config.grid_height - 1, 15)
    candidates: List[Tuple[float, List[str]]] = []

    for col in range(config.grid_width):
        coords = [(col, y) for y in range(y0, y1 + 1)]
        if any(_cell_is_protected(x, y, config, snapshot_cells) for x, y in coords):
            continue
        if any(_cell_bool_flag(x, y, config, snapshot_cells, "blocker") for x, y in coords):
            continue

        terrains = [
            _cell_terrain(x, y, config, snapshot_cells, synthetic_terrain)
            for x, y in coords
        ]
        if not all(t == TerrainType.FOREST_EDGE.value for t in terrains):
            continue

        open_neighbors = 0
        grass_contacts = 0
        for x, y in coords:
            for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
                if 0 <= nx < config.grid_width and 0 <= ny < config.grid_height:
                    if not _cell_bool_flag(nx, ny, config, snapshot_cells, "blocker"):
                        open_neighbors += 1
                    if _cell_terrain(nx, ny, config, snapshot_cells, synthetic_terrain) == TerrainType.GRASS.value:
                        grass_contacts += 1

        if open_neighbors == 0:
            continue

        interior_bonus = 1.0 if 0 < col < (config.grid_width - 1) else 0.0
        jitter = (_stable_hash_int(scene_id, "secret_path_01", col) % 10000) / 10000.0
        score = (grass_contacts * 100.0) + (open_neighbors * 5.0) + interior_bonus + jitter
        candidates.append((score, [make_cell_id(col, y) for _, y in coords]))

    if not candidates:
        fallback_col = max(0, min(config.grid_width - 1, config.grid_width // 2))
        return [make_cell_id(fallback_col, y) for y in range(y0, y1 + 1)]

    candidates.sort(key=lambda item: (-item[0], item[1]))
    return candidates[0][1]


def _pick_pier_cells(
    scene_id: str,
    config: WorldGridConfig,
    snapshot: Optional[Dict[str, Any]] = None,
    assume_beach: bool = False,
) -> List[str]:
    """
    Pick a deterministic 2x6 pier footprint that:
      - touches shoreline on its southern edge
      - extends northward into shallow/deep water
      - avoids protected / blocked cells
    """
    if config.grid_width < 2 or config.grid_height < 6:
        return []

    snapshot_cells = _extract_snapshot_cells(snapshot)
    synthetic_terrain = _build_synthetic_terrain_lookup(config, assume_beach)

    candidates: List[Tuple[float, List[str]]] = []

    for shoreline_y in range(config.grid_height):
        for col_a in range(config.grid_width - 1):
            cols = (col_a, col_a + 1)
            y_start = shoreline_y - 5
            if y_start < 0:
                continue

            footprint = [(x, y) for y in range(y_start, shoreline_y + 1) for x in cols]
            if any(_cell_is_protected(x, y, config, snapshot_cells) for x, y in footprint):
                continue
            if any(_cell_bool_flag(x, y, config, snapshot_cells, "blocker") for x, y in footprint):
                continue

            shoreline_cells = [(x, shoreline_y) for x in cols]
            shoreline_terrains = [
                _cell_terrain(x, shoreline_y, config, snapshot_cells, synthetic_terrain)
                for x in cols
            ]
            if not all(t == TerrainType.SHORELINE.value for t in shoreline_terrains):
                continue

            water_coords = [(x, y) for y in range(y_start, shoreline_y) for x in cols]
            water_terrains = [
                _cell_terrain(x, y, config, snapshot_cells, synthetic_terrain)
                for x, y in water_coords
            ]
            if not water_terrains:
                continue

            if not all(t in (TerrainType.SHALLOW_WATER.value, TerrainType.DEEP_WATER.value) for t in water_terrains):
                continue

            shallow_count = sum(1 for t in water_terrains if t == TerrainType.SHALLOW_WATER.value)
            deep_count = sum(1 for t in water_terrains if t == TerrainType.DEEP_WATER.value)
            if shallow_count == 0:
                continue

            south_contacts = 0
            sand_contacts = 0
            for x in cols:
                south_y = shoreline_y + 1
                if south_y < config.grid_height:
                    south_t = _cell_terrain(x, south_y, config, snapshot_cells, synthetic_terrain)
                    if south_t in (TerrainType.SAND.value, TerrainType.GRASS.value, TerrainType.FOREST_EDGE.value):
                        south_contacts += 1
                    if south_t == TerrainType.SAND.value:
                        sand_contacts += 1

            if south_contacts == 0:
                continue

            interior_bonus = 1.0 if 0 < col_a < (config.grid_width - 2) else 0.0
            water_bonus = (shallow_count * 15.0) + (deep_count * 10.0)
            shore_bonus = (south_contacts * 50.0) + (sand_contacts * 25.0)
            jitter = (_stable_hash_int(scene_id, "pier_main", col_a, shoreline_y) % 10000) / 10000.0
            score = shore_bonus + water_bonus + interior_bonus + jitter
            candidates.append((score, [make_cell_id(x, y) for x, y in footprint]))

    if not candidates:
        col_a = max(0, min(config.grid_width - 2, config.grid_width // 2))
        col_b = min(config.grid_width - 1, col_a + 1)
        shoreline_y = min(config.grid_height - 1, 5)
        y_start = max(0, shoreline_y - 5)
        return [make_cell_id(x, y) for y in range(y_start, shoreline_y + 1) for x in (col_a, col_b)]

    candidates.sort(key=lambda item: (-item[0], item[1]))
    return candidates[0][1]

