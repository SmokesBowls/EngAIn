#ZON ap/0.1; caps=authority; guard=canon.safe
@id: rule:runtime_mutation.reality_mode_gate
@scope: canon
@status: active
@priority: 1000

=requires
- envelope.reality_mode in ["IMBUED", "FINALIZED"]
- envelope.actor_authority_tier >= action.required_tier
=end

=read_set
- envelope.reality_mode
- envelope.actor_authority_tier
- action.required_tier
=end

=write_set
=end

=effects
- decision.allowed = true
=end
