        "thought": [
          {
            "subject": "unknown",
            "confidence": 0.6
          }
        ]
      }
    },
    {
      "line": 14,
      "type": "narration",
      "text": "Despite his advanced intellect, he is psychically tethered to Anunnaki will through established consciousness-channels."
    },
    {
      "line": 15,
      "type": "blank"
    },
    {
