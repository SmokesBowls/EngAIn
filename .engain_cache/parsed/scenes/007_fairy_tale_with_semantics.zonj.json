  "@entities": [],
  "=segments": [
    {
      "line": 1,
      "type": "narration",
      "text": "Once upon a time, big golden bosses told their glowing workers and lizard soldiers to build tall towers in special places."
    },
    {
      "line": 2,
      "type": "narration",
      "text": "But those places were already homes for giant rock people and little light creatures."
    },
    {
      "line": 3,
      "type": "narration",
      "text": "The rock people didn’t want the towers—they kept fixing the ground when the workers messed it up."
    },
    {
      "line": 4,
      "type": "narration",
      "text": "The lizard soldiers got mean and started fighting them."
    },
    {
      "line": 5,
      "type": "narration",
      "text": "The glowing workers felt bad but couldn’t stop because the golden bosses controlled their brains."
    },
    {
      "line": 6,
      "type": "narration",
      "text": "Now everyone is sad and fighting, and the towers keep growing where they don’t belong."
    },
    {
      "line": 7,
      "type": "narration",
      "text": "The end... for now."
    }
  ],
