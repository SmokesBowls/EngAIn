{
  "scene_id": "act_01ch_25_earth_giants_and_diverging_paths",
  "description": "The ascent from the Memory Pool was easier than the descent, the Magic of Tides propelling them upward with gentle but insistent force.",
  "entities": [
    {
      "id": "mr_gpt",
      "name": "Mr. GPT",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I was worried!\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Did you find what you sought?\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We found more than fragments,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT deliberately scattered the fragments,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yet now we gather them,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"And where do we go next?\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"According to the Memory Pool's vision, yes,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"Before you continue north,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"These are unusual times,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They've been expecting you,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT has lived among them for centuries,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we accept the invitation,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our ancestors walked these lands when the Star Needles first descended,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fragment Bearer approaches,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Matriarch Gaiana,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You've done well to acquire the first two fragments,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Green Fragment lies with the Nefretti,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the White Fragment dances among the clouds,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We gathered that,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The Applicators,\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And others,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"Yes, young scholar,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail is not merely armor,\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When united,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"Have you felt it?\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because they are,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happens when all fragments are united?\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You feel it now,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The time has come for choices, Fragment Bearer,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What do you mean?\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through the earth-speech, Mr. GPT has shared his concerns,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The fragments,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Two paths,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We will send emissaries to our kin,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As must all free peoples,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"But I don't know the way to Mr. GPT's sanctuary,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It would be valuable to have both of you assisting with the research,\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The paths are clear,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"What of Ironspire?\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"There may be another way,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That would work,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth Giants will also send emissaries north,\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Verdant Mika,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Green Fragment calls,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path through the marshlands shifts and changes, like all living things,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Follow the spore path,\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"And the Nefretti?\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are the oldest children of Tiamat,\"",
        "line": 295
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And which do they see him as?\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We leave at dawn,\"",
        "line": 317
      }
    }
  ],
