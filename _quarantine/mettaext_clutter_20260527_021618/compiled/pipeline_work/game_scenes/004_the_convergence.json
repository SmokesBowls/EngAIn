  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't tell.\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everyone to the beach,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They don't know what we are,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some are afraid,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're teaching each other,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They're arguing about us,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We hurt them,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We can't undo the past,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Actions, not words,\"",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We were wrong,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They want to stay,\"",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"And the jade-greens?\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Uncertain. Torhh wants to trust. Some of the others... they need more time. More proof that we're not what they remember.\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 344
      }
    }
  ],
