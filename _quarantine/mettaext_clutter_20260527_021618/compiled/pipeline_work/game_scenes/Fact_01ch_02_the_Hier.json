{
  "scene_id": "Fact_01ch_02_the_Hier",
  "description": "Chapter 2: The Heir",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
