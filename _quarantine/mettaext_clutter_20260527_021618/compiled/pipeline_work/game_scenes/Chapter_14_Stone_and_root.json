{
  "scene_id": "Chapter_14_Stone_and_root",
  "description": "Chapter 14: Stone and root",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome to the Foundation Chamber, young bridge-builder,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I can feel it,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is alive, child of two worlds,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Show me how to listen,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The lesson begins with stillness,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your human perception moves too quickly,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to perceive,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Planetary Network,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every grain of soil carries memory,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Consciousness?\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has been waiting,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your first test,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stop,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Then what do I do?\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ask the network what it needs,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I can feel what it wants to do,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some trees,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Partnership,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to comprehend,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beautiful,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what earth magic truly is,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And more than that,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can feel everything,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By remembering that you are the bridge, not the destination,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Young bridge-builder,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Honor is earned through service,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The focusing crystal,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How do you feel?\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Connected,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Responsibility is the price of power,\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together, you will be formidable,\"",
        "line": 235
      }
    }
  ],
