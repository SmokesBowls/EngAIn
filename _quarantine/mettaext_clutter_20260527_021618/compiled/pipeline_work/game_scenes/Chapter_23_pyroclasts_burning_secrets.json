{
  "scene_id": "Chapter_23_pyroclasts_burning_secrets",
  "description": "The air on Pyroclast was thick with ash and sulfur, each breath a labor that scorched the lungs.",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 3,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 8
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I'm fine,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Resonant Prism said the Observer here went dormant,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If they exist,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sorry,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Visitors,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not applicators, then,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"You know of the Observers? The Void Spires?\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I was stationed here to protect this node when the severing occurred,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fell into dormancy?\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Needle,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If they've awakened the anti-pattern, then all connected worlds are at risk,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Observer,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Rhazorn",
      "action": "speak",
      "data": {
        "text": "\"Perhaps,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Void Spire cannot be activated without them,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correct. Observer and Spire are symbiotic. One cannot function without the other's guidance.\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Spire,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Rhazorn",
      "action": "speak",
      "data": {
        "text": "\"What is he doing?\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Important to our mission?\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Important to everything,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Observer's physical form is housed in a chamber at the spire's core,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like my spiritual warrior state,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Vi\u00ean can perceive temporal patterns that most can't see,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Between you, there might be a path to Aetheric Coil that I haven't found alone,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "Rhazorn",
      "action": "speak",
      "data": {
        "text": "\"The spire remembers,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"What do you need me to do?\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Observer exists between states now\u2014neither fully in time nor space. I can perceive where they've gone, but I can't follow.\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A synchronization of abilities,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We've done something similar before,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The planetary systems grow more unstable,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What exactly are you looking for?\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not entirely sure,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Aetheric Coil,\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "Rhazorn",
      "action": "speak",
      "data": {
        "text": "\"Can you reach them?\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not alone.\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enter your spiritual warrior state,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Observer,\"",
        "line": 282
      }
    },
    {
      "type": "thought",
      "timestamp": 192,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"\"Time-walker... spirit-dancer... why disturb my slumber? The network falls. The corruption spreads. Better to remain dormant than to witness the end.\"\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Needle has awakened,\"",
        "line": 289
      }
    },
    {
      "type": "thought",
      "timestamp": 196,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"\"Resonant Prism lives? Then... perhaps there is still hope. But I cannot return alone. The severing damaged me too severely. I require... an anchor.\"\"",
        "line": 294
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What kind of anchor?\"",
        "line": 296
      }
    },
    {
      "type": "thought",
      "timestamp": 198,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"\"A conduit between worlds. A vessel that can hold the memories I've gathered in my exile.\"\"",
        "line": 298
      }
    },
    {
      "type": "thought",
      "timestamp": 201,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"\"No,\"* the Observer responded immediately. *\"You bear another burden already, time-walker. I sense it within you\u2014a fragment of something greater, something ancient. Your path leads elsewhere.\"\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is Xalthor,\"",
        "line": 315
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I have waited centuries for this,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Quickly,\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"We are restored,\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 247,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco essence you carry comes from the most ancient of bloodlines\u2014those who walked between realms long before the Anunnaki claimed dominion. The Shadowborn are your distant kin, the original wielders of what mortals now call the Draco power.\"",
        "line": 368
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what truth is that?\"",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Pyroclast grows more unstable,\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Spire is now active,\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Umbrageous node remains dormant,\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 284,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Seed Jump,\"",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 426
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And once we're there?\"",
        "line": 429
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Echo of Threnody will sense your arrival. The Draco essence you carry will draw the Observer's attention, just as it drew mine. But beware\u2014it will draw others as well.\"",
        "line": 432
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're out of time,\"",
        "line": 437
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is the Seed Jump protocol,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 300,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And the return path?\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is none,\"",
        "line": 447
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "Xalthor",
      "action": "speak",
      "data": {
        "text": "\"There is one more thing you must know,\"",
        "line": 453
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How will we know which is which?\"",
        "line": 455
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "Xalthor",
      "action": "speak",
      "data": {
        "text": "\"Trust your blood,\"",
        "line": 458
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I will maintain the connection from this end,\"",
        "line": 463
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Ready?\"",
        "line": 469
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 471
      }
    }
  ],
  "initial_state": {
