{
  "scene_id": "act_01ch_34_voices_between_worlds",
  "description": "The Voice of Air hummed with subtle resonance as they descended from the Highland peaks, its crystalline form secured in the specially designed harness Mr.",
  "entities": [
    {
      "id": "mr_gpt",
      "name": "Mr. GPT",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The reports were accurate,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ironspire,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"But the Forest Giants haven't retaliated?\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They can't,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is worse than I expected,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Something's in pain,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those are vril extraction arrays,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to move,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"A Nefretti,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"That's not possible,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Please,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Can you break them?\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not without killing the creature,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There has to be a way,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Isla,\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know if I\u2014\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You can,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now, Lyra,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Thank you,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're the one from Ironspire,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Who?\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ironspire's researchers. The Circle of Progress.\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can you walk?\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I... I think so.\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"You'll come with us,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "one",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Send the secondaries,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I need a name,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Names have power,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sathinee,\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Look,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your very existence is antithetical to the void extraction,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to reach the Heartwood as quickly as possible,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's all right,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"The Fifth Coming,\"",
        "line": 238
      }
    }
  ],
