{
  "scene_id": "083_echoes_beneath_the_waves",
  "description": "Chapter 24 Echoes Beneath the Waves",
  "entities": [
    {
      "id": "mr_gpt",
      "name": "Mr. GPT",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Red Fragment,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Distance means little when it comes to the Dragon Mail,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Crimson Blood carrier has found the first piece,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"You felt it too?\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Red Fragment has bonded to its new bearer,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We would be glad to,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I've never met him,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nevertheless,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"and as for this in my hand, Show him this,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When the fragments are gathered, our paths will converge again.\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keep moving,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I am not them,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I seek understanding, not dominion,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blood of Masters speaks to the Heart,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand cycles have passed since the Heart last spoke,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What did it tell you?\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That you walk a path between worlds. That your blood carries memory older than the Masters themselves.\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have passed our trial,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blood Metal,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"But the crystal said this was in the volcanic fields,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Thank you,\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We know,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment lies beneath the waters where the cliff meets the sea,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We'll manage,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mark of safe passage,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Sighing Cliffs should be two days' journey along the coast,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's safe,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We rescued Mr. GPT from the applicators' prison there,\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"We have proof,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT is alive?\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's at his sanctuary beneath Kavurn's Echo,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"As safe as anyone can be on the Moon right now,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The same applicators who imprisoned Mr. GPT,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then the world stands at a crossroads,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've mastered solar energies that can counteract deep-water pressures,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And my shadow-light magic,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Mikas chose this path,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've mastered solar energies that can counteract deep-water pressures,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And my shadow-light magic,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Mikas chose this path,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So,\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In their most sacred site beneath the Sighing Cliffs,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Currently under siege by reptilian servitors,\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we leave at first light,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 231,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"Battle,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Coastal Servitors,\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to help them,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"I can help with that,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We approach from above,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Isla stays here,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Step into the shadow,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 265,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We come to help!\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Land-dwellers,\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Blood of Balance,\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Hydra Servitor,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"Hold your position!\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 282,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"For Sundrift,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 300,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The heads regenerate!\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The core,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Cover me!\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 321,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The heart,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 327,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 338,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment,\"",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Back!\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment,\"",
        "line": 359
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The grotto was breached three days ago,\"",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They used it to power the Hydra,\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 374,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Abyssal Grotto lies at the heart of our territory,\"",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 376,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Memories of the deep?\"",
        "line": 381
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"The ocean remembers what land forgets,\"",
        "line": 382
      }
    },
    {
      "type": "dialogue",
      "timestamp": 381,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"The Guardian's Seat,\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 384,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Korvus brings land-dwellers to the sacred Grotto?\"",
        "line": 389
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"They have recovered the fragment, High Elder,\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 389,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show us,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 393,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragments recognize the Grotto,\"",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 395,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Grotto recognizes them,\"",
        "line": 400
      }
    },
    {
      "type": "dialogue",
      "timestamp": 397,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not entirely,\"",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 403,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragments,\"",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 407,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Memory Pool,\"",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 408,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"And if we're not?\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 409,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then the pressure of the deep will crush you,\"",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 414,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll go to the Memory Pool,\"",
        "line": 419
      }
    },
    {
      "type": "dialogue",
      "timestamp": 423,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The solar energy struggles at this depth,\"",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Memory Pool,\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Magic of Tides accepts you,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 441,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"Listen,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 448,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail,\"",
        "line": 453
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He didn't just free himself from the armor,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He broke it apart deliberately,\"",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 464,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enheduanna,\"",
        "line": 469
      }
    },
    {
      "type": "dialogue",
      "timestamp": 468,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail wasn't just armor,\"",
        "line": 473
      }
    },
    {
      "type": "dialogue",
      "timestamp": 469,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And when complete, it will demand the same of its new bearer,\"",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 475,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know if anyone can truly be prepared for such a bond,\"",
