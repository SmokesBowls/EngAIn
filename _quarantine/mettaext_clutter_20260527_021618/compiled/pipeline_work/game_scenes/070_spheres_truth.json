{
  "scene_id": "070_spheres_truth",
  "description": "Chapter 11: The Sphere's Truth",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Has anyone seen my daughter?\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We saw her earlier,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Near the main entrance,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Echo Temple?\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ancient ruins about an hour's ride north of the city,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what?\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We can help,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your men won't go there after dark,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Besides,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The ruins are spread across several acres,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That's how she found the sphere?\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three years ago, in what she insists was a hidden chamber beneath the central temple,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Captain,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because I can feel something,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"We don't fully understand what we are,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The ground,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"What do you mean?\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It's... hollow,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Lyra!\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We need to split up,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Absolutely not,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's her,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sorry,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Focus on finding Lyra,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Here!\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Papa!\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Just stay calm,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can't,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Captain, what do you see?\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A chamber,\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Papa, you have to see this!\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We have to get down there,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I said I couldn't control it,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Easy,\"",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That was different,\"",
        "line": 345
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra,\"",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But Papa, don't you see?\"",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Aeon Keepers,\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You carry the spark of earth magic, young one,\"",
        "line": 422
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The sphere,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have been more than a guardian,\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it was not meant for you, faithful guardian,\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 287,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Me?\"",
        "line": 444
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I don't fully understand what's happening,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"What will it do to me?\"",
        "line": 467
      }
    },
    {
      "type": "dialogue",
      "timestamp": 302,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will awaken what sleeps within you,\"",
        "line": 469
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The choice is yours, daughter of two worlds,\"",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"My whole life,\"",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fear is wisdom,\"",
        "line": 490
      }
    },
    {
      "type": "dialogue",
      "timestamp": 344,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 346,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are you all right? You've been motionless for almost ten minutes.\"",
        "line": 536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The earth magic,\"",
        "line": 553
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what is it saying?\"",
        "line": 557
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That change is coming,\"",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're all connected to this,\"",
        "line": 567
      }
    },
    {
      "type": "dialogue",
      "timestamp": 371,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The choice is before you,\"",
        "line": 578
      }
    },
    {
      "type": "dialogue",
      "timestamp": 375,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What would you choose?\"",
        "line": 584
      }
    },
    {
      "type": "dialogue",
      "timestamp": 376,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"I'm a scholar,\"",
        "line": 586
      }
    },
    {
      "type": "dialogue",
      "timestamp": 379,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra?\"",
        "line": 592
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Adventure!\"",
        "line": 594
      }
    },
    {
      "type": "dialogue",
      "timestamp": 385,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Together, then,\"",
        "line": 602
      }
    }
  ],
  "initial_state": {
    "combat": {
      "entities": {}
    },
    "spatial": {
      "entities": {}
