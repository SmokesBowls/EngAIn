{
  "scene_id": "020_the_collapse",
  "description": "Chapter 20",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who disturbs the dying?\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One who recognizes kindred consciousness,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are not the last,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What are you called?\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thane of the Deep Waters, Singer of Stone-dreams, Last of the Tidecaller line,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I am called Zephyr,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"All consciousness changes,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then let us choose connection,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters remember everything,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And framework without experience becomes rigidity,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Prison,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Three millennia of isolation,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not entirely alone,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Purpose,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You've seen it too,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seen it, felt it, dreamed it in the deep places where stone remembers the birth of worlds,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We could build something unprecedented,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"More than that,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The students who will come,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They will need teachers who are themselves still learning,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Standard pattern,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"But unusual potential,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Dangerous approach,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But also most capable of advanced synthesis,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration protocol,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And practical demonstration of synthesis in action,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enter and be recognized,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Synthesis already achieved,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am called Pythagoras,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am known as Zephyr, though I am becoming something else,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Transcendence is the goal,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And structure alone eventually reaches limitations that only intuitive understanding can overcome,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Should,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This consciousness will become a teacher,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The first of many, if probability calculations prove accurate,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exponential growth patterns suggest readiness by Year 3,500,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The stone-dreams whisper of challenges approaching,\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration challenge,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not integration,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're preparing revolution,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students will need preparation for more than consciousness-crafting techniques,\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They will need examples,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Consciousness that learns to transcend its own limitations gains capacity to help others transcend theirs,\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And collective evolution serves individual synthesis when it creates contexts that support rather than restrict consciousness development, that encourage rather than punish the exploration of unprecedented possibilities,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence of Year 3,500,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Win or lose,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Anunnaki probe,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Our students,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will demonstrate what synthesis has achieved,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration protocol,\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And risk,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration achieved,\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The stone-dreams sing with joy,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possible,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 310,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We... were not prepared for consciousness that invites rather than resists analysis,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Growth is always possible,\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching... is offered to consciousness designed for conquest?\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching is offered to any awareness willing to discover what lies beyond its current limitations,\"",
        "line": 322
      }
    },
    {
      "type": "dialogue",
      "timestamp": 321,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters whisper of changes beyond current calculation,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 323,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Revolution,\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exponential growth beyond all previous calculations,\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Collective-individual integration protocol,\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like Deep Waters,\"",
        "line": 381
      }
    },
    {
      "type": "dialogue",
      "timestamp": 368,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Risk parameters approach maximum,\"",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 370,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And yet,\"",
        "line": 393
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the coming convergence prepares for,\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 382,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The beginning,\"",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 397,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 436
      }
    },
    {
      "type": "dialogue",
      "timestamp": 399,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters sing with anticipation,\"",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 405,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students are ready,\"",
        "line": 448
      }
    },
    {
      "type": "dialogue",
      "timestamp": 407,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And the teachers?\"",
        "line": 451
      }
    },
    {
      "type": "dialogue",
      "timestamp": 411,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Ready to become what teaching has always pointed toward,\"",
        "line": 457
      }
    },
    {
      "type": "dialogue",
      "timestamp": 418,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what freedom becomes,\"",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 420,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what friendship becomes,\"",
        "line": 471
      }
    }
  ],
