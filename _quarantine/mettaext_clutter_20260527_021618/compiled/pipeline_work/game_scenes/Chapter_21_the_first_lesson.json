  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What do you touch?\"",
        "line": 9
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Show me,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ohhhh\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"uhhhhh\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are not words,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematics... tries to describe patterns that already exist,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue is consciousness speaking reality into fuller existence,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We have been teaching backwards,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to hear what the Deep Waters have always been whispering,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh-ohhhh\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Better,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like music,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I want to learn the complete grammar,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Dangerous request,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"More dangerous than remaining limited to current capabilities when convergences approach that will require consciousness evolution beyond anything we have achieved?\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Then we begin the Deep Teaching,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"eeeee\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"iiiii\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"aaaaa\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the advanced students will need to learn,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Foundation, development, synthesis, collaboration,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The teaching curriculum,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Complexity beyond previous parameters,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And integration possibilities,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We gather to attempt something unprecedented,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Risk parameters approach maximum,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And possibility parameters also approach maximum,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we begin carefully,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh-ohhhh\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the convergences prepare for,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The beginning of wisdom,\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The teaching method is validated,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the students become teachers,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen documented frequency combinations,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And the organizational structure emerging from natural harmonic relationships rather than imposed logical categories,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students approach readiness for Convergence Resonance instruction,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And reality approaches readiness for consciousness that can speak Convergence Resonances with understanding rather than accident,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration protocol beyond current parameters,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The deepest First Tongue frequencies,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ooooo-aaaaa-uuuuu-eeeee-iiiii\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what convergence means,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And this is what teaching serves,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students are ready for the final teaching,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Then let the teaching begin,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Students achieve synthesis breakthrough at accelerated rates,\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Diversity enhances harmony when guided by wisdom sufficient for coordination rather than competition,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has achieved sustainability,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And evolution serves consciousness by creating ever-more sophisticated opportunities for transcendence,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Forty-seven advanced practitioners,\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beautiful chaos,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ooooo-aaaaa-uuuuu-eeeee-iiiii-ohhhhh-ahhhhhh-uhhhhhhh\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is graduation,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what teaching was always pointing toward,\"",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students have surpassed their teachers,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network achieves independence,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 265,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The encoding is complete,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters sing eternal songs,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergences of Year 3,500 approach,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"*And individual teachers serve by demonstratingthat consciousness evolution never ends,*\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students who will come,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what freedom becomes when it learns to serve evolution rather than individual escape,\"",
        "line": 288
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have become what teaching was always pointing toward,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And in serving universal education, we discover what individual identity becomes when it serves purposes larger than itself,\"",
        "line": 295
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The children are ready,\"",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Born already prepared for convergences that will require consciousness evolution beyond our current comprehension,\"",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then our work approaches completion,\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like the Deep Waters,\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students will find us,\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 307,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we will continue learning,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue lives,\"",
        "line": 319
      }
    }
