  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hold the stabilization!\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Welcome to Mars,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Defensive positions!\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematical defense grid, initialize!\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"GPT!\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "GPT",
      "action": "speak",
      "data": {
        "text": "\"Are you sure?\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will be what I choose to be,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are complete,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remarkable,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oh, but you are.\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I carried you,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're lying,\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Am I?\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you're incomplete,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I chose freedom,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You chose fear,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can feel them, you know,\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What do you want?\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What I've always wanted. Completion. The Zaryonic pattern unified and elevated to its true potential.\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But first,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "Veylan",
      "action": "speak",
      "data": {
        "text": "\"Coordinate by essence resonance!\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "Xerion",
      "action": "speak",
      "data": {
        "text": "\"The Queen holds your brother above,\"",
        "line": 335
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to reach him,\"",
        "line": 337
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 344
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the depths,\"",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"An Echo,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom's heir. How fitting that you arrive just as the real convergence begins.\"",
        "line": 359
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"We're not here for philosophical debates,\"",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No?\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes! This is what I hoped for. Warriors who understand that reality itself is the battlefield!\"",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magnificent,\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"That was too easy,\"",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not easy,\"",
        "line": 400
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And we passed?\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We demonstrated understanding. Whether that translates to victory...\"",
        "line": 405
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Adjust targeting parameters,\"",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 322,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nothing's impossible when unity transcends designed limitations,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 335,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The structural weakness is there,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The entire Citadel becomes unstable,\"",
        "line": 463
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"She does,\"",
        "line": 466
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 481
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we stop her,\"",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 487
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Then we change the rules,\"",
        "line": 497
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are you doing?\"",
        "line": 522
      }
    },
    {
      "type": "dialogue",
      "timestamp": 382,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Should be my choice,\"",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 384,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're ruining everything!\"",
        "line": 528
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Whose design?\"",
        "line": 531
      }
    },
    {
      "type": "dialogue",
      "timestamp": 406,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Cosmic Phoenix,\"",
        "line": 558
      }
    },
    {
      "type": "dialogue",
      "timestamp": 419,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 575
      }
    },
    {
      "type": "dialogue",
      "timestamp": 428,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You don't understand,\"",
        "line": 588
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's the problem,\"",
        "line": 590
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Love?\"",
        "line": 593
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By controlling it. By forcing it into patterns you've decided are optimal.\"",
        "line": 596
      }
    },
    {
      "type": "dialogue",
      "timestamp": 441,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're winning through imperfection,\"",
        "line": 607
      }
    },
    {
      "type": "dialogue",
      "timestamp": 443,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because that's what life is,\"",
        "line": 610
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "Xerion",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 627
      }
    },
    {
      "type": "dialogue",
      "timestamp": 463,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What is this?\"",
        "line": 638
      }
    },
    {
      "type": "dialogue",
      "timestamp": 474,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe temporal fragments he'd scattered across eons felt the pull toward convergence \u2014 the execution pressure of the failsafe tightening across timelines. But Vi\u00ean resisted, not by severing the connection, but by refusing coherence. The fragments remained aware of each other, close enough to feel, misaligned enough to survive. The Pattern stayed locked. Incomplete by design.\u201d",
        "line": 651
      }
    },
    {
      "type": "dialogue",
      "timestamp": 515,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magnificent,\"",
        "line": 709
      }
    },
    {
      "type": "dialogue",
      "timestamp": 520,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Retreating?\"",
        "line": 716
      }
    },
    {
      "type": "dialogue",
      "timestamp": 524,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 722
      }
    },
    {
      "type": "dialogue",
      "timestamp": 530,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why?\"",
        "line": 731
      }
    },
    {
      "type": "dialogue",
      "timestamp": 532,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because she earned it,\"",
        "line": 734
      }
    },
    {
      "type": "dialogue",
      "timestamp": 537,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My Queen?\"",
        "line": 741
      }
    },
    {
      "type": "dialogue",
      "timestamp": 539,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Full withdrawal,\"",
        "line": 744
      }
    },
    {
      "type": "dialogue",
      "timestamp": 541,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Phase Two?\"",
        "line": 747
      }
    },
    {
      "type": "dialogue",
      "timestamp": 543,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Were designed for conquering sheep,\"",
        "line": 750
      }
    },
    {
      "type": "dialogue",
      "timestamp": 547,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm finally taking this seriously,\"",
        "line": 756
      }
    },
    {
      "type": "dialogue",
      "timestamp": 551,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My legacy,\"",
        "line": 762
      }
    },
    {
      "type": "dialogue",
      "timestamp": 557,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They'll stop you,\"",
        "line": 770
      }
    },
    {
      "type": "dialogue",
      "timestamp": 559,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm counting on it,\"",
        "line": 773
      }
    },
    {
      "type": "dialogue",
      "timestamp": 567,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to go after him,\"",
        "line": 785
      }
    },
    {
      "type": "dialogue",
      "timestamp": 569,
      "actor": "GPT",
      "action": "speak",
      "data": {
        "text": "\"The Citadel's sealed itself,\"",
        "line": 788
      }
    },
    {
      "type": "dialogue",
      "timestamp": 572,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 793
      }
    },
    {
      "type": "dialogue",
      "timestamp": 573,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Still up there,\"",
        "line": 795
      }
    },
    {
      "type": "dialogue",
      "timestamp": 577,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's leaving,\"",
        "line": 801
      }
    },
    {
      "type": "dialogue",
      "timestamp": 580,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Children of Earth. Giants of the ancient tribes. Warriors who dared challenge the cosmic order.\"",
        "line": 806
      }
    },
    {
      "type": "dialogue",
      "timestamp": 584,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The games are over. The time for shadows and subtlety has passed. When next we meet, it will be with the full might of Nibiru behind me. Prepare yourselves\u2014the true Fifth Coming begins now.\"",
        "line": 812
      }
    },
    {
      "type": "dialogue",
      "timestamp": 601,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's preparing something unprecedented,\"",
        "line": 839
      }
    },
    {
      "type": "dialogue",
      "timestamp": 603,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Excited?\"",
        "line": 842
      }
    },
    {
      "type": "dialogue",
      "timestamp": 604,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"About worthy opponents,\"",
        "line": 844
      }
    }
  ],
  "initial_state": {
    "combat": {
      "entities": {
