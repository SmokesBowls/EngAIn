  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Igigi scatter-protocol was... efficient,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They demonstrate cognitive evolution beyond their designed parameters,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precedent?\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Traditional pursuit protocols would be... inefficient,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we don't pursue,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are favorable,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Single star system, galactic backwater sector. The indigenous populations are pre-technological\u2014they would not interfere with punishment protocols. The refugees have established primitive shelters on the northern landmasses, attempting to integrate with local ecosystem patterns.\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Orbital insertion parameters?\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Permanent eclipse positioning,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The refugee populations will attempt adaptation,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them try,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Initiate Nibiru displacement protocols,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 102
      }
    }
  ],
