{
  "scene_id": "054_tue_lunar_spire",
  "description": "BOOK 9\u2013 CHAPTER 52 THE LUNAR SPIRE",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The asteroid field surrounding the Shattered Mind is not merely a physical hazard,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\"No ship we possess could navigate that field and survive,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then where?\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They didn't build here,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This is not my war,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I will not wait idly,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Anchor arrives,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I trained him. I watched him believe he could bear the weight of time through sheer will. I watched the moment his certainty shattered him.\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't move through time. You decide what resists change.\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This fall is an event,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Causal Inertia Control,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Be in multiple outcomes at once\u2014and choose later.\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Kaelen",
      "action": "speak",
      "data": {
        "text": "\"Superposition,\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH.\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It sings,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You seek a deeper layer,\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are not for browsing,\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I need to understand the Spire,\"",
        "line": 295
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You went deep,\"",
        "line": 358
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Hello, Geralt,\"",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The armor remembers me,\"",
        "line": 395
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This is for you,\"",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A seed. A promise. A beginning.\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What time?\"",
        "line": 416
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"In less than three thousand years,\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't\u2014\"",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will.\"",
        "line": 422
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That's my kiss,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait\u2014\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom fell to protect this,\"",
        "line": 434
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"She said less than three thousand years,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. She gave me... a future.\"",
        "line": 457
      }
    }
  ],
