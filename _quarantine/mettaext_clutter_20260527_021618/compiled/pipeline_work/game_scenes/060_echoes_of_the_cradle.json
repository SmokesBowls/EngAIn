  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Another good harvest,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The earth feels... eager this year,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What is that?\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I don't know,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tran! Keen!\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What about the wounded?\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "Garric",
      "action": "speak",
      "data": {
        "text": "\"We have to try,\"",
        "line": 335
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They can be moved,\"",
        "line": 341
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"How long do we have?\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Not long,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know this day has been beyond anything we ever imagined,\"",
        "line": 426
      }
    },
    {
      "type": "dialogue",
      "timestamp": 423,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Gods...\"",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It's... blocking the sun,\"",
        "line": 572
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Do you think we'll ever be able to go back?\"",
        "line": 578
      }
    },
    {
      "type": "dialogue",
      "timestamp": 441,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"But maybe that's not entirely a bad thing,\"",
        "line": 584
      }
    }
  ],
