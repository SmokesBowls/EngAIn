      "type": "dialogue",
      "timestamp": 8,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are conclusive,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot?\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The fire burns,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Flight,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Run.\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In the fourteenth iteration of galactic seeding,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are extinct. Their worlds are ash. Their courage is remembered by no one, because no one survived to carry the memory forward. The Devourers consumed their civilization so completely that even their names were forgotten. Honor without survival is just... silence.\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"It survives,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki have detected our council session,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those who choose honor,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those who choose survival,\"",
        "line": 87
      }
    }
  ],
