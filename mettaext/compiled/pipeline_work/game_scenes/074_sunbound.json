{
  "scene_id": "074_sunbound",
  "description": "The vessel shuddered through dimensional space as reality folded around them like origami made of starlight and shadow, carrying them from the asteroid field toward the blazing heart of the solar syst",
  "entities": [
    {
      "id": "mr_gpt",
      "name": "Mr. GPT",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're approaching the outer corona,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This shouldn't be possible,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's your presence,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are you certain? The sensors can't penetrate that far, and\u2014\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm certain,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This place... I've been here before,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Another effect of your presence,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solar Golems,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we'll just have to burn brighter,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They've adapted to the environment,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're trying to surround us,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Let them,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They want us to follow,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Of course they do,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A stronghold,\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's inside. I can feel him.\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Whatever happens,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We won't,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Intruders,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He doesn't belong to you. He never did.\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The one who defied the natural order,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He belongs to the Sun now,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Shadow cannot exist here,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"All things change,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This... changes nothing,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was just the first guardian,\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The phoenix child returns to the nest,\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are you using him for? What's your purpose here?\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "Ignis",
      "action": "speak",
      "data": {
        "text": "\"I know what you were meant to be,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you're too late,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Purpose?\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows between stars,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The prisoner... will never be yours,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two down,\"",
        "line": 265
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You've come so far, only to fail at the threshold,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What knowledge?\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Blaze",
      "action": "speak",
      "data": {
        "text": "\"Everything,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We cannot defeat it conventionally,\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we don't fight it conventionally,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am of the Sun,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not scattered,\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Thang, Phoenix Mage of the Moon Kingdom,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This changes nothing,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No longer,\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Are you alright?\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've never felt more... connected,\"",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sun reveals truth,\"",
        "line": 337
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT,\"",
        "line": 349
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's alive,\"",
        "line": 354
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Sun preserves what it values,\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But his time here is done. The burden passes to me, at least until he recovers.\"",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Can we free him?\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can,\"",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My ethereal magic,\"",
        "line": 372
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"To Earth?\"",
        "line": 375
      }
    },
    {
      "type": "dialogue",
      "timestamp": 247,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To the secret hideout,\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Be ready,\"",
        "line": 383
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Now, Rongtai!\"",
        "line": 389
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Send him through,\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Will he survive the transition?\"",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 261,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"He's survived the Sun,\"",
        "line": 399
      }
    },
    {
      "type": "dialogue",
      "timestamp": 265,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It's done,\"",
        "line": 405
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Now we follow him to Earth,\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Now what?\"",
        "line": 423
      }
    }
  ],
