    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The planetary core stabilizes,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tectonic plates settling into stable configurations,\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water coverage approximately seventy-two percent,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen years,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Since we lost our bodies,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Physical form is limitation,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Extend observation channels to surface level,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Pelagor,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand years of evolutionary pressure,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They went deep,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They retained the core abilities,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Look at the others,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have the potential,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Pelagor survived,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The system requires ground-level maintenance,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's been three thousand years since we've created Nephoretti,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've done it before,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was when we had physical bodies ourselves,\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"We should remember,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which is precisely why they need the Nephoretti,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And perhaps,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One thousand Nephoretti,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Manifested simultaneously,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"And the intentions we craft into them?\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We give them purpose, not instructions,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A dangerous gift,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Then let us begin,\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare for the leap,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Mark,\"",
        "line": 270
      }
    }
  ],
