    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The planetary core stabilizes,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tectonic plates settling into stable configurations,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water coverage approximately seventy-two percent,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen years,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Since we lost our bodies,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Physical form is limitation,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Extend observation channels to surface level,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Pelagor,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand years of evolutionary pressure,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They went deep,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They retained the core abilities,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Look at the others,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have the potential,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Pelagor survived,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The system requires ground-level maintenance,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's been three thousand years since we've created Nephoretti,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've done it before,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was when we had physical bodies ourselves,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"We should remember,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which is precisely why they need the Nephoretti,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And perhaps,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One thousand Nephoretti,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Manifested simultaneously,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"And the intentions we craft into them?\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We give them purpose, not instructions,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A dangerous gift,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Then let us begin,\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare for the leap,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Mark,\"",
        "line": 279
      }
    }
  ],
