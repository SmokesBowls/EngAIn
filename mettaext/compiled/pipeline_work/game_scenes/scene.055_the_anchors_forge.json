    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe library showed you the war,\u201d",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt showed me the battlefield,\u201d",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou understand the scale,\u201d",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI understand my size within it,\u201d",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAssign the weight,\u201d",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Kaelen",
      "action": "speak",
      "data": {
        "text": "\u201cGood,\u201d",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThis drop has fallen, unchanged, for ten thousand years in a cave no living being has seen,\u201d",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo not thank me. I have given you a tool and taken a price. The balance is what it is.\u201d",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Orion remnant is a ghost town. But their docks are not empty. A slaver convoy, using old Sirian jump-ships. They are loading \u2018cargo\u2019 in the subterranean hangars. The cargo is alive. Terrified.\u201d",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA mining operation,\u201d",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe slaves are the tools,\u201d",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe need that shuttle,\u201d",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThat ship,\u201d",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to go,\u201d",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know what unfolds there,\u201d",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cGet in,\u201d",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA mud man,\u201d",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cA foundation,\u201d",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSee?\u201d",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey are the mortar,\u201d",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to get closer,\u201d",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cAnd we draw every enemy right to the slaves,\u201d",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s not just a relay,\u201d",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 321,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe foundation is failing!\u201d",
        "line": 436
      }
    },
    {
      "type": "dialogue",
      "timestamp": 334,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo it!\u201d",
        "line": 453
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA seed needs good ground,\u201d",
        "line": 471
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe door is crumbling!\u201d",
        "line": 494
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo it,\u201d",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThrough the door!\u201d",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 392,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNow, Luminaire!\u201d",
        "line": 531
      }
    }
  ],
