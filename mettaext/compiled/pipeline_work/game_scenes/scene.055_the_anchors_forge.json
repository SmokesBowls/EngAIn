    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe library showed you the war,\u201d",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt showed me the battlefield,\u201d",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou understand the scale,\u201d",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI understand my size within it,\u201d",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAssign the weight,\u201d",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Kaelen",
      "action": "speak",
      "data": {
        "text": "\u201cGood,\u201d",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThis drop has fallen, unchanged, for ten thousand years in a cave no living being has seen,\u201d",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo not thank me. I have given you a tool and taken a price. The balance is what it is.\u201d",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Orion remnant is a ghost town. But their docks are not empty. A slaver convoy, using old Sirian jump-ships. They are loading \u2018cargo\u2019 in the subterranean hangars. The cargo is alive. Terrified.\u201d",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA mining operation,\u201d",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe slaves are the tools,\u201d",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe need that shuttle,\u201d",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThat ship,\u201d",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to go,\u201d",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know what unfolds there,\u201d",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cGet in,\u201d",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA mud man,\u201d",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cA foundation,\u201d",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSee?\u201d",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey are the mortar,\u201d",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to get closer,\u201d",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cAnd we draw every enemy right to the slaves,\u201d",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s not just a relay,\u201d",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 323,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe foundation is failing!\u201d",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 336,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo it!\u201d",
        "line": 456
      }
    },
    {
      "type": "dialogue",
      "timestamp": 349,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA seed needs good ground,\u201d",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 366,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe door is crumbling!\u201d",
        "line": 497
      }
    },
    {
      "type": "dialogue",
      "timestamp": 382,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDo it,\u201d",
        "line": 517
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThrough the door!\u201d",
        "line": 528
      }
    },
    {
      "type": "dialogue",
      "timestamp": 394,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNow, Luminaire!\u201d",
        "line": 534
      }
    }
  ],
