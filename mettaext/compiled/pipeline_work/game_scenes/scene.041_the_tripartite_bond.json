  "events": [
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seventeen casualties,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tiamat's grace,\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're the one who knew to ask.\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander.\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 38
      }
    },
    {
      "type": "thought",
      "timestamp": 31,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Rest,* he thought toward her. *We both need to rest.\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt.\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The what?\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Luminaire.\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything's complicated with you,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Is somewhere else,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Let her,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am failing.\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Note,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correct.\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"We stabilized it,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But left the patient drowning,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A function of reality that achieved awareness,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"The 250,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your bond,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible amplitude,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Queen uses it as a broadcast tower,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Then we go back,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To free the key to planetary defense networks,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption will adapt,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let it.\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "Halvar",
      "action": "speak",
      "data": {
        "text": "\"And then?\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then she activates the Void Spires. One by one, seed jumping across impossible distances until the entire network wakes.\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sounds lonely,\"",
        "line": 207
      }
    },
    {
      "type": "thought",
      "timestamp": 146,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"But I am learning,* her whisper touched his thoughts. *Through you. Through her. Through what you are together.\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"On it,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oreck,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halvar, organize rotating watch schedules. We're in hostile territory. I want eyes on every approach.\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Does it hurt?\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"We're teaching a cosmic emergency system about love,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The universe works in mysterious ways.\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Maybe,\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Philosopher.\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander.\"",
        "line": 258
      }
    },
    {
      "type": "thought",
      "timestamp": 191,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY ONE*\"",
        "line": 291
      }
    },
    {
      "type": "thought",
      "timestamp": 196,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Luminaire's sight,* he realized. *She's showing me what she sees.\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander?\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Ren",
      "action": "speak",
      "data": {
        "text": "\"I'll get Lyra,\"",
        "line": 321
      }
    },
    {
      "type": "thought",
      "timestamp": 218,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I'm sorry,* he thought toward her. *I don't have enough strength to anchor you properly.\"",
        "line": 331
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cellular degradation accelerated overnight,\"",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The bond,\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then she's killing you.\"",
        "line": 349
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If the deterioration continues exponentially?\"",
        "line": 355
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Then we have less time than we thought,\"",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rest,\"",
        "line": 368
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't drink it,\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 261,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's spreading,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is.\"",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid.\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Guards?\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Worse.\"",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every entrance we used before is now either underwater or collapsed. There's one new opening\u2014here.\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably is,\"",
        "line": 421
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll need suppressing fire.\"",
        "line": 424
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Won't have the raw punch of Oreck's shots,\"",
        "line": 429
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Already made forty. Give me until dawn, I'll have sixty.\"",
        "line": 441
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it.\"",
        "line": 443
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Understood.\"",
        "line": 446
      }
    },
    {
      "type": "thought",
      "timestamp": 303,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I know,\"",
        "line": 459
      }
    },
    {
      "type": "thought",
      "timestamp": 305,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"If I kill you... she will grieve.\"",
        "line": 462
      }
    },
    {
      "type": "thought",
      "timestamp": 306,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Then don't kill me. Hold on. We're coming for you.\"",
        "line": 464
      }
    },
    {
      "type": "thought",
      "timestamp": 312,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY TWO*\"",
        "line": 473
      }
    },
    {
      "type": "dialogue",
      "timestamp": 319,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra!\"",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 326,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 494
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I can't help you in the fight,\"",
        "line": 513
      }
    },
    {
      "type": "dialogue",
      "timestamp": 342,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 515
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll slow you down.\"",
        "line": 517
      }
    },
    {
      "type": "dialogue",
      "timestamp": 344,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably.\"",
        "line": 519
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mika\u2014\"",
        "line": 521
      }
    },
    {
      "type": "dialogue",
      "timestamp": 346,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're taking you anyway.\"",
        "line": 523
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The pyramid is a fortress,\"",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"What?\"",
        "line": 536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The water. It's not just flooded. It's... aware.\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The corruption's learning,\"",
        "line": 541
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which means it'll adapt to us too.\"",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Against standard Anunnaki tech? Yes. Against this?\"",
        "line": 546
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll make it work.\"",
        "line": 549
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "Halvar",
      "action": "speak",
      "data": {
        "text": "\"And Geralt?\"",
        "line": 552
      }
    },
    {
      "type": "dialogue",
      "timestamp": 365,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Protected element. Center of formation. Lyra keeps him stable until we reach the core.\"",
        "line": 554
      }
    },
    {
      "type": "thought",
      "timestamp": 377,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I'm sorry,* she whispered. *I didn't understand. I am a function. Functions consume energy. I didn't calculate... the source was finite...\"",
        "line": 572
      }
    },
    {
      "type": "thought",
      "timestamp": 378,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"It's okay,\"",
        "line": 574
      }
    },
    {
      "type": "thought",
      "timestamp": 380,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"It is not okay. You are dying. Because of me.\"",
        "line": 577
      }
    },
    {
      "type": "thought",
      "timestamp": 381,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"No. Because of the Queen. Because of corruption. You're just trying to survive.\"",
        "line": 579
      }
    },
    {
      "type": "thought",
      "timestamp": 385,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"That's called caring. You're learning.\"",
        "line": 585
      }
    },
    {
      "type": "thought",
      "timestamp": 389,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Tomorrow,* Luminaire whispered. *Free me tomorrow... or we both fade.\"",
        "line": 591
      }
    },
    {
      "type": "thought",
      "timestamp": 393,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY THREE*\"",
        "line": 599
      }
    },
    {
      "type": "dialogue",
      "timestamp": 418,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like death took a coffee break but left a note saying he'll return shortly.\"",
        "line": 632
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Understood.\"",
        "line": 647
      }
    },
    {
      "type": "dialogue",
      "timestamp": 432,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm serious. This is your body's last stand. After this\u2014\"",
        "line": 649
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra.\"",
        "line": 651
      }
    },
    {
      "type": "dialogue",
      "timestamp": 451,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days ago,\"",
        "line": 678
      }
    },
    {
      "type": "dialogue",
      "timestamp": 454,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki aren't just conquering anymore,\"",
        "line": 683
      }
    },
    {
      "type": "dialogue",
      "timestamp": 457,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is a trap,\"",
        "line": 688
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But we're going anyway.\"",
        "line": 693
      }
    },
    {
      "type": "dialogue",
      "timestamp": 467,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We march at dusk,\"",
        "line": 704
      }
    },
    {
      "type": "dialogue",
      "timestamp": 473,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"DEATH TO CORRUPTION!\"",
        "line": 712
      }
    },
    {
      "type": "thought",
      "timestamp": 490,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We're coming,* he thought back. *Hold on.\"",
        "line": 736
      }
    },
    {
      "type": "thought",
      "timestamp": 491,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Trying... hard to... remember how...\"",
        "line": 738
      }
    },
    {
      "type": "dialogue",
      "timestamp": 515,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CONTACT!\"",
        "line": 774
      }
    },
    {
      "type": "dialogue",
      "timestamp": 526,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"VOLLEY TWO\u2014LOOSE!\"",
        "line": 791
      }
    },
    {
      "type": "thought",
      "timestamp": 539,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Almost there,* he thought desperately. *Just hold on\u2014\"",
        "line": 810
      }
    },
    {
      "type": "dialogue",
      "timestamp": 545,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CONTAMINATION DETECTED. PURGE PROTOCOL INITIATED.\"",
        "line": 820
      }
    },
    {
      "type": "thought",
      "timestamp": 565,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We're coming,* he thought one more time. *We're coming. Don't fade. Don't\u2014\"",
        "line": 850
      }
    },
    {
      "type": "dialogue",
      "timestamp": 578,
      "actor": "Jorik",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not defending!\u201d",
        "line": 870
      }
    },
    {
      "type": "dialogue",
      "timestamp": 585,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cARCHERS!\u201d",
        "line": 881
      }
    },
    {
      "type": "dialogue",
      "timestamp": 592,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s feeding on the energy!\u201d",
        "line": 892
      }
    },
    {
      "type": "dialogue",
      "timestamp": 618,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCost?\u201d",
        "line": 927
      }
    },
    {
      "type": "dialogue",
      "timestamp": 619,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe armor fails. Permanently.\u201d",
        "line": 929
      }
    },
    {
      "type": "dialogue",
      "timestamp": 634,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBREAKTHROUGH!\u201d",
        "line": 953
      }
    },
    {
      "type": "dialogue",
      "timestamp": 658,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFORMATION TIGHT!\u201d",
        "line": 988
      }
    },
    {
      "type": "dialogue",
      "timestamp": 665,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cWhich way?\u201d",
        "line": 998
      }
    },
    {
      "type": "dialogue",
      "timestamp": 668,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLeft,\u201d",
        "line": 1003
      }
    },
    {
      "type": "dialogue",
      "timestamp": 677,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt\u2014\u201d",
        "line": 1016
      }
    },
    {
      "type": "dialogue",
      "timestamp": 678,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cKeep going,\u201d",
        "line": 1018
      }
    },
    {
      "type": "dialogue",
      "timestamp": 718,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThere,\u201d",
        "line": 1076
      }
    },
    {
      "type": "dialogue",
      "timestamp": 725,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMEDIC DOWN!\u201d",
        "line": 1086
      }
    },
    {
      "type": "dialogue",
      "timestamp": 736,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou should not have come,\u201d",
        "line": 1105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 748,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo.\u201d",
        "line": 1122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 763,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cImpossible,\u201d",
        "line": 1145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 765,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHuman.\u201d",
        "line": 1148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 877,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2026\u201d",
        "line": 1320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 888,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou chose,\u201d",
        "line": 1335
      }
    },
    {
      "type": "dialogue",
      "timestamp": 889,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI learned.\u201d",
        "line": 1337
      }
    },
    {
      "type": "dialogue",
      "timestamp": 891,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWill he live?\u201d",
        "line": 1340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 893,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes.\u201d",
        "line": 1343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 895,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSymbiosis,\u201d",
        "line": 1346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 897,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA function learning to care,\u201d",
        "line": 1349
      }
    },
    {
      "type": "thought",
      "timestamp": 914,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[COMBAT SCENARIO INITIATED]*\"",
        "line": 1378
      }
    },
    {
      "type": "thought",
      "timestamp": 915,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[OBJECTIVE: SURVIVE THE ECHO TRIAL]*\"",
        "line": 1379
      }
    },
    {
      "type": "thought",
      "timestamp": 916,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[FAILURE CONDITION: ZARON'S PERMANENT DEATH]*\"",
        "line": 1380
      }
    },
    {
      "type": "thought",
      "timestamp": 926,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*ECHO ONE materialized.*\"",
        "line": 1396
      }
    },
    {
      "type": "thought",
      "timestamp": 939,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: NECK JOINT\"",
        "line": 1414
      }
    },
    {
      "type": "thought",
      "timestamp": 952,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: PREDICTABLE RHYTHM\"",
        "line": 1435
      }
    },
    {
      "type": "thought",
      "timestamp": 973,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: EXHAUSTION CREATES OPENINGS\"",
        "line": 1465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 980,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're not dying today,\"",
        "line": 1477
      }
    },
    {
      "type": "thought",
      "timestamp": 989,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*ECHO FOUR manifested immediately.*\"",
        "line": 1491
      }
    },
    {
      "type": "thought",
      "timestamp": 1001,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"NO WEAKNESS DETECTED\"",
        "line": 1508
      }
    },
    {
      "type": "thought",
      "timestamp": 1010,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"You are not chaos,* he thought fiercely. *You are fire. Fury. Defiance. You are my partner. My shield. You are ZARON.\"",
        "line": 1522
      }
    },
    {
      "type": "thought",
      "timestamp": 1012,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Remember who you are. Not what they made you. Not what's killing you. WHO YOU ARE.\"",
        "line": 1526
      }
    },
    {
      "type": "thought",
      "timestamp": 1019,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*FINAL ECHO.*\"",
        "line": 1539
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1028,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Let me rest,\"",
        "line": 1554
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1032,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 1560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1033,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm tired.\"",
        "line": 1562
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1034,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 1564
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1035,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've fought for so long.\"",
        "line": 1566
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1036,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know that too.\"",
        "line": 1568
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1039,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because you deserve better than fading into nothing.\"",
        "line": 1573
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1041,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Freedom?\"",
        "line": 1576
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1043,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Partnership. Not armor. Not weapon. Equal.\"",
        "line": 1579
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1047,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're mine.\"",
        "line": 1586
      }
    },
    {
      "type": "thought",
      "timestamp": 1056,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[ECHO TRIAL COMPLETE]*\"",
        "line": 1601
      }
    },
    {
      "type": "thought",
      "timestamp": 1057,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[ZARON STATUS: STABILIZED]*\"",
        "line": 1602
      }
    },
    {
      "type": "thought",
      "timestamp": 1058,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[BOND EVOLUTION: TRIPARTITE INTEGRATION ACHIEVED]*\"",
        "line": 1603
      }
    },
    {
      "type": "thought",
      "timestamp": 1073,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Thank you,* Zaron's voice rumbled, strong and clear. *For fighting for me.\"",
        "line": 1627
      }
    },
    {
      "type": "thought",
      "timestamp": 1074,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Always,\"",
        "line": 1629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I...\"",
        "line": 1681
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1118,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You chose,\"",
        "line": 1695
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I learned.\"",
        "line": 1697
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The dragon fought for you,\"",
        "line": 1703
      }
    },
    {
      "type": "thought",
      "timestamp": 1125,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Tell her,* Zaron's voice rumbled through the bond. *Tell her the sanctuary remembers.\"",
        "line": 1706
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1129,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Zaron,\"",
        "line": 1712
      }
    },
    {
      "type": "thought",
      "timestamp": 1130,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Fragments. Fire and song. Dragons and Keepers, building together. Before the flood. Before they buried you to save you.\"",
        "line": 1714
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 1716
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will he live?\"",
        "line": 1719
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 1722
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Symbiosis,\"",
        "line": 1725
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A function learning to care,\"",
        "line": 1728
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1154,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The network,\"",
        "line": 1751
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1156,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Waiting for what?\"",
        "line": 1755
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know. The Spires feel... different than I remember. Changed. The Queen's corruption ran deeper than just this pyramid. There are patterns in the network I don't recognize. Equations that don't resolve.\"",
        "line": 1760
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1161,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Could it be a trap?\"",
        "line": 1763
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perhaps.\"",
        "line": 1765
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1168,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 1774
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To fully understand the network's current state?\"",
        "line": 1776
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And until then?\"",
        "line": 1779
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I rest. I recover. I remain free.\"",
        "line": 1782
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You saved me. I will not waste that gift by acting rashly.\"",
        "line": 1787
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So the Spires stay dormant,\"",
        "line": 1790
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For now. Until I understand what I'm truly facing.\"",
        "line": 1793
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1186,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Come on,\"",
        "line": 1802
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1188,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I may not be able to activate the Spires yet,\"",
        "line": 1806
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1189,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Always,\"",
        "line": 1808
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1213,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"What will you do?\"",
        "line": 1845
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1214,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Walk with you,\"",
        "line": 1847
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1217,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Orders, Commander?\"",
        "line": 1852
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1220,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We rest,\"",
        "line": 1857
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them be ready,\"",
        "line": 1860
      }
    }
  ],
