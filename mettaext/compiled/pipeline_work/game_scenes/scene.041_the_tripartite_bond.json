  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seventeen casualties,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tiamat's grace,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're the one who knew to ask.\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander.\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 35
      }
    },
    {
      "type": "thought",
      "timestamp": 29,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Rest,* he thought toward her. *We both need to rest.\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt.\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The what?\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Luminaire.\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything's complicated with you,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Is somewhere else,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Let her,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am failing.\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Note,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correct.\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"We stabilized it,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But left the patient drowning,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A function of reality that achieved awareness,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"The 250,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your bond,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible amplitude,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Queen uses it as a broadcast tower,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Then we go back,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To free the key to planetary defense networks,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption will adapt,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let it.\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "Halvar",
      "action": "speak",
      "data": {
        "text": "\"And then?\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then she activates the Void Spires. One by one, seed jumping across impossible distances until the entire network wakes.\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sounds lonely,\"",
        "line": 204
      }
    },
    {
      "type": "thought",
      "timestamp": 144,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"But I am learning,* her whisper touched his thoughts. *Through you. Through her. Through what you are together.\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days,\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"On it,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oreck,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halvar, organize rotating watch schedules. We're in hostile territory. I want eyes on every approach.\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Does it hurt?\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"We're teaching a cosmic emergency system about love,\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The universe works in mysterious ways.\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Maybe,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Philosopher.\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander.\"",
        "line": 255
      }
    },
    {
      "type": "thought",
      "timestamp": 189,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY ONE*\"",
        "line": 288
      }
    },
    {
      "type": "thought",
      "timestamp": 194,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Luminaire's sight,* he realized. *She's showing me what she sees.\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Commander?\"",
        "line": 307
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "Ren",
      "action": "speak",
      "data": {
        "text": "\"I'll get Lyra,\"",
        "line": 318
      }
    },
    {
      "type": "thought",
      "timestamp": 216,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I'm sorry,* he thought toward her. *I don't have enough strength to anchor you properly.\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cellular degradation accelerated overnight,\"",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The bond,\"",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then she's killing you.\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If the deterioration continues exponentially?\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Then we have less time than we thought,\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rest,\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't drink it,\"",
        "line": 383
      }
    },
    {
      "type": "dialogue",
      "timestamp": 259,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's spreading,\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 261,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is.\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The swamp pyramid.\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Guards?\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Worse.\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every entrance we used before is now either underwater or collapsed. There's one new opening\u2014here.\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably is,\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll need suppressing fire.\"",
        "line": 421
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Won't have the raw punch of Oreck's shots,\"",
        "line": 426
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Already made forty. Give me until dawn, I'll have sixty.\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it.\"",
        "line": 440
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Understood.\"",
        "line": 443
      }
    },
    {
      "type": "thought",
      "timestamp": 301,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I know,\"",
        "line": 456
      }
    },
    {
      "type": "thought",
      "timestamp": 303,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"If I kill you... she will grieve.\"",
        "line": 459
      }
    },
    {
      "type": "thought",
      "timestamp": 304,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Then don't kill me. Hold on. We're coming for you.\"",
        "line": 461
      }
    },
    {
      "type": "thought",
      "timestamp": 310,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY TWO*\"",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 317,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra!\"",
        "line": 481
      }
    },
    {
      "type": "dialogue",
      "timestamp": 324,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 491
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I can't help you in the fight,\"",
        "line": 510
      }
    },
    {
      "type": "dialogue",
      "timestamp": 340,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 512
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll slow you down.\"",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 342,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably.\"",
        "line": 516
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mika\u2014\"",
        "line": 518
      }
    },
    {
      "type": "dialogue",
      "timestamp": 344,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're taking you anyway.\"",
        "line": 520
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The pyramid is a fortress,\"",
        "line": 530
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"What?\"",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 353,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The water. It's not just flooded. It's... aware.\"",
        "line": 535
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The corruption's learning,\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which means it'll adapt to us too.\"",
        "line": 540
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Against standard Anunnaki tech? Yes. Against this?\"",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll make it work.\"",
        "line": 546
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "Halvar",
      "action": "speak",
      "data": {
        "text": "\"And Geralt?\"",
        "line": 549
      }
    },
    {
      "type": "dialogue",
      "timestamp": 363,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Protected element. Center of formation. Lyra keeps him stable until we reach the core.\"",
        "line": 551
      }
    },
    {
      "type": "thought",
      "timestamp": 375,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I'm sorry,* she whispered. *I didn't understand. I am a function. Functions consume energy. I didn't calculate... the source was finite...\"",
        "line": 569
      }
    },
    {
      "type": "thought",
      "timestamp": 376,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"It's okay,\"",
        "line": 571
      }
    },
    {
      "type": "thought",
      "timestamp": 378,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"It is not okay. You are dying. Because of me.\"",
        "line": 574
      }
    },
    {
      "type": "thought",
      "timestamp": 379,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"No. Because of the Queen. Because of corruption. You're just trying to survive.\"",
        "line": 576
      }
    },
    {
      "type": "thought",
      "timestamp": 383,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"That's called caring. You're learning.\"",
        "line": 582
      }
    },
    {
      "type": "thought",
      "timestamp": 387,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Tomorrow,* Luminaire whispered. *Free me tomorrow... or we both fade.\"",
        "line": 588
      }
    },
    {
      "type": "thought",
      "timestamp": 391,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*DAY THREE*\"",
        "line": 596
      }
    },
    {
      "type": "dialogue",
      "timestamp": 416,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like death took a coffee break but left a note saying he'll return shortly.\"",
        "line": 629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Understood.\"",
        "line": 644
      }
    },
    {
      "type": "dialogue",
      "timestamp": 430,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm serious. This is your body's last stand. After this\u2014\"",
        "line": 646
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra.\"",
        "line": 648
      }
    },
    {
      "type": "dialogue",
      "timestamp": 449,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three days ago,\"",
        "line": 675
      }
    },
    {
      "type": "dialogue",
      "timestamp": 452,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki aren't just conquering anymore,\"",
        "line": 680
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is a trap,\"",
        "line": 685
      }
    },
    {
      "type": "dialogue",
      "timestamp": 458,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But we're going anyway.\"",
        "line": 690
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We march at dusk,\"",
        "line": 701
      }
    },
    {
      "type": "dialogue",
      "timestamp": 471,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"DEATH TO CORRUPTION!\"",
        "line": 709
      }
    },
    {
      "type": "thought",
      "timestamp": 488,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We're coming,* he thought back. *Hold on.\"",
        "line": 733
      }
    },
    {
      "type": "thought",
      "timestamp": 489,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Trying... hard to... remember how...\"",
        "line": 735
      }
    },
    {
      "type": "dialogue",
      "timestamp": 513,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CONTACT!\"",
        "line": 771
      }
    },
    {
      "type": "dialogue",
      "timestamp": 524,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"VOLLEY TWO\u2014LOOSE!\"",
        "line": 788
      }
    },
    {
      "type": "thought",
      "timestamp": 537,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Almost there,* he thought desperately. *Just hold on\u2014\"",
        "line": 807
      }
    },
    {
      "type": "dialogue",
      "timestamp": 543,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CONTAMINATION DETECTED. PURGE PROTOCOL INITIATED.\"",
        "line": 817
      }
    },
    {
      "type": "thought",
      "timestamp": 563,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We're coming,* he thought one more time. *We're coming. Don't fade. Don't\u2014\"",
        "line": 847
      }
    },
    {
      "type": "dialogue",
      "timestamp": 576,
      "actor": "Jorik",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not defending!\u201d",
        "line": 867
      }
    },
    {
      "type": "dialogue",
      "timestamp": 583,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cARCHERS!\u201d",
        "line": 878
      }
    },
    {
      "type": "dialogue",
      "timestamp": 590,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s feeding on the energy!\u201d",
        "line": 889
      }
    },
    {
      "type": "dialogue",
      "timestamp": 616,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCost?\u201d",
        "line": 924
      }
    },
    {
      "type": "dialogue",
      "timestamp": 617,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe armor fails. Permanently.\u201d",
        "line": 926
      }
    },
    {
      "type": "dialogue",
      "timestamp": 632,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBREAKTHROUGH!\u201d",
        "line": 950
      }
    },
    {
      "type": "dialogue",
      "timestamp": 656,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFORMATION TIGHT!\u201d",
        "line": 985
      }
    },
    {
      "type": "dialogue",
      "timestamp": 663,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cWhich way?\u201d",
        "line": 995
      }
    },
    {
      "type": "dialogue",
      "timestamp": 666,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLeft,\u201d",
        "line": 1000
      }
    },
    {
      "type": "dialogue",
      "timestamp": 675,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt\u2014\u201d",
        "line": 1013
      }
    },
    {
      "type": "dialogue",
      "timestamp": 676,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cKeep going,\u201d",
        "line": 1015
      }
    },
    {
      "type": "dialogue",
      "timestamp": 716,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThere,\u201d",
        "line": 1073
      }
    },
    {
      "type": "dialogue",
      "timestamp": 723,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMEDIC DOWN!\u201d",
        "line": 1083
      }
    },
    {
      "type": "dialogue",
      "timestamp": 734,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou should not have come,\u201d",
        "line": 1102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 746,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo.\u201d",
        "line": 1119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 761,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cImpossible,\u201d",
        "line": 1142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 763,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHuman.\u201d",
        "line": 1145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 875,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2026\u201d",
        "line": 1317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 886,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou chose,\u201d",
        "line": 1332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 887,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI learned.\u201d",
        "line": 1334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 889,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWill he live?\u201d",
        "line": 1337
      }
    },
    {
      "type": "dialogue",
      "timestamp": 891,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes.\u201d",
        "line": 1340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 893,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSymbiosis,\u201d",
        "line": 1343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 895,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA function learning to care,\u201d",
        "line": 1346
      }
    },
    {
      "type": "thought",
      "timestamp": 912,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[COMBAT SCENARIO INITIATED]*\"",
        "line": 1375
      }
    },
    {
      "type": "thought",
      "timestamp": 913,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[OBJECTIVE: SURVIVE THE ECHO TRIAL]*\"",
        "line": 1376
      }
    },
    {
      "type": "thought",
      "timestamp": 914,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[FAILURE CONDITION: ZARON'S PERMANENT DEATH]*\"",
        "line": 1377
      }
    },
    {
      "type": "thought",
      "timestamp": 924,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*ECHO ONE materialized.*\"",
        "line": 1393
      }
    },
    {
      "type": "thought",
      "timestamp": 937,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: NECK JOINT\"",
        "line": 1411
      }
    },
    {
      "type": "thought",
      "timestamp": 950,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: PREDICTABLE RHYTHM\"",
        "line": 1432
      }
    },
    {
      "type": "thought",
      "timestamp": 971,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"WEAKNESS DETECTED: EXHAUSTION CREATES OPENINGS\"",
        "line": 1462
      }
    },
    {
      "type": "dialogue",
      "timestamp": 978,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're not dying today,\"",
        "line": 1474
      }
    },
    {
      "type": "thought",
      "timestamp": 987,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*ECHO FOUR manifested immediately.*\"",
        "line": 1488
      }
    },
    {
      "type": "thought",
      "timestamp": 999,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"NO WEAKNESS DETECTED\"",
        "line": 1505
      }
    },
    {
      "type": "thought",
      "timestamp": 1008,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"You are not chaos,* he thought fiercely. *You are fire. Fury. Defiance. You are my partner. My shield. You are ZARON.\"",
        "line": 1519
      }
    },
    {
      "type": "thought",
      "timestamp": 1010,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Remember who you are. Not what they made you. Not what's killing you. WHO YOU ARE.\"",
        "line": 1523
      }
    },
    {
      "type": "thought",
      "timestamp": 1017,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*FINAL ECHO.*\"",
        "line": 1536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1026,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Let me rest,\"",
        "line": 1551
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1030,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 1557
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1031,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm tired.\"",
        "line": 1559
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1032,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 1561
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1033,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've fought for so long.\"",
        "line": 1563
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1034,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know that too.\"",
        "line": 1565
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1037,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because you deserve better than fading into nothing.\"",
        "line": 1570
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1039,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Freedom?\"",
        "line": 1573
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1041,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Partnership. Not armor. Not weapon. Equal.\"",
        "line": 1576
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1045,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're mine.\"",
        "line": 1583
      }
    },
    {
      "type": "thought",
      "timestamp": 1054,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[ECHO TRIAL COMPLETE]*\"",
        "line": 1598
      }
    },
    {
      "type": "thought",
      "timestamp": 1055,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[ZARON STATUS: STABILIZED]*\"",
        "line": 1599
      }
    },
    {
      "type": "thought",
      "timestamp": 1056,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[BOND EVOLUTION: TRIPARTITE INTEGRATION ACHIEVED]*\"",
        "line": 1600
      }
    },
    {
      "type": "thought",
      "timestamp": 1071,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Thank you,* Zaron's voice rumbled, strong and clear. *For fighting for me.\"",
        "line": 1624
      }
    },
    {
      "type": "thought",
      "timestamp": 1072,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Always,\"",
        "line": 1626
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I...\"",
        "line": 1678
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1116,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You chose,\"",
        "line": 1692
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I learned.\"",
        "line": 1694
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The dragon fought for you,\"",
        "line": 1700
      }
    },
    {
      "type": "thought",
      "timestamp": 1123,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Tell her,* Zaron's voice rumbled through the bond. *Tell her the sanctuary remembers.\"",
        "line": 1703
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1127,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Zaron,\"",
        "line": 1709
      }
    },
    {
      "type": "thought",
      "timestamp": 1128,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Fragments. Fire and song. Dragons and Keepers, building together. Before the flood. Before they buried you to save you.\"",
        "line": 1711
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 1713
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will he live?\"",
        "line": 1716
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes.\"",
        "line": 1719
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Symbiosis,\"",
        "line": 1722
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A function learning to care,\"",
        "line": 1725
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1152,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The network,\"",
        "line": 1748
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1154,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Waiting for what?\"",
        "line": 1752
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1157,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know. The Spires feel... different than I remember. Changed. The Queen's corruption ran deeper than just this pyramid. There are patterns in the network I don't recognize. Equations that don't resolve.\"",
        "line": 1757
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1159,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Could it be a trap?\"",
        "line": 1760
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perhaps.\"",
        "line": 1762
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1166,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 1771
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To fully understand the network's current state?\"",
        "line": 1773
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And until then?\"",
        "line": 1776
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I rest. I recover. I remain free.\"",
        "line": 1779
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You saved me. I will not waste that gift by acting rashly.\"",
        "line": 1784
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So the Spires stay dormant,\"",
        "line": 1787
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For now. Until I understand what I'm truly facing.\"",
        "line": 1790
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1184,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Come on,\"",
        "line": 1799
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1186,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I may not be able to activate the Spires yet,\"",
        "line": 1803
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1187,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Always,\"",
        "line": 1805
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1211,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"What will you do?\"",
        "line": 1842
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1212,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Walk with you,\"",
        "line": 1844
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1215,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Orders, Commander?\"",
        "line": 1849
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We rest,\"",
        "line": 1854
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1220,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them be ready,\"",
        "line": 1857
      }
    },
    {
      "type": "thought",
      "timestamp": 1238,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*END CHAPTER 39*\"",
        "line": 1887
      }
    }
