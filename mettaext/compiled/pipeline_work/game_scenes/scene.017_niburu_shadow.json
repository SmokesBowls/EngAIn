  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Igigi scatter-protocol was... efficient,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They demonstrate cognitive evolution beyond their designed parameters,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precedent?\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Traditional pursuit protocols would be... inefficient,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we don't pursue,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Gone,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Presumed terminated, my Queen. The Southern colony has defensive capabilities exceeding\u2014\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Forget them,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They were eyes. They saw. They died. That is data enough.\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Prepare the shadow,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the Northern Igigi scatter\u2014\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Freeze them all,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are favorable,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Single star system, galactic backwater sector. The indigenous populations are pre-technological\u2014they would not interfere with punishment protocols. The refugees have established primitive shelters on the northern landmasses, attempting to integrate with local ecosystem patterns.\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Orbital insertion parameters?\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Permanent eclipse positioning,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The refugee populations will attempt adaptation,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them try,\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Initiate Nibiru displacement protocols,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 139
      }
    }
  ],
