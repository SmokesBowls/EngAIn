{
  "scene_id": "scene.017_niburu_shadow",
  "description": "Chapter 17 SECOND MOVEMENT: NIBIRU'S SHADOW",
  "entities": [
    {
      "id": "enlil",
      "name": "Enlil",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
