  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are losing,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert is worse,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You ally with Anunnaki creatures while we die,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Brajor chose alliance,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Convenient distinction,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're doomed,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're doomed if we accept them,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't cross the Veil without their permission,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the planet can touch both sides,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And ask for what?\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The old defenses,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We attempt communion,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "Saresh",
      "action": "speak",
      "data": {
        "text": "\"And if the cost is too high?\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"Whatever they demand,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll maintain it,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We understand cost. Show us anyway.\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek any weapon that can oppose the golden ones,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Explain the requirements.\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This will kill us,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And if it doesn't survive? If we fracture?\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have no real choice,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I disagree,\"",
        "line": 199
      }
    }
  ],
