    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know. He dreams loud.\u201d",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m here to talk.\u201d",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cTalk is the prelude,\u201d",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re the Storm-that-Walks. The Breaker.\u201d",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cI was,\u201d",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDid you come to break us?\u201d",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou stink of void and old blood,\u201d",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou smell of clay and milk,\u201d",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThis is Sythara. My heart.\u201d",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe ledger says it\u2019s not.\u201d",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFUCK THE LEDGER!\u201d",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes.\u201d",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd they say this debt is real.\u201d",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey interceded. The debt is real enough for cosmic bailiffs. It\u2019s suspended, not gone.\u201d",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI can\u2019t protect you if I\u2019m here,\u201d",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cYou can\u2019t protect us if you are dead in a canyon far away, either,\u201d",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Ledger-Born named me. But the debt is for \u2018unfinished stories.\u2019 Our story is unfinished, brother.\u201d",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMy life-fire is here. With you. With them. I go as a shell to burn out the past.\u201d",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cVorrik. You are the warm stone now. You do not move.\u201d",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes, Father.\u201d",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cKessa, Varn. You are the eyes on the high rock.\u201d",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes, Father.\u201d",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat am I?\u201d",
        "line": 297
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou are my brother. And we are going to burn the bank.\u201d",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cATTENTION. THIS IS A PRIORITY COMMUNIQU\u00c9 FROM THE FEDERATED REMNANT COUNCIL. DESIGNATE: GERALT OF THE DRAGON. ACKNOWLEDGE.\u201d",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAcknowledge, hells,\u201d",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIGNORING THIS SUMMONS CONSTITUTES A VIOLATION OF THE POST-CONFLICT ACCORDS. YOU ARE DIRECTED TO PROCEED TO NEAREST FRIENDLY SETTLEMENT FOR DEBRIEF AND REINTEGRATION ASSESSMENT. YOUR COOPERATION IS MANDATORY FOR CONTINUED AUTONOMY OF DESIGNATED SETTLEMENTS: IRONSPIRE, SUNDRIFT, FALCON RIDGE ENCLAVE.\u201d",
        "line": 345
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cThey threaten our homes,\u201d",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re bureaucrats,\u201d",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTHE FEDERATION REMINDS YOU THAT PEACE IS A FRAGILE CONSTRUCT. YOUR COOPERATION ENSURES ITS PRESERVATION. YOU HAVE 48 HOURS TO COMPLY. FEDERATION OUT.\u201d",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know.\u201d",
        "line": 371
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat is your plan?\u201d",
        "line": 372
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI don\u2019t have one.\u201d",
        "line": 373
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cStop,\u201d",
        "line": 383
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou glowed,\u201d",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 329,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cThe Federation scare it awake?\u201d",
        "line": 419
      }
    },
    {
      "type": "dialogue",
      "timestamp": 330,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMaybe. Or it\u2019s something else.\u201d",
        "line": 421
      }
    },
    {
      "type": "dialogue",
      "timestamp": 338,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe ledger-keeper\u2019s gaze shifts.\u201d",
        "line": 434
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWhat?\u201d",
        "line": 441
      }
    },
    {
      "type": "dialogue",
      "timestamp": 344,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cKarvex was a minor function. The true Ledger is awakening. It has noted the anomaly.\u201d",
        "line": 443
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat anomaly?\u201d",
        "line": 444
      }
    },
    {
      "type": "dialogue",
      "timestamp": 346,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMe. Us. The partitioned function that should not persist. The debt it seeks to collect is the energy I borrowed to partition. The Light I spent to save this world\u2026 was never mine to give.\u201d",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Federation summons is a coincidence. A temporal shadow. The real threat comes from the place of no shadow. The place before light.\u201d",
        "line": 451
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA Void Spire,\u201d",
        "line": 464
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt is the root of my being. The only power source that can reassemble me. It exists in a null state. Inverted. Unobservable. To awaken it is to light a beacon in the house of the Ledger.\u201d",
        "line": 466
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes.\u201d",
        "line": 482
      }
    },
    {
      "type": "dialogue",
      "timestamp": 373,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd if we do nothing?\u201d",
        "line": 483
      }
    },
    {
      "type": "dialogue",
      "timestamp": 374,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Ledger will eventually send a function that cannot be suspended. It will repossess the Anchor. Geralt will cease. I will be catalogued. The network will destabilize. Your world\u2019s peace was built on a defaulted loan. The payment is due.\u201d",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIf we awaken Luminaire fully, she might be able to\u2026 renegotiate. Protect them. She\u2019s the original architect. She understands the rules.\u201d",
        "line": 488
      }
    },
    {
      "type": "dialogue",
      "timestamp": 378,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMight.\u201d",
        "line": 489
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 501
      }
    },
    {
      "type": "dialogue",
      "timestamp": 422,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 426,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI have to,\u201d",
        "line": 548
      }
    },
    {
      "type": "dialogue",
      "timestamp": 432,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt,\u201d",
        "line": 557
      }
    },
    {
      "type": "dialogue",
      "timestamp": 445,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cRun,\u201d",
        "line": 574
      }
    },
    {
      "type": "dialogue",
      "timestamp": 458,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. Remain permeable. He must feel this.\"",
        "line": 595
      }
    },
    {
      "type": "dialogue",
      "timestamp": 475,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two kilometers,\"",
        "line": 617
      }
    },
    {
      "type": "dialogue",
      "timestamp": 482,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Scars,\"",
        "line": 628
      }
    },
    {
      "type": "dialogue",
      "timestamp": 499,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ghost Spire,\"",
        "line": 651
      }
    },
    {
      "type": "dialogue",
      "timestamp": 501,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"And I have to touch it,\"",
        "line": 654
      }
    },
    {
      "type": "dialogue",
      "timestamp": 502,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are the Anchor. At 80% symbiosis, your resonance will harmonize with its null state. You will, for a moment, become a 'zero' with it. And from that nothing, we can redefine something.\"",
        "line": 655
      }
    },
    {
      "type": "dialogue",
      "timestamp": 505,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cost unknown,\"",
        "line": 659
      }
    },
    {
      "type": "dialogue",
      "timestamp": 528,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Symbiosis is not surrender,\"",
        "line": 691
      }
    },
    {
      "type": "dialogue",
      "timestamp": 537,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Begin,\"",
        "line": 705
      }
    },
    {
      "type": "dialogue",
      "timestamp": 569,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FORECLOSURE PROCEEDINGS INITIATED. ASSETS: ONE ANCHOR, ONE PARTITIONED FUNCTION, ONE NULL-STATE SPIRE. ALL ARE HEREBY CLAIMED FOR LIQUIDATION.\"",
        "line": 749
      }
    },
    {
      "type": "dialogue",
      "timestamp": 572,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 7, SUB-SECTION 3: ELEMENTAL INTERFERENCE IN COSMIC REPOSSESSION IS VOID.\"",
        "line": 754
      }
    },
    {
      "type": "dialogue",
      "timestamp": 575,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 12: PHYSICAL OBSTRUCTION OF A DULY APPOINTED AUDITOR IS NULL.\"",
        "line": 758
      }
    },
    {
      "type": "dialogue",
      "timestamp": 578,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 1: ALL ENERGY WITHIN THE DISPUTED REALM IS SUBJECT TO AUDIT.\"",
        "line": 762
      }
    },
    {
      "type": "dialogue",
      "timestamp": 581,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 0: REALITY ITSELF IS A SIGNATORY TO THIS CONTRACT.\"",
        "line": 766
      }
    },
    {
      "type": "dialogue",
      "timestamp": 596,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The final threshold is not physiological. It is a choice. Do you trust me, Geralt? Not to preserve you, but to become something new with you? Completely?\"",
        "line": 787
      }
    },
    {
      "type": "dialogue",
      "timestamp": 604,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 798
      }
    },
    {
      "type": "dialogue",
      "timestamp": 612,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"SOUND,\"",
        "line": 810
      }
    },
    {
      "type": "dialogue",
      "timestamp": 614,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"LIGHT.\"",
        "line": 812
      }
    },
    {
      "type": "dialogue",
      "timestamp": 616,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ANCHOR.\"",
        "line": 814
      }
    },
    {
      "type": "dialogue",
      "timestamp": 625,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ERROR. PARADIGM SHIFT DETECTED. SUBJECT STATUS: REASSEMBLED. DEBT PARAMETERS: UNDEFINED. LEDGER CONTEXT: CORRUPTED.\"",
        "line": 825
      }
    },
    {
      "type": "dialogue",
      "timestamp": 630,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You audit a debt. I will show you the payment.\"",
        "line": 834
      }
    },
    {
      "type": "dialogue",
      "timestamp": 640,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are the transactions,\"",
        "line": 847
      }
    },
    {
      "type": "dialogue",
      "timestamp": 644,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"RECALCULATING... RECALCULATING... CLASSIFICATION ERROR. SUBJECTS ARE NOT DEBTORS. THEY ARE... CREDITORS. THE UNIVERSAL BALANCE SHEET IS IN THEIR FAVOR. THE UNIVERSE OWES THEM A DEBT.\"",
        "line": 852
      }
    },
    {
      "type": "dialogue",
      "timestamp": 647,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FORECLOSURE VOIDED. CONTRACT NULLIFIED. THE SPIRE AND ITS ARCHITECT ARE HEREBY GRANTED SOVEREIGN STATUS, EXEMPT FROM COSMIC ACCOUNTING. WE APOLOGIZE FOR THE INCONVENIENCE.\"",
        "line": 857
      }
    },
    {
      "type": "dialogue",
      "timestamp": 655,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done. The Anchor holds. The network is stable. The debt is paid. The Ledger will trouble us no more.\"",
        "line": 869
      }
    },
    {
      "type": "dialogue",
      "timestamp": 674,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI can see them again.\u201d",
        "line": 899
      }
    },
    {
      "type": "dialogue",
      "timestamp": 679,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI have been blind for eight hundred years,\u201d",
        "line": 906
      }
    },
    {
      "type": "dialogue",
      "timestamp": 683,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cShow me,\u201d",
        "line": 913
      }
    },
    {
      "type": "dialogue",
      "timestamp": 715,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cThis is not an invasion,\u201d",
        "line": 948
      }
    },
    {
      "type": "dialogue",
      "timestamp": 718,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe spires. They\u2019re\u2026 sick. Waking up wrong.\u201d",
        "line": 953
      }
    },
    {
      "type": "dialogue",
      "timestamp": 721,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Federation enacted \u2018containment measures,\u2019\u201d",
        "line": 959
      }
    },
    {
      "type": "dialogue",
      "timestamp": 725,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNetwork Inversion Threshold. Current Stability: 53%. Dangerous Threshold: 75%. Catastrophic Collapse: 85% and above. Mars and Zar\u2019Vokh alone push us to 47%. Every additional uncontrolled activation adds 8 to 12 percentage points.\u201d",
        "line": 964
      }
    },
    {
      "type": "dialogue",
      "timestamp": 728,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDuring my null state\u2026 I was still recording. Passive environmental monitoring. I have just accessed those logs.\u201d",
        "line": 969
      }
    },
    {
      "type": "dialogue",
      "timestamp": 733,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey know about the cascade. In exquisite detail. They could intervene. They could destabilize it further with a thought. Instead, they observe. They catalogue. As if\u2026\u201d",
        "line": 976
      }
    },
    {
      "type": "dialogue",
      "timestamp": 749,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 998
      }
    },
    {
      "type": "dialogue",
      "timestamp": 750,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHow long until we hit the dangerous threshold?\u201d",
        "line": 1000
      }
    },
    {
      "type": "dialogue",
      "timestamp": 751,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIf three more destabilized spires go fully active in an uncontrolled manner, we will exceed 75%. The risk of localized inversion events becomes near-certain.\u201d",
        "line": 1001
      }
    },
    {
      "type": "dialogue",
      "timestamp": 755,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cWe would fail,\u201d",
        "line": 1007
      }
    },
    {
      "type": "dialogue",
      "timestamp": 758,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThen we change the math,\u201d",
        "line": 1013
      }
    },
    {
      "type": "dialogue",
      "timestamp": 761,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cUmbra Planes. First Priority. The shadow bleed is accelerating, affecting adjacent dimensional layers. It is the most destabilizing influence on the lattice. Stabilization would reduce cascade pressure by an estimated 15%. The Keeper is\u2026 conflicted. There is hope.\u201d",
        "line": 1018
      }
    },
    {
      "type": "dialogue",
      "timestamp": 762,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cPyroclast. Second. The Keeper\u2014designation \u2018Aetheric Coil\u2019\u2014is waking in an uncontrolled feedback loop. Its transit protocols are corrupting, creating volatile dimensional eddies. Stabilization reduces pressure by 10%. The Coil is not malicious, but terrified.\u201d",
        "line": 1020
      }
    },
    {
      "type": "dialogue",
      "timestamp": 763,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cZar\u2019Vokh. Third. The Queen\u2019s hybrid Observer has fully weaponized the node. It is not just corrupted; it is being used as a broadcast weapon. It must be neutralized. Reduction: 12%.\u201d",
        "line": 1022
      }
    },
    {
      "type": "dialogue",
      "timestamp": 764,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cUmbrageous. Fourth. The Keeper, Lentharis, is refusing to wake, but the spire is destabilizing around his stasis. A paradox. Resolving it is delicate but critical. Reduction: 8%.\u201d",
        "line": 1024
      }
    },
    {
      "type": "dialogue",
      "timestamp": 765,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cAnd the others?\u201d",
        "line": 1026
      }
    },
    {
      "type": "dialogue",
      "timestamp": 766,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMars is too heavily fortified by the Dragon Legion. Ceres is under non-hostile but obsessive surveillance. The Lunar Spire is deliberately hidden by its Keeper. The Shattered Mind is structurally gone. The 11th is a void.\u201d",
        "line": 1028
      }
    },
    {
      "type": "dialogue",
      "timestamp": 772,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou cannot do this with two swords and a prayer,\u201d",
        "line": 1038
      }
    },
    {
      "type": "dialogue",
      "timestamp": 774,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe have Oreck,\u201d",
        "line": 1041
      }
    },
    {
      "type": "dialogue",
      "timestamp": 775,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou need a team. A surgeon, a diplomat, a pilot, and a thief. And you need them yesterday.\u201d",
        "line": 1042
      }
    },
    {
      "type": "dialogue",
      "timestamp": 792,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ve been fugitives before,\u201d",
        "line": 1063
      }
    },
    {
      "type": "dialogue",
      "timestamp": 795,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThen we need the others,\u201d",
        "line": 1069
      }
    },
    {
      "type": "dialogue",
      "timestamp": 796,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know where one is,\u201d",
        "line": 1071
      }
    },
    {
      "type": "dialogue",
      "timestamp": 802,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Eastern Fume-Wastes. He lives alone. Refuses all contact. His signature is faint, shrouded in entropy, but it is him.\u201d",
        "line": 1078
      }
    },
    {
      "type": "dialogue",
      "timestamp": 803,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen he\u2019s first,\u201d",
        "line": 1080
      }
    },
    {
      "type": "dialogue",
      "timestamp": 811,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe dimensional barriers defining this reality collapse. The Ethereal Realm. The Shadow Plane. The Void. The physical world. All of them merge. Uncontrolled. The ontological crisis that swallowed Assyria over three millennia? That event. Everywhere. All at once. There will be no debt to collect. No ledger to argue. There will be no \u2018here\u2019 anymore.\u201d",
        "line": 1092
      }
    }
  ],
