  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAmbient light source: unknown,\u201d",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCheerful place,\u201d",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThis ash\u2026 it remembers,\u201d",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re afraid,\u201d",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou carry the resonance of the old networks. You are expected, and also\u2026 feared. Enter. The Echo Crown awaits your words.\u201d",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cDrawn how?\u201d",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAs if called. But we hear nothing. Our communications are light. Theirs are\u2026 something else. Something older. And now, you arrive. Your resonance is loud. It shakes the ash.\u201d",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Kethran",
      "action": "speak",
      "data": {
        "text": "\u201cYour resonance is\u2026 layered,\u201d",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo. Something using your applicator. A sympathetic vibration. It is faint, but it is there. And it is growing.\u201d",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Kethran",
      "action": "speak",
      "data": {
        "text": "\u201cThese are the archives of our failures,\u201d",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cOur star did not die naturally,\u201d",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cVi\u00ean,\u201d",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWhy is Lentharis waking now?\u201d",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThe answer is\u2026 inside you,\u201d",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not trying to kill the Solantri,\u201d",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re being called,\u201d",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to get to the spire before they do,\u201d",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cThis is the throat,\u201d",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThis is impossible!\u201d",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe don\u2019t have to beat them there,\u201d",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWHO WAKES ME?\u201d",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYOU.\u201d",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWho?\u201d",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Applicators!\u201d",
        "line": 285
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cWhat are they optimizing?\u201d",
        "line": 297
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLIFE!\u201d",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re preparing the site,\u201d",
        "line": 307
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to stop it,\u201d",
        "line": 309
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt?\u201d",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s\u2026 taking over.\u201d",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt, STOP!\u201d",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFIGHT IT, GERALT! THE APPLICATOR IS A PART OF YOU, BUT IT IS NOT YOU! YOUR WILL IS THE ANCHOR! HOLD ON!\u201d",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt, I know you\u2019re in there!\u201d",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 336,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou did it,\u201d",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 348,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cThe network is recalibrating,\u201d",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 351,
      "actor": "Lentharis",
      "action": "speak",
      "data": {
        "text": "\u201cYou broke the connection,\u201d",
        "line": 491
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThen we cut the link,\u201d",
        "line": 493
      }
    },
    {
      "type": "dialogue",
      "timestamp": 353,
      "actor": "Lentharis",
      "action": "speak",
      "data": {
        "text": "\u201cThere is a way,\u201d",
        "line": 495
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNot gone,\u201d",
        "line": 500
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 507
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "Lentharis",
      "action": "speak",
      "data": {
        "text": "\u201cThe cage will hold only as long as you have the strength to maintain it,\u201d",
        "line": 509
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAt what cost?\u201d",
        "line": 549
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe spire is orphaned,\u201d",
        "line": 552
      }
    },
    {
      "type": "dialogue",
      "timestamp": 396,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe cage it,\u201d",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 413,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cDo it,\u201d",
        "line": 581
      }
    },
    {
      "type": "dialogue",
      "timestamp": 428,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt is isolated,\u201d",
        "line": 602
      }
    }
  ],
