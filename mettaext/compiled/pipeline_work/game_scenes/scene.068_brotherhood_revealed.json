    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Something feels...\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014Wrong,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Master Vi\u00ean,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The revelation would shatter unprepared minds,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Behold,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Assyrians were Shadow Weavers,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The surviving Dracos came as supplicants,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Voss",
      "action": "speak",
      "data": {
        "text": "\"She was... pragmatic,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But she was also proud,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"While the dragons fought for vengeance and the Applicators harvested worlds,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She created two bloodlines,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two sides of the same coin,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Crimson Blood,\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco Essence,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the Queen's experiments required vessels,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"She had promised the Dracos justice,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"A child,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Conceived through violation, born in captivity, carrying within him the perfect fusion of Crimson Blood and Anunnaki technology,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Geralt,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He saved me,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He saved you both,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are brothers,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You have seen the truth of your origins,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But genetics is only half the equation,\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Both were triggers,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the curse,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is time,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fire that freezes,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You can make them legendary,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco Essence is chaos,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Temporal manipulation,\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Far more than that, Master Vi\u00ean,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Power without wisdom is merely destruction waiting to happen,\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As we were meant to be,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The awakening of your powers was not random,\"",
        "line": 294
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Voss",
      "action": "speak",
      "data": {
        "text": "\"Your friend Keen is already fulfilling her part,\"",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We'll see each other again,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Your training begins now, Master Vi\u00ean,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Her first trial has begun,\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No pressure,\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle network answers your blood,\"",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"All the pressure in the universe,\"",
        "line": 339
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Sundrift,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll be ready when she faces the fifth,\"",
        "line": 365
      }
    }
  ],
