    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Something feels...\"",
        "line": 9
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014Wrong,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Master Vi\u00ean,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The revelation would shatter unprepared minds,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Behold,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Assyrians were Shadow Weavers,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The surviving Dracos came as supplicants,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Voss",
      "action": "speak",
      "data": {
        "text": "\"She was... pragmatic,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But she was also proud,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"While the dragons fought for vengeance and the Applicators harvested worlds,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She created two bloodlines,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two sides of the same coin,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Crimson Blood,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco Essence,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the Queen's experiments required vessels,\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"She had promised the Dracos justice,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"A child,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Conceived through violation, born in captivity, carrying within him the perfect fusion of Crimson Blood and Anunnaki technology,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Geralt,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He saved me,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He saved you both,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are brothers,\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You have seen the truth of your origins,\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But genetics is only half the equation,\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Both were triggers,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle,\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the curse,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is time,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fire that freezes,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You can make them legendary,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco Essence is chaos,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Temporal manipulation,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Far more than that, Master Vi\u00ean,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Power without wisdom is merely destruction waiting to happen,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As we were meant to be,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The awakening of your powers was not random,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "Voss",
      "action": "speak",
      "data": {
        "text": "\"Your friend Keen is already fulfilling her part,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We'll see each other again,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Your training begins now, Master Vi\u00ean,\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Her first trial has begun,\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No pressure,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle network answers your blood,\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"All the pressure in the universe,\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Sundrift,\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll be ready when she faces the fifth,\"",
        "line": 364
      }
    }
  ],
