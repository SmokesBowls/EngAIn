  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Five Void Spires confirmed across the stellar network,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But Earth should have one too,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So where is it?\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hidden,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to triangulate,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Already tried,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about the Star Needle?\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Forgotten Valley,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then that's where we look,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll prepare the airship,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I'll gather the necessary equipment,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"You've changed,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"So has Ironspire,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magic was freedom,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what are you now?\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You understand null states,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The space between definitions,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perception filters,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The null state pushes back,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"So how do we find something that doesn't want to be found?\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We don't find it,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't fight it,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"It's beautiful,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's dangerous,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not uncontrolled,\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I am Luminara,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need your help,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth Spire can serve as an anchor,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"They already know,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"What plans?\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The red curse within his blood. She means to activate it, to transform him into her anchor for controlling the entire network. If she succeeds...\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need everyone,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Nefaretti",
      "action": "speak",
      "data": {
        "text": "\"The Giants will come,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Ironspire's forces,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild stands ready,\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One day. Perhaps two. The calculations are complex when dealing with corrupted nodes.\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we have that long to gather our forces,\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "Luminara",
      "action": "speak",
      "data": {
        "text": "\"You interest me,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"I became what I needed to become,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "Luminara",
      "action": "speak",
      "data": {
        "text": "\"And what will you become next?\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The connection is established,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And our people there? Vi\u00ean, Keen, Rongtai?\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean is... changing. The red curse grows stronger with each hour. But he resists still.\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Then we'd better make it count,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Indeed,\"",
        "line": 265
      }
    }
  ],
