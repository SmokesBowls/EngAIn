  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "Zypher",
      "action": "speak",
      "data": {
        "text": "\"Trust is a currency minted in blood and spent in silence,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are woven from the same threads as creation,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Indeed.\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will wait,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Bad foundation,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"An old one,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014is not empty,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Umbra doesn't forget,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You miscalculated,\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 363,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Bad mortar,\"",
        "line": 484
      }
    },
    {
      "type": "thought",
      "timestamp": 382,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"ENOUGH.\"",
        "line": 511
      }
    },
    {
      "type": "dialogue",
      "timestamp": 392,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stories break,\"",
        "line": 524
      }
    },
    {
      "type": "dialogue",
      "timestamp": 419,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have not undone my work,\"",
        "line": 558
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Where?\"",
        "line": 575
      }
    },
    {
      "type": "dialogue",
      "timestamp": 439,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When,\"",
        "line": 584
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "Zypher",
      "action": "speak",
      "data": {
        "text": "\"The Magnetospheric Recoil,\"",
        "line": 605
      }
    },
    {
      "type": "dialogue",
      "timestamp": 462,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solar fusion,\"",
        "line": 615
      }
    },
    {
      "type": "dialogue",
      "timestamp": 464,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solar fusion,\"",
        "line": 618
      }
    },
    {
      "type": "dialogue",
      "timestamp": 507,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Might?\"",
        "line": 673
      }
    },
    {
      "type": "dialogue",
      "timestamp": 522,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 693
      }
    },
    {
      "type": "dialogue",
      "timestamp": 596,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Appropriate,\"",
        "line": 787
      }
    },
    {
      "type": "dialogue",
      "timestamp": 632,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Won't be drawn until the sun does it for me.\"",
        "line": 832
      }
    },
    {
      "type": "dialogue",
      "timestamp": 640,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You get lost already?\"",
        "line": 843
      }
    },
    {
      "type": "dialogue",
      "timestamp": 646,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You forgot something,\"",
        "line": 851
      }
    },
    {
      "type": "dialogue",
      "timestamp": 657,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tell Kulla\u2014\"",
        "line": 866
      }
    },
    {
      "type": "dialogue",
      "timestamp": 659,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014to fix his damn kiln. I know.\"",
        "line": 869
      }
    },
    {
      "type": "dialogue",
      "timestamp": 700,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You were saying,\"",
        "line": 924
      }
    },
    {
      "type": "dialogue",
      "timestamp": 729,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"The one that *ate me*,\"",
        "line": 963
      }
    },
    {
      "type": "dialogue",
      "timestamp": 734,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"One more stop,\"",
        "line": 971
      }
    },
    {
      "type": "dialogue",
      "timestamp": 749,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Going dark,\"",
        "line": 991
      }
    },
    {
      "type": "thought",
      "timestamp": 777,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Emergency protocol activated. Seed jump primed.\"",
        "line": 1027
      }
    }
  ],
