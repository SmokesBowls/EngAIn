    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Do you feel it?\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network... it's different,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And something else,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Specialized training,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But we remain connected,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ancient protocols awakening...\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You're not just a power source,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nine primary installations,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I'm the activation key,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How do I learn?\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Training available,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A convergence,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And someone destroyed this deliberately,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not just awakening to our heritage,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together we'll be unstoppable,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Apart, we're learning what we need to become complete,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's him,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Patience,\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Network security protocols,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The real training begins now,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together, even when apart,\"",
        "line": 274
      }
    }
  ],
