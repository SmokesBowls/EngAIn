    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix solun amel korveth vel'thanor!\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He comes,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The one who made us,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My children,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have taught as you instructed, Ancient One,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Keen, daughter of earth and moon, child of the one who flew into the sun,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTha\u2019vir en kesh.\u201d",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019ve spoken the First Tongue,\u201d",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But master,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The time has come,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"But I won't be going alone,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Brother of blood, guardian of moments, anchor against the chaos that would unmake creation itself,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Then go,\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you, Speaker of First Words, will walk a different path entirely.\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom's restoration is but one thread in the vast tapestry being woven,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your role,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will not go alone either,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"What about us?\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The paths diverge,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Go now,\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Until we meet again,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"In whatever realm that might be,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will test them beyond anything they have yet faced,\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And yet,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The war that approaches will be fought not just with power, but with wisdom,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The foundations are laid. The bridges are ready to be built. Let the cosmic dance continue.\"",
        "line": 289
      }
    }
  ],
