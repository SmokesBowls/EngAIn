  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Heartwood feels... different,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Forest Giants have longer memories,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"They're watching us,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them observe,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why... do the rootless... bring the abomination... to sacred groves?\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We bring not an abomination, but a bridge,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Verdant Patriarch Oakenheart,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sundering\u2014\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sundering was yesterday to us,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's why we're here,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To ask for more sacrifice from those who have already given too much?\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"You call me abomination,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But I am also proof that growth finds a way,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption spreads through the old root highways,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show us,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is a place,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's forbidden territory,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll go,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As will we,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If.\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Silence, Birch-stride.\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Old Conduits,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I will,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We understand the risks,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "Oakenheart",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Willowdancer",
      "action": "speak",
      "data": {
        "text": "\"My great-grandmother,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Void energy,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beautiful,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Willowdancer",
      "action": "speak",
      "data": {
        "text": "\"Song,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Willowdancer",
      "action": "speak",
      "data": {
        "text": "\"The Blight Warden,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stories?\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"During the Sundering, when the connections burned, some Giants tried to save the network by merging with it directly. Becoming living conduits. But the trauma, the void created by severed connections...\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It transformed them,\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NEW CONNECTIONS... TO SEVER. NEW GROWTH... TO CORRUPT. FEED THE VOID. SPREAD THE SILENCE.\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's in pain,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "Willowdancer",
      "action": "speak",
      "data": {
        "text": "\"Protect the conduits!\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's connected to the entire network,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're unmaking the corruption itself,\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not unmaking,\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I... REMEMBER...\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 281
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I was... Rootkeeper Elmheart,\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Safe?\"",
        "line": 297
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"You were in pain,\"",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Old Conduits,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Differently,\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption's source has been cleansed,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we found this,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have shown us difficult truths,\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The young speak wisdom,\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But what of the Veins of Green?\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Veins of Green,\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There are conditions,\"",
        "line": 349
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And truth,\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ironspire corruption,\"",
        "line": 355
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will,\"",
        "line": 358
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Balance,\"",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will always be welcome in the Heartwood,\"",
        "line": 368
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Tidecallers next,\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They demand courage in the face of natural forces,\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three more essences,\"",
        "line": 401
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Each one a reflection of the Giants' nature,\"",
        "line": 404
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"I understand my purpose now,\"",
        "line": 410
      }
    }
  ],
