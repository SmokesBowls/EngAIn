{
  "scene_id": "scene.076_lunar_inheritance",
  "description": "The Foundation Chamber had grown quiet around Keen, its living stone walls pulsing with the slow, satisfied rhythm of geological contentment.",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The lunar inheritance awakens,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Silver Mika,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"My second trial?\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your inheritance trial,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can feel it calling,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not belongs to you,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your earth magic provides the foundation,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lunar tides don't just affect oceans,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to understand,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Moonlight manipulation,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your earth magic operates primarily in the physical realm,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Moonlight blades,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But weapons are only tools,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the Moon Kingdom truly was,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The quantum beacon network,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And other worlds?\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Each offers its own gifts,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has been disrupted,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone like me,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone exactly like you,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what was lost,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It doesn't trust me,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then you must prove that you are different,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Child of stellar fire and lunar wisdom,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I will,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth-Moon Bridge,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How do you feel?\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Larger,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you can begin to heal that separation,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"When we reunite,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 193
      }
    }
  ],
