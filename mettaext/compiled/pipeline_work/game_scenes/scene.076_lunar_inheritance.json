{
  "scene_id": "scene.076_lunar_inheritance",
  "description": "book 14",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The lunar inheritance awakens,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Silver Mika,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"My second trial?\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your inheritance trial,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can feel it calling,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not belongs to you,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your earth magic provides the foundation,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lunar tides don't just affect oceans,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to understand,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Moonlight manipulation,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your earth magic operates primarily in the physical realm,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Moonlight blades,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But weapons are only tools,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the Moon Kingdom truly was,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The quantum beacon network,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And other worlds?\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Each offers its own gifts,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has been disrupted,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone like me,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone exactly like you,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what was lost,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It doesn't trust me,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then you must prove that you are different,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Child of stellar fire and lunar wisdom,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I will,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth-Moon Bridge,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How do you feel?\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Larger,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you can begin to heal that separation,\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"When we reunite,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 196
      }
    }
  ],
