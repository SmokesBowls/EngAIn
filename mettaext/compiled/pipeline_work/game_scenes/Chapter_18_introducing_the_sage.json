{
  "scene_id": "Chapter_18_introducing_the_sage",
  "description": "Chapter 18: introducing the sage",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix solun amel korveth vel'thanor!\"",
        "line": 9
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He comes,\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The one who made us,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My children,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have taught as you instructed, Ancient One,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Keen, daughter of earth and moon, child of the one who flew into the sun,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTha\u2019vir en kesh.\u201d",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019ve spoken the First Tongue,\u201d",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But master,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The time has come,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"But I won't be going alone,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Brother of blood, guardian of moments, anchor against the chaos that would unmake creation itself,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Then go,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you, Speaker of First Words, will walk a different path entirely.\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom's restoration is but one thread in the vast tapestry being woven,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your role,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will not go alone either,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"What about us?\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The paths diverge,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Go now,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Until we meet again,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"In whatever realm that might be,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will test them beyond anything they have yet faced,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And yet,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The war that approaches will be fought not just with power, but with wisdom,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The foundations are laid. The bridges are ready to be built. Let the cosmic dance continue.\"",
        "line": 288
      }
    }
  ],
