    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Corruption spread is exponential here,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We rest for three days, the Plains die,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mathematics are cruel, Geralt,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We push,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Proto-Dregan,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"TOGETHER OR WE ALL DIE!\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOW!\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Precisely,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\"We tried for the Needle three months back,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\"Now I'm tired of surviving,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"The cost?\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We hit them from three sides at once,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Water,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or immense blunt force trauma,\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Forest Needle burned pieces of me, Geralt,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we stop. We find another way.\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is no other way. Only a faster death, or a slower one. I can protect the soldiers. Create harmonic shields against the sonic attacks. Disrupt the construct\u2019s coordination. But each act\u2026 fragments me further.\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I have learned what caring means,\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's not a choice. That's suicide.\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt, they are dying too fast,\"",
        "line": 383
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can you help him? Just him?\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 284,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will cost.\"",
        "line": 388
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it.\"",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Focus fire! Break them!\"",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "Kessa",
      "action": "speak",
      "data": {
        "text": "\"Layered! Reinforced!\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 325,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Geralt, the shield harmonics\u2026 I can disrupt them,\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 326,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're already fading.\"",
        "line": 447
      }
    },
    {
      "type": "dialogue",
      "timestamp": 327,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are dying NOW. Decide.\"",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 400,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It has adapted!\"",
        "line": 549
      }
    },
    {
      "type": "dialogue",
      "timestamp": 413,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"TOGETHER! NOW!\"",
        "line": 566
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Next time,\"",
        "line": 589
      }
    },
    {
      "type": "dialogue",
      "timestamp": 439,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"The protocols are interwoven,\"",
        "line": 604
      }
    },
    {
      "type": "dialogue",
      "timestamp": 482,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One more Needle,\"",
        "line": 662
      }
    },
    {
      "type": "dialogue",
      "timestamp": 491,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Day 9 - The Burning Tower",
        "line": 675
      }
    }
  ],
