    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not ignoring,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes!\"",
        "line": 241
      }
    },
    {
      "type": "thought",
      "timestamp": 252,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 45 of Enkialu - Dawn of New Calculations\"",
