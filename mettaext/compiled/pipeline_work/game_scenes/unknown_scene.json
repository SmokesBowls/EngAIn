      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Kronocht the Elder,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek alliance,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We know what you seek. The Bones of Stone. The fourth essence for a ritual most think myth.\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Paradox Recursive,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every solution becomes a new problem,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's a feedback loop,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exactly!\"",
        "line": 160
      }
    },
    {
      "type": "thought",
      "timestamp": 162,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Corruption of Logic\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show them Subject Seven,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seven hundred thousand, three hundred and forty-two... no, forty-three... no, the number changes as I count it... but the change must be counted... but counting changes the count...\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Helix was our greatest calculator,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"What happened?\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They succeeded,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How do we fight something that uses our strengths against us?\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then how?\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Chaos?\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't!\"",
        "line": 213
      }
    },
    {
      "type": "thought",
      "timestamp": 218,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Incalculable Solution\"",
