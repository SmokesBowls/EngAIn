      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 5,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cOne more,\u201d",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey know we\u2019re coming.\u201d",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey know three encampments have gone dark. They\u2019ll be ready. Not complacent. Not sloppy. Ready.\u201d",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s the only idea,\u201d",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYes,\u201d",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find out,\u201d",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cThey also know the odds,\u201d",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen they know this is what we are. This is the line. One more. Then we rest.\u201d",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ve had time to prepare,\u201d",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cTwo hundred and ninety,\u201d",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCould infiltrate,\u201d",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cScans show the core\u2019s deep inside the central tower,\u201d",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cThen we don\u2019t use our pattern,\u201d",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re joking,\u201d",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "Kress",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ll have the walls fortified, the approaches mined,\u201d",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes,\u201d",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cExactly. While the main force is tangling at the gate, a small team\u2014five, six max\u2014goes in here.\u201d",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThe team in the conduit will be trapped,\u201d",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey will,\u201d",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019ll lead the diversion,\u201d",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAbsolutely not\u2014\u201d",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s the right tactical choice, Geralt, and you know it.\u201d",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know.\u201d",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIf you\u2019re late\u2026\u201d",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we die in the pipes, and you die at the gate, and the slaves stay in chains.\u201d",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLEGION! WITH ME!\u201d",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cKEEP MOVING! DON\u2019T STOP!\u201d",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSir! Left flank!\u201d",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Kress",
      "action": "speak",
      "data": {
        "text": "\u201cOh, gods,\u201d",
        "line": 297
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cScatter!\u201d",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOT. LIKE. THIS.\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOT. LIKE. THIS.\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 319,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FLY!\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WITH THE COMMANDER! FOR THE LEGION!\"",
        "line": 463
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can we fly?\"",
        "line": 482
      }
    },
    {
      "type": "dialogue",
      "timestamp": 387,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThey don\u2019t fly,\u201d",
        "line": 524
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGood enough.\u201d",
        "line": 526
      }
    },
    {
      "type": "dialogue",
      "timestamp": 393,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGet the slaves clear,\u201d",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 413,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou break the vessels, but the wine is already spilled.\u201d",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 416,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI did not conquer time. I became it.\u201d",
        "line": 565
      }
    },
    {
      "type": "dialogue",
      "timestamp": 435,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cTake down the golems!\u201d",
        "line": 590
      }
    },
    {
      "type": "dialogue",
      "timestamp": 443,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHe\u2019s only healing if we attack from one angle!\u201d",
        "line": 601
      }
    },
    {
      "type": "dialogue",
      "timestamp": 458,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cClever weed.\u201d",
        "line": 620
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou cherish your past choices. Let us see which one you cannot live without.\u201d",
        "line": 631
      }
    },
    {
      "type": "dialogue",
      "timestamp": 481,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt!\u201d",
        "line": 653
      }
    },
    {
      "type": "dialogue",
      "timestamp": 499,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe shield!\u201d",
        "line": 677
      }
    },
    {
      "type": "dialogue",
      "timestamp": 509,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to align them!\u201d",
        "line": 690
      }
    },
    {
      "type": "dialogue",
      "timestamp": 517,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika! Grenn! Everyone! Scar the glyphs! Break the patterns! Don\u2019t destroy\u2014alter!\u201d",
        "line": 701
      }
    },
    {
      "type": "dialogue",
      "timestamp": 527,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou introduce\u2026 noise.\u201d",
        "line": 715
      }
    },
    {
      "type": "dialogue",
      "timestamp": 533,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI offer you a perfect future, Geralt of the Dragon. The one you secretly crave.\u201d",
        "line": 724
      }
    },
    {
      "type": "dialogue",
      "timestamp": 547,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThis is logical. This is optimal. Why choose suffering?\u201d",
        "line": 741
      }
    },
    {
      "type": "dialogue",
      "timestamp": 559,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cI reject your future,\u201d",
        "line": 758
      }
    },
    {
      "type": "dialogue",
      "timestamp": 577,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI am\u2026 removed from the equation. Alive\u2026 but irrelevant.\u201d",
        "line": 784
      }
    },
    {
      "type": "dialogue",
      "timestamp": 582,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGET CLEAR!\u201d",
        "line": 792
      }
    },
    {
      "type": "dialogue",
      "timestamp": 595,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cSoon,\u201d",
        "line": 811
      }
    }
  ],
