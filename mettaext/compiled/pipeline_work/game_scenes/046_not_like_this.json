{
  "scene_id": "046_not_like_this",
  "description": "CHAPTER 44: THE FINAL LIBERATION",
  "entities": [
    {
      "id": "clone",
      "name": "Clone",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
