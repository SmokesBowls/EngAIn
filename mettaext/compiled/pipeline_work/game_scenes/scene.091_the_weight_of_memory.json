{
  "scene_id": "scene.091_the_weight_of_memory",
  "description": "Chapter 32 Prelude",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"My child,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I gave him my sorrow,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When he returns to me, I will hold him. I will love him. And I will finish what we began... before the Fifth Collapse.\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Mother,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I have always loved you,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I don't understand,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What could possibly\u2014\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The temporal one has stabilized,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why are we being held here?\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wrong is subjective | Consequence is absolute | Balance is necessary.\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Memories of catastrophic choices.\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He didn't do anything,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The harmonic scan confirms otherwise,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What exactly am I accused of?\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"During the Culling,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's a lie,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Help that became harm,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I didn't know,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And in doing so, doomed thousands more,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You want to execute him,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Continuation, not reincarnation,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Council is divided,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which faction do you belong to?\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Judgment withheld | Evidence gathering | Decision pending.\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I would use him,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do you propose?\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You agreed too quickly,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're right to be cautious,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was a different you. A different life.\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Is it?\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean of the Zaryonic Line,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The pool that connects to Lentharis?\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Affirmative. However, alternative routes must be used. The Solantri internal passages remain sealed. You will access the deep catacombs, bypassing city authority.\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It's a trap,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These passages are unstable,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Old Observatory,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Will Lentharis help us?\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stability irrelevant. Recognition essential.\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Meaning what, exactly?\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Meaning you must allow full synchronization with your temporal patterns. Similar to what you attempted with Aetheric Coil on Pyroclast, but deeper. More complete.\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Is there another way?\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Negative. Lentharis exists partially beyond conventional reality. Only through temporal synchronization can they be reached.\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll do it,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Resonance Pool,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Keen,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm coming with you,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Lentharis,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know. The red curse. But there's no time. Earth is in danger. The applicators control the Void Needle, spreading corruption through the entire network. We need your help.\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then everything we fought for during the Culling is at risk,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll deal with that when the time comes. Right now, Earth's safety is more important.\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mars?\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solantri forces approaching! Immediate extraction required!\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"How do we get to Mars?\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's our way out,\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What about the sentinel?\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Oath-Bound serve their purpose,\"",
        "line": 323
      }
    }
  ],
