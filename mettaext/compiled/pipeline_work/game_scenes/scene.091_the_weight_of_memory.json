{
  "scene_id": "scene.091_the_weight_of_memory",
  "description": "book 17",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"My child,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I gave him my sorrow,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When he returns to me, I will hold him. I will love him. And I will finish what we began... before the Fifth Collapse.\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Mother,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I have always loved you,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I don't understand,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What could possibly\u2014\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The temporal one has stabilized,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why are we being held here?\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wrong is subjective | Consequence is absolute | Balance is necessary.\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Memories of catastrophic choices.\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He didn't do anything,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The harmonic scan confirms otherwise,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What exactly am I accused of?\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"During the Culling,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's a lie,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Help that became harm,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I didn't know,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And in doing so, doomed thousands more,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You want to execute him,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Continuation, not reincarnation,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Council is divided,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which faction do you belong to?\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Judgment withheld | Evidence gathering | Decision pending.\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I would use him,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do you propose?\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You agreed too quickly,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're right to be cautious,\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was a different you. A different life.\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Is it?\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean of the Zaryonic Line,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The pool that connects to Lentharis?\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Affirmative. However, alternative routes must be used. The Solantri internal passages remain sealed. You will access the deep catacombs, bypassing city authority.\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It's a trap,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Probably,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These passages are unstable,\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Old Observatory,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Will Lentharis help us?\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stability irrelevant. Recognition essential.\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Meaning what, exactly?\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Meaning you must allow full synchronization with your temporal patterns. Similar to what you attempted with Aetheric Coil on Pyroclast, but deeper. More complete.\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Is there another way?\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Negative. Lentharis exists partially beyond conventional reality. Only through temporal synchronization can they be reached.\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll do it,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Resonance Pool,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Keen,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm coming with you,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Lentharis,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know. The red curse. But there's no time. Earth is in danger. The applicators control the Void Needle, spreading corruption through the entire network. We need your help.\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then everything we fought for during the Culling is at risk,\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll deal with that when the time comes. Right now, Earth's safety is more important.\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mars?\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solantri forces approaching! Immediate extraction required!\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"How do we get to Mars?\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's our way out,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What about the sentinel?\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Oath-Bound serve their purpose,\"",
        "line": 326
      }
    }
  ],
