{
  "scene_id": "scene.054_tue_lunar_spire",
  "description": "book 9",
  "entities": [
    {
      "id": "kaelen",
      "name": "Kaelen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    },
    {
      "id": "kyh",
      "name": "Kyh",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 5,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The asteroid field surrounding the Shattered Mind is not merely a physical hazard,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\"No ship we possess could navigate that field and survive,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then where?\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They didn't build here,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This is not my war,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I will not wait idly,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Anchor arrives,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I trained him. I watched him believe he could bear the weight of time through sheer will. I watched the moment his certainty shattered him.\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't move through time. You decide what resists change.\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This fall is an event,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Causal Inertia Control,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Be in multiple outcomes at once\u2014and choose later.\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "Kaelen",
      "action": "speak",
      "data": {
        "text": "\"Superposition,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH.\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It sings,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You seek a deeper layer,\"",
        "line": 288
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are not for browsing,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I need to understand the Spire,\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You went deep,\"",
        "line": 359
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Hello, Geralt,\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The armor remembers me,\"",
        "line": 396
      }
    },
    {
      "type": "dialogue",
      "timestamp": 287,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This is for you,\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A seed. A promise. A beginning.\"",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What time?\"",
        "line": 417
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"In less than three thousand years,\"",
        "line": 419
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't\u2014\"",
        "line": 421
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will.\"",
        "line": 423
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That's my kiss,\"",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 300,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait\u2014\"",
        "line": 432
      }
    },
    {
      "type": "dialogue",
      "timestamp": 302,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom fell to protect this,\"",
        "line": 435
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"She said less than three thousand years,\"",
        "line": 453
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. She gave me... a future.\"",
        "line": 458
      }
    }
  ],
