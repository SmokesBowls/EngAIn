  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Ironspire,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We did,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Where are the founders?\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Celly",
      "action": "speak",
      "data": {
        "text": "\"More survivors keep arriving,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Again?\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Again,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"The place we missed by fifty meters,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How is this here?\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Welcome to Falcon Ridge,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perimeter's good,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue isn't spoken,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One of them. The one this world was sung in.\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Sek'han,\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"It felt natural,\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not built for quiet,\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Where will you go?\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Somewhere that needs defending. Somewhere that needs... action.\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You saved us as much as we saved you,\"",
        "line": 309
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're even, then.\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The book's done,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 247,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm done.\"",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 344
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For Mika,\"",
        "line": 373
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She'd like those,\"",
        "line": 376
      }
    }
  ],
