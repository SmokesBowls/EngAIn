    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're approaching the outer corona,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This shouldn't be possible,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's your presence,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are you certain? The sensors can't penetrate that far, and\u2014\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm certain,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This place... I've been here before,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Another effect of your presence,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Solar Golems,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we'll just have to burn brighter,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They've adapted to the environment,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're trying to surround us,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Let them,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They want us to follow,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Of course they do,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A stronghold,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's inside. I can feel him.\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Whatever happens,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We won't,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Intruders,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He doesn't belong to you. He never did.\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The one who defied the natural order,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He belongs to the Sun now,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Shadow cannot exist here,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"All things change,\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This... changes nothing,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was just the first guardian,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The phoenix child returns to the nest,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are you using him for? What's your purpose here?\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "Ignis",
      "action": "speak",
      "data": {
        "text": "\"I know what you were meant to be,\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you're too late,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Purpose?\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows between stars,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The prisoner... will never be yours,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two down,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You've come so far, only to fail at the threshold,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What knowledge?\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "Blaze",
      "action": "speak",
      "data": {
        "text": "\"Everything,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We cannot defeat it conventionally,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we don't fight it conventionally,\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am of the Sun,\"",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not scattered,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Thang, Phoenix Mage of the Moon Kingdom,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This changes nothing,\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No longer,\"",
        "line": 327
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Are you alright?\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've never felt more... connected,\"",
        "line": 337
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sun reveals truth,\"",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT,\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's alive,\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Sun preserves what it values,\"",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But his time here is done. The burden passes to me, at least until he recovers.\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Can we free him?\"",
        "line": 367
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can,\"",
        "line": 369
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My ethereal magic,\"",
        "line": 375
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"To Earth?\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To the secret hideout,\"",
        "line": 380
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Be ready,\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Now, Rongtai!\"",
        "line": 392
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Send him through,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Will he survive the transition?\"",
        "line": 400
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"He's survived the Sun,\"",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It's done,\"",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Now we follow him to Earth,\"",
        "line": 421
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Now what?\"",
        "line": 426
      }
    }
  ],
