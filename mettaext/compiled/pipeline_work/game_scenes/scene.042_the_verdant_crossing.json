  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTen miles north, already past the Blackroot River.\u201d",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Needle broadcasts corruption. A tuning fork struck wrong, vibrating the land sick.\u201d",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWeeks before the forest is irrevocably dead. Days before the corruption spreads beyond it, into the farmlands, the rivers\u2026 the things your people need to live.\u201d",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe take the Needle.\u201d",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThat\u2019s three days\u2019 hard march through hostile, dying terrain.\u201d",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cAnd if we don\u2019t push,\u201d",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cFast march,\u201d",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe move at dawn,\u201d",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "Jorik",
      "action": "speak",
      "data": {
        "text": "\u201cThis was alive three days ago,\u201d",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re the Legion,\u201d",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe know.\u201d",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we die.\u201d",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMarek.\u201d",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMarek.\u201d",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we\u2019ll fight until you do.\u201d",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey are anchored to this place. Their will creates small points of resistance.\u201d",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou want to fight?\u201d",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThis is vrill manipulation,\u201d",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe are.\u201d",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we\u2019ll help.\u201d",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat something?\u201d",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDon\u2019t know.\u201d",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cQuietly,\u201d",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cI can hold,\u201d",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cTwenty-three dead so far,\u201d",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cWe saved the gully,\u201d",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe did.\u201d",
        "line": 265
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey chose.\u201d",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDid they?\u201d",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know.\u201d",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cOf course they are,\u201d",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cOreck,\u201d",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBut?\u201d",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019ll burn out the armor. Permanently.\u201d",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGO!\u201d",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDID YOU SEE THAT?!\u201d",
        "line": 367
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cOverloaded salvaged Anunnaki armor to break an energy barrier.\u201d",
        "line": 370
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cEffective desperation,\u201d",
        "line": 373
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAt what cost?\u201d",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe big ones always sacrifice first,\u201d",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 259,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTwenty-three casualties to save 40% of a dying forest,\u201d",
        "line": 382
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDepends who you ask,\u201d",
        "line": 387
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd the Luminaire?\u201d",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cShe knows,\u201d",
        "line": 393
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTo save a planet that isn\u2019t even hers.\u201d",
        "line": 396
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBecause she learned what caring means.\u201d",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "Lys",
      "action": "speak",
      "data": {
        "text": "\u201cHow many more Needles?\u201d",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThree. Maybe four.\u201d",
        "line": 405
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cShe won\u2019t survive all of them. Not intact.\u201d",
        "line": 407
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNeither will they.\u201d",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhy?\u201d",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBecause that\u2019s what mortals do. They try impossible things. And sometimes\u2014just sometimes\u2014they succeed.\u201d",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe protocols are similar to the swamp,\u201d",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHurry,\u201d",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cIt is done,\u201d",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThank you,\u201d",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 313,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cDo not thank me yet,\u201d",
        "line": 467
      }
    },
    {
      "type": "dialogue",
      "timestamp": 325,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Day 3 - The Silent Tower",
        "line": 485
      }
    },
    {
      "type": "dialogue",
      "timestamp": 342,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cYou stayed when others fled,\u201d",
        "line": 508
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re Rangers now,\u201d",
        "line": 513
      }
    },
    {
      "type": "dialogue",
      "timestamp": 348,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cUntil the forest doesn\u2019t need you.\u201d",
        "line": 518
      }
    },
    {
      "type": "dialogue",
      "timestamp": 370,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cWe saved 40% of this forest,\u201d",
        "line": 548
      }
    },
    {
      "type": "dialogue",
      "timestamp": 371,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd lost twenty-three people doing it.\u201d",
        "line": 550
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAre we calculating right? Lives versus land?\u201d",
        "line": 552
      }
    }
  ],
