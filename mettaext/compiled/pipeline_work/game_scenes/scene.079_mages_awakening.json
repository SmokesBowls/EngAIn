  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What inheritance?\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Show me,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Guild,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The horses are ready, Father,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Where exactly are we going?\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The Needle will guide us,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can feel it calling, Father. A network awakening, recognizing those who carry the right bloodlines, the right knowledge, the right... intent.\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Is this parent... friendly?\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We need to reach the others, Father,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we ride,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The network recognizes us,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Queen returns,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Where?\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The inheritors remember,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"So I'm not the only one,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That's him,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's like you,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Different powers, but yes,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You felt it too,\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network stirring,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki Queen,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Your bloodline?\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Someone whose existence challenges cosmic law, apparently,\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And you?\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"My daughter has learned to speak in languages that predate human civilization,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The third,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"This place,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For building something that doesn't exist yet but needs to,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But foundation for what, exactly?\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Foundation for the only thing that can stand against what's coming,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Guild forms,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Can you control it?\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Inheritance again,\"",
        "line": 265
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which was?\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Coordination,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not just inheriting the Spire,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's responding to us,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not control,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"So what do we do with it?\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"We find the others,\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"But how do we find them?\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The network finds them,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we have our purpose,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A guild,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Speaking of which,\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's consolidating,\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Not long,\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's already beginning,\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not going to be left alone to build this,\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There's one more thing,\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"But that's a complex operation that will require more resources than we currently have,\"",
        "line": 371
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"How long can he endure what they're doing to him?\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know,\"",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we begin now,\"",
        "line": 385
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Northern England,\"",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"How are you planning to travel there?\"",
        "line": 407
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Portal generation,\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"But what about the Spires that are under hostile control?\"",
        "line": 424
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But there are risks,\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's a hell of a gamble,\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"We're already exposed,\"",
        "line": 441
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we might as well use it to our advantage,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 287,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll go,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Echo Temple,\"",
        "line": 458
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Ironspire,\"",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"That's not good,\"",
        "line": 479
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"If they succeed in controlling one of the Spires,\"",
        "line": 485
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't let them succeed,\"",
        "line": 491
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Diplomatically?\"",
        "line": 497
      }
    },
    {
      "type": "dialogue",
      "timestamp": 317,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"It has to be,\"",
        "line": 499
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"You're not going alone,\"",
        "line": 504
      }
    },
    {
      "type": "dialogue",
      "timestamp": 325,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Veylan Solon,\"",
        "line": 512
      }
    },
    {
      "type": "dialogue",
      "timestamp": 329,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"But how do we make contact with him?\"",
        "line": 518
      }
    },
    {
      "type": "dialogue",
      "timestamp": 330,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The network calls to those who carry the right intentions,\"",
        "line": 520
      }
    },
    {
      "type": "dialogue",
      "timestamp": 333,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He'll meet us at the convergence point,\"",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"And if the negotiations fail?\"",
        "line": 531
      }
    },
    {
      "type": "dialogue",
      "timestamp": 340,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Then we find out whether the Guild is strong enough to handle open conflict with conventional forces that have learned to weaponize cosmic technology,\"",
        "line": 536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 344,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Impressive,\"",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Magical guild?\"",
        "line": 548
      }
    },
    {
      "type": "dialogue",
      "timestamp": 351,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So the immediate tactical objective is to prevent Ironspire from completing their control interface,\"",
        "line": 555
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's it exactly,\"",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ironspire is going to be challenging,\"",
        "line": 565
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Then how do we approach them?\"",
        "line": 571
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "Veylan",
      "action": "speak",
      "data": {
        "text": "\"We offer them something they want more than control of a Needle Spire,\"",
        "line": 573
      }
    },
    {
      "type": "dialogue",
      "timestamp": 365,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's our leverage,\"",
        "line": 578
      }
    },
    {
      "type": "dialogue",
      "timestamp": 369,
      "actor": "Veylan",
      "action": "speak",
      "data": {
        "text": "\"Then we make it clear that attempting to control cosmic-level technology without proper understanding is far more dangerous than they realize,\"",
        "line": 584
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Safeguards that could destroy the city if they trigger the wrong defensive response,\"",
        "line": 589
      }
    },
    {
      "type": "dialogue",
      "timestamp": 376,
      "actor": "Veylan",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 595
      }
    },
    {
      "type": "dialogue",
      "timestamp": 379,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 600
      }
    },
    {
      "type": "dialogue",
      "timestamp": 383,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"And if the Ironspire negotiations go badly?\"",
        "line": 606
      }
    },
    {
      "type": "dialogue",
      "timestamp": 384,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Then we find out how quickly the Guild can mobilize for a conflict that none of us are really prepared for,\"",
        "line": 608
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Look at this,\"",
        "line": 615
      }
    },
    {
      "type": "dialogue",
      "timestamp": 391,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seraphina Stormwind,\"",
        "line": 620
      }
    },
    {
      "type": "dialogue",
      "timestamp": 395,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And here,\"",
        "line": 626
      }
    },
    {
      "type": "dialogue",
      "timestamp": 397,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Morgana Steele,\"",
        "line": 629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 401,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network is highlighting specific types of expertise,\"",
        "line": 635
      }
    },
    {
      "type": "dialogue",
      "timestamp": 407,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Queen's allies,\"",
        "line": 644
      }
    },
    {
      "type": "dialogue",
      "timestamp": 411,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not the only ones building guilds,\"",
        "line": 650
      }
    },
    {
      "type": "dialogue",
      "timestamp": 415,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which means they either have access to ancient knowledge they shouldn't possess,\"",
        "line": 656
      }
    },
    {
      "type": "dialogue",
      "timestamp": 419,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we need to move faster,\"",
        "line": 662
      }
    },
    {
      "type": "dialogue",
      "timestamp": 423,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which means the pool of potential recruits is expanding rapidly,\"",
        "line": 668
      }
    },
    {
      "type": "dialogue",
      "timestamp": 427,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Building the Guild isn't just about finding people with magical abilities,\"",
        "line": 674
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A community that can also serve as humanity's voice in cosmic affairs,\"",
        "line": 680
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's possible,\"",
        "line": 683
      }
    },
    {
      "type": "dialogue",
      "timestamp": 440,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Distance learning,\"",
        "line": 694
      }
    },
    {
      "type": "dialogue",
      "timestamp": 444,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But only for those who have some form of network access,\"",
        "line": 700
      }
    },
    {
      "type": "dialogue",
      "timestamp": 448,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we establish regional training centers,\"",
        "line": 706
      }
    },
    {
      "type": "dialogue",
      "timestamp": 452,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We begin tomorrow,\"",
        "line": 712
      }
    },
    {
      "type": "dialogue",
      "timestamp": 456,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Portal generation that mimics spatial folding technology,\"",
        "line": 718
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"And if we encounter situations that require immediate Guild response?\"",
        "line": 724
      }
    },
    {
      "type": "dialogue",
      "timestamp": 461,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Network recall,\"",
        "line": 726
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Portals stable,\"",
        "line": 732
      }
    },
    {
      "type": "dialogue",
      "timestamp": 467,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"More than enough time,\"",
        "line": 735
      }
    },
    {
      "type": "dialogue",
      "timestamp": 471,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Guild expands,\"",
        "line": 741
      }
    },
    {
      "type": "dialogue",
      "timestamp": 473,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Guild expands,\"",
        "line": 744
      }
    }
  ],
