{
  "scene_id": "act_01ch_41_convergence_at_ironspire",
  "description": "Ironspire rose before them like a dagger thrust into the heart of the world.",
  "entities": [
    {
      "id": "mr_gpt",
      "name": "Mr. GPT",
      "health": 100.0,
