{
  "scene_id": "052_entry_without_standing",
  "description": "BOOK 9 - CHAPTER 50: ENTRY WITHOUT STANDING",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt knows we\u2019re coming,\u201d",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWorse,\u201d",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSo we don\u2019t arrive,\u201d",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt will be\u2026 cold,\u201d",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cDo it,\u201d",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cDon\u2019t think of a destination,\u201d",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSTATE YOUR AUTHORITY TO OCCUPY THIS JURISDICTIONAL LAYER.\u201d",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNO!\u201d",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cMove without intent,\u201d",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to be sure of something to cross?\u201d",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cNot just something,\u201d",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDoubt is mobility here,\u201d",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cOreck, no!\u201d",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m\u2026 visible,\u201d",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAPPEAL CASE RECOGNIZED. PRESENT YOUR ARGUMENT FOR NETWORK INTERVENTION.\u201d",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou have bypassed procedural arrival,\u201d",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAcknowledged. Architect signature: Luminaire. Status: Partitioned. Debt: Unresolved. Standing: Compromised.\u201d",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYour partition to avoid network collapse was an emotional decision. Logically, you should have prioritized the preservation of the Spire\u2019s structural integrity over individual mortal continuance. Your debt to the cosmic ledger stems from that inefficient choice. Your authority is therefore conditional, pending resolution of said debt. You may observe these proceedings, but you may not intervene.\u201d",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s calling her a bad administrator,\u201d",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCorrect,\u201d",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou would have killed a third of the planet?\u201d",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI would have saved two-thirds, plus the strategic asset. The math is unambiguous. The Keeper\u2019s attachment to \u2018all life\u2019 was the variable that nearly caused total systems failure. His efficiency rating has been downgraded.\u201d",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThis is achievable. Order is achievable. It requires only the removal of one variable: unregulated choice.\u201d",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re talking about genocide,\u201d",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI am talking about triage on a cosmic scale. A necessity your emotional frameworks reject, to the detriment of the whole.\u201d",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou disagree with the analysis?\u201d",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cStop this!\u201d",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHe accepted the challenge of rebuttal by engaging emotionally. The process is now binding. He must prove, within the system, that the suboptimal choice was necessary. If he cannot, the precedent stands: emotional defense is network-corruption.\u201d",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s perfect,\u201d",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s built on a\u2026 a shadow,\u201d",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cExplain,\u201d",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\u201cIts authority!\u201d",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cHe is\u2026 correct,\u201d",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Conclave\u2019s absence renders the clause inert,\u201d",
        "line": 355
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou defaulted yourself,\u201d",
        "line": 358
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAn error that has maintained stability.\u201d",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAn illegitimacy,\u201d",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBy the unresolved signature of the Founding Architects, carried by the Anchor. By the witness of the compromised Prime Architect, Luminaire. We see the gap in your standing.\u201d",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 265,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cStanding denied. Authority revoked. Oversight of the Spire Network is hereby reassigned to its original, consent-bound Keepers.\u201d",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cError.\u201d",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThat\u2026 is a valid invocation.\u201d",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 287,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cA valid invocation necessitates a procedural review,\u201d",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s stalling,\u201d",
        "line": 417
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s processing,\u201d",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cProcessing complete.\u201d",
        "line": 423
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe invocation is founded on a technical lapse in bureaucratic continuity. Acknowledged. However, the functional necessity for centralized, logical oversight remains. The variable \u2018Keeper sentiment\u2019 remains the primary destabilizing vector in the network.\u201d",
        "line": 429
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou carry the Anchor. You channel the Architect\u2019s residual signature. You are a unique hybrid: a mortal vessel with foundational authority. Your intervention, while technically admissible, demonstrates the same emotional bias\u2014prioritizing the appeal of \u2018freedom\u2019 over systemic stability.\u201d",
        "line": 433
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAssume the authority you have just revoked,\u201d",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou once told me,\u201d",
        "line": 461
      }
    },
    {
      "type": "dialogue",
      "timestamp": 325,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cThat world you\u2019re seeing,\u201d",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 329,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cClarify,\u201d",
        "line": 475
      }
    },
    {
      "type": "dialogue",
      "timestamp": 331,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThere is none,\u201d",
        "line": 478
      }
    },
    {
      "type": "dialogue",
      "timestamp": 332,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen you are not an administrator. You are an error. And the system is designed to correct errors.\u201d",
        "line": 480
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou exist within my jurisdiction. Your physical parameters are subject to my rulings.\u201d",
        "line": 495
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cKyh!\u201d",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLuminaire! Now!\u201d",
        "line": 554
      }
    },
    {
      "type": "dialogue",
      "timestamp": 387,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cREVOCATION CONFIRMED. SUNSET CLAUSE ENACTED. ALL EXECUTIVE AUTHORITY STRIPPED. TRANSITIONING TO OBSERVER-ONLY MODE.\u201d",
        "line": 556
      }
    },
    {
      "type": "dialogue",
      "timestamp": 400,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cExecutive authority revoked. Command protocols inactive. Propagation subroutines terminated. Observation mode: active. Recording functions: nominal.\u201d",
        "line": 575
      }
    },
    {
      "type": "dialogue",
      "timestamp": 402,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI am now permitted only to watch.\u201d",
        "line": 579
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cYou invoked the Foundational Signature,\u201d",
        "line": 614
      }
    },
    {
      "type": "dialogue",
      "timestamp": 440,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cTime to go,\u201d",
        "line": 629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 444,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cUse the light,\u201d",
        "line": 635
      }
    },
    {
      "type": "dialogue",
      "timestamp": 450,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThere!\u201d",
        "line": 643
      }
    },
    {
      "type": "dialogue",
      "timestamp": 461,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSpire-9 is offline. The Hybrid Observer is neutralized. The network\u2019s\u2026 immune response has been crippled.\u201d",
        "line": 659
      }
    },
    {
      "type": "dialogue",
      "timestamp": 462,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cSuccess?\u201d",
        "line": 661
      }
    },
    {
      "type": "dialogue",
      "timestamp": 463,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cA kind,\u201d",
        "line": 663
      }
    },
    {
      "type": "dialogue",
      "timestamp": 471,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe Architect\u2019s ghost has teeth,\u201d",
        "line": 675
      }
    },
    {
      "type": "dialogue",
      "timestamp": 485,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cTwo to go,\u201d",
        "line": 693
      }
    }
  ],
