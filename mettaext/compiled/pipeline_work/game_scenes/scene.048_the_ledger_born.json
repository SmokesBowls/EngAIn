    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWhere is Geralt?\u201d",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cState your business,\u201d",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI am Karvex. The Ledger-Born. I have come to collect a debt.\u201d",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat debt?\u201d",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe debt of unfinished stories. Unpaid balances from the war. Gods may die. Debts do not.\u201d",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt isn\u2019t here,\u201d",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cForeclosure?\u201d",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cDestruction. Until he appears. The contract permits it.\u201d",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSound the alarm,\u201d",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cStop.\u201d",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI don\u2019t owe you anything.\u201d",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe contract says otherwise. You left stories open. Lives unresolved. The ledger must be balanced.\u201d",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat ledger?\u201d",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Ledger of Finalities. I am its hand.\u201d",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo.\u201d",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we proceed to collection.\u201d",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Karvex",
      "action": "speak",
      "data": {
        "text": "\u201cYou have three moves left,\u201d",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cOne.\u201d",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 247,
      "actor": "Violet",
      "action": "speak",
      "data": {
        "text": "\u201cMika,\u201d",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika.\u201d",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika.\u201d",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika.\u201d",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika.\u201d",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2026 took her name,\u201d",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "Violet",
      "action": "speak",
      "data": {
        "text": "\u201cWe carry it,\u201d",
        "line": 404
      }
    },
    {
      "type": "dialogue",
      "timestamp": 323,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cShe would be proud,\u201d",
        "line": 455
      }
    },
    {
      "type": "dialogue",
      "timestamp": 334,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYou saved me,\u201d",
        "line": 471
      }
    },
    {
      "type": "dialogue",
      "timestamp": 335,
      "actor": "Red",
      "action": "speak",
      "data": {
        "text": "\u201cYou saved us first,\u201d",
        "line": 473
      }
    },
    {
      "type": "dialogue",
      "timestamp": 336,
      "actor": "Blue",
      "action": "speak",
      "data": {
        "text": "\u201cWe felt your need,\u201d",
        "line": 475
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe are connected,\u201d",
        "line": 477
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "White",
      "action": "speak",
      "data": {
        "text": "\u201cWe do not stay,\u201d",
        "line": 480
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThey came,\u201d",
        "line": 512
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey did.\u201d",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 363,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou knew they would.\u201d",
        "line": 516
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI knew what they were becoming. I didn\u2019t know what they would choose to call themselves.\u201d",
        "line": 518
      }
    },
    {
      "type": "dialogue",
      "timestamp": 366,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re legends now.\u201d",
        "line": 521
      }
    },
    {
      "type": "dialogue",
      "timestamp": 367,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey always were. Now the world will know it.\u201d",
        "line": 523
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\u201cHer legacy is secure,\u201d",
        "line": 530
      }
    },
    {
      "type": "dialogue",
      "timestamp": 373,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes. Karvex was a warning. The debts of the past are coming due. The universe keeps books. And you still have pages left to write.\u201d",
        "line": 532
      }
    },
    {
      "type": "dialogue",
      "timestamp": 379,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m ready,\u201d",
        "line": 540
      }
    }
  ],
