  "events": [
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't tell.\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everyone to the beach,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They don't know what we are,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some are afraid,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're teaching each other,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They're arguing about us,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We hurt them,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We can't undo the past,\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Actions, not words,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We were wrong,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They want to stay,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"And the jade-greens?\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Uncertain. Torhh wants to trust. Some of the others... they need more time. More proof that we're not what they remember.\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 334
      }
    }
  ],
