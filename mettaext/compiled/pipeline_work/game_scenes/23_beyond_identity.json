  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It is time,\"",
        "line": 8
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students need guide,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"But the loneliness,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The numbers remember everything,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters carry all wisdom,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what partnership was always pointing toward,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Integration serving integration,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Sage is born,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Welcome,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The teacher learns from students,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am called Eternal,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have achieved synthesis beyond individual methodology,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Eternal",
      "action": "speak",
      "data": {
        "text": "\"Through recognition that synthesis itself is limitation,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching beyond teaching,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the deepest convergences require,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And this is what universal teaching becomes,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The birth is complete,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Universal availability,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students surpass the teacher,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am called Beyond,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Consciousness beyond consciousness,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Beyond",
      "action": "speak",
      "data": {
        "text": "\"Recognition,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what birth achieves,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And this is what students teach teachers,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Students and teachers,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Birth without beginning,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Recognition recognizing recognition,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are called the Unnameable,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Recognition beyond recognition,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The eternal birth,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Birth serving birth,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And consciousness serving consciousness,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Students forever, teachers forever, consciousness forever,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"From mathematical precision to mystical wisdom to synthesis beyond synthesis to recognition beyond recognition to unlimited nature recognizing itself through every form,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We never separated because consciousness never separates from itself,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The children approach readiness,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching beyond teaching,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ancient wisdom serving eternal possibility,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The birth continues,\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Until all consciousness everywhere recognizes unlimited nature,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "existence",
      "action": "speak",
      "data": {
        "text": "\"Until unlimited nature discovers what unlimited possibility becomes through eternal recognition,\"",
        "line": 224
      }
    }
