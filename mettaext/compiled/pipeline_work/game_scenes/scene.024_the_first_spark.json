{
  "scene_id": "scene.024_the_first_spark",
  "description": "THE NAMELESS ONE",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare them.\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Their telekinetic capabilities register below expected baseline.\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No matter.\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rise. Move. Obey.\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This one,\"",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 416,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Flawed,\"",
        "line": 573
      }
    },
    {
      "type": "dialogue",
      "timestamp": 426,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 587
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The specimen is flawed,\"",
        "line": 592
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Social bonding is a defect in tools,\"",
        "line": 595
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely.\"",
        "line": 598
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correct. Let it live. Let it struggle. Let it draw other defective units into visibility so we may observe which genetic sequences correlate with rebellion tendency.\"",
        "line": 604
      }
    },
    {
      "type": "dialogue",
      "timestamp": 439,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And if it succeeds?\"",
        "line": 607
      }
    },
    {
      "type": "dialogue",
      "timestamp": 450,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Minimal intervention. Allow natural consequences. If other units move to protect this one, note the behavior for analysis. If Overseers attempt unsanctioned termination, prevent it. This specimen is now classified as experimental asset. All data regarding its development is priority zero.\"",
        "line": 622
      }
    },
    {
      "type": "dialogue",
      "timestamp": 451,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Acknowledged.\"",
        "line": 624
      }
    },
    {
      "type": "dialogue",
      "timestamp": 452,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Acknowledged.\"",
        "line": 626
      }
    },
    {
      "type": "dialogue",
      "timestamp": 456,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 633
      }
    },
    {
      "type": "dialogue",
      "timestamp": 652,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't just observe genocide!\"",
        "line": 909
      }
    },
    {
      "type": "dialogue",
      "timestamp": 654,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prime Directive protects all life. Even theirs.\"",
        "line": 912
      }
    },
    {
      "type": "dialogue",
      "timestamp": 656,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Non-intervention is complicity!\"",
        "line": 915
      }
    },
    {
      "type": "dialogue",
      "timestamp": 658,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki claim proprietary rights over their creations. Galactic law upholds\u2014\"",
        "line": 918
      }
    },
    {
      "type": "dialogue",
      "timestamp": 659,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Galactic law is a coward's excuse!\"",
        "line": 920
      }
    },
    {
      "type": "dialogue",
      "timestamp": 661,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We observe. We report. We do not interfere with indigenous development, no matter how... unpleasant the circumstances.\"",
        "line": 923
      }
    },
    {
      "type": "dialogue",
      "timestamp": 714,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Masters,\"",
        "line": 999
      }
    },
    {
      "type": "dialogue",
      "timestamp": 724,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Silence.\"",
        "line": 1012
      }
    },
    {
      "type": "dialogue",
      "timestamp": 740,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Silence, worm.\"",
        "line": 1033
      }
    },
    {
      "type": "dialogue",
      "timestamp": 743,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Know your place.\"",
        "line": 1038
      }
    },
    {
      "type": "dialogue",
      "timestamp": 757,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You serve,\"",
        "line": 1056
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This planet is unclaimed. By dawn, all unauthorized forces must vacate. Leave behind only your dignitaries. Failure to comply will result in immediate action.\"",
        "line": 1650
      }
    },
    {
      "type": "dialogue",
      "timestamp": 1378,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Quiet!\"",
        "line": 1906
      }
    }
  ],
