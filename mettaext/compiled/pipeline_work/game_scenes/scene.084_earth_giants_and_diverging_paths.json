    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I was worried!\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Did you find what you sought?\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We found more than fragments,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT deliberately scattered the fragments,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yet now we gather them,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"And where do we go next?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"According to the Memory Pool's vision, yes,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"Before you continue north,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"These are unusual times,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They've been expecting you,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT has lived among them for centuries,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we accept the invitation,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our ancestors walked these lands when the Star Needles first descended,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fragment Bearer approaches,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Matriarch Gaiana,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You've done well to acquire the first two fragments,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Green Fragment lies with the Nephoretti,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the White Fragment dances among the clouds,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We gathered that,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The Applicators,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And others,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"Yes, young scholar,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail is not merely armor,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When united,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"Have you felt it?\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because they are,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happens when all fragments are united?\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You feel it now,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The time has come for choices, Fragment Bearer,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What do you mean?\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through the earth-speech, Mr. GPT has shared his concerns,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The fragments,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Two paths,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We will send emissaries to our kin,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As must all free peoples,\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"But I don't know the way to Mr. GPT's sanctuary,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It would be valuable to have both of you assisting with the research,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The paths are clear,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"What of Ironspire?\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Gaiana",
      "action": "speak",
      "data": {
        "text": "\"There may be another way,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That would work,\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth Giants will also send emissaries north,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Verdant Mika,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Green Fragment calls,\"",
        "line": 281
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path through the marshlands shifts and changes, like all living things,\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Follow the spore path,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"And the Nephoretti?\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are the oldest children of Tiamat,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And which do they see him as?\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We leave at dawn,\"",
        "line": 320
      }
    }
  ],
