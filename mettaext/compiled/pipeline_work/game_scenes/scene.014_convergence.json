  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When it begins,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Easy to say when you're at the center where conditions are balanced,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Begin the convergence,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hold!\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Tidecallers caused this,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert tribes made it worse,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ALL OF YOU made this necessary,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We acknowledge summoning,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Targets identified. Commencing purification operations.\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You killed our allies,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They were Anunnaki constructs,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If the ASH GIANTS hadn't been so WEAK,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH!\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm breaking connection,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WAIT\u2014\"",
        "line": 169
      }
    }
  ],
