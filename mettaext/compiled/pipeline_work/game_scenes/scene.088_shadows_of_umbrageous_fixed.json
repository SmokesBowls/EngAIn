  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Where are we?\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your homeland,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I feel it,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We should find shelter,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What is it?\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Temporal patterns,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not alone,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This way,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt, travelers,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We seek passage,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not what. Who.\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My name is Vi\u00ean,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not me,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Umbral Stalkers,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Entropy markers,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now we may speak freely,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Thank you for your help,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Purpose is known | Blood is recognized | Void calls to void.\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All who remember the Culling know of the spires,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't understand,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to find the dormant Void Spire,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The spire sleeps beneath the City of Echoes,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And how do we awaken this Observer?\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Resonance | Sacrifice | Recognition.\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've done something like this before,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The light shifts?\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Permanent, yes. Unchanging, no.\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Do you trust this... person?\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I saw...\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possibilities of what?\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sustenance,\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When we reach the City of Echoes,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solantri know,\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Lentharis? The Observer?\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lost between words. Between realities.\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To awaken Lentharis, you must synchronize your dual natures,\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Lentharis will demand truth | memory | sacrifice.\"",
        "line": 294
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Of course I've noticed,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know what I'm looking for,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Searching for what?\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know.\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cProgress?\u201d",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBegin sync sequence,\u201d",
        "line": 356
      }
    }
  ],
