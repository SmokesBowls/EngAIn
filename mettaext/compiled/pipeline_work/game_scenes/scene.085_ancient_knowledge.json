{
  "scene_id": "scene.085_ancient_knowledge",
  "description": "book 16",
  "entities": [
    {
      "id": "isla",
      "name": "Isla",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
