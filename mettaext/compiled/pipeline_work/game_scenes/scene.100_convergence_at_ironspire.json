  ],
  "events": [
    {
      "type": "thought",
      "timestamp": 3,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 of Enkialu, Year 6,999\"",
        "line": 6
      }
    },
    {
      "type": "thought",
      "timestamp": 4,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of the Approaching Storm\"",
        "line": 7
      }
    },
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Circle of Progress has been busy,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Lord Stormhelm won't welcome us,\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're with us,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're here,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence calls to all who bear the old bloodlines,\"",
        "line": 44
      }
    },
    {
      "type": "thought",
      "timestamp": 32,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - Unexpected Reunions\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The city fractures,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The corruption was controlling them?\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Directing them,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You made it,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As did you,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Not just the fragments,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are whole,\"",
        "line": 76
      }
    },
    {
      "type": "thought",
      "timestamp": 53,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Gathering Storm\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enough reunions,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The city tears itself apart because you built it on lies,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which we've been systematically removing,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your research created half of them!\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH!\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Nephilim ritual,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As real as the Fifth Coming that approaches,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you think an ancient ritual will heal millennia of division?\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"We think,\"",
        "line": 120
      }
    },
    {
      "type": "thought",
      "timestamp": 82,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - Unexpected Opposition\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did you think we wouldn't notice such a gathering?\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not artifacts,\"",
        "line": 144
      }
    },
    {
      "type": "thought",
      "timestamp": 105,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Working Begins\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"We need to start the ritual now,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The focus,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Grand Spire,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption beneath the city,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can. But the release must be controlled. Channeled upward through the Spire's core.\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it,\"",
        "line": 180
      }
    },
    {
      "type": "thought",
      "timestamp": 123,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Grand Working\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 204
      }
    },
    {
      "type": "thought",
      "timestamp": 147,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Healing Spiral\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sundering ends,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The healing begins,\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By choice, not force,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In wisdom of earth and sky united,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Written in stone, but not unchangeable,\"",
        "line": 254
      }
    },
    {
      "type": "thought",
      "timestamp": 177,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 49 of Enkialu - Dawn of New Alliances\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's beginning,\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Just in time,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"But we're ready now,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're linked now,\"",
        "line": 279
      }
    }
  ],
