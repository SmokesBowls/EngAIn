  ],
  "events": [
    {
      "type": "thought",
      "timestamp": 1,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 of Enkialu, Year 6,999\"",
        "line": 3
      }
    },
    {
      "type": "thought",
      "timestamp": 2,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of the Approaching Storm\"",
        "line": 4
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Circle of Progress has been busy,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Lord Stormhelm won't welcome us,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're with us,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're here,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence calls to all who bear the old bloodlines,\"",
        "line": 41
      }
    },
    {
      "type": "thought",
      "timestamp": 30,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - Unexpected Reunions\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The city fractures,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The corruption was controlling them?\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Directing them,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You made it,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As did you,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Not just the fragments,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are whole,\"",
        "line": 73
      }
    },
    {
      "type": "thought",
      "timestamp": 51,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Gathering Storm\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enough reunions,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The city tears itself apart because you built it on lies,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which we've been systematically removing,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your research created half of them!\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH!\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Nephilim ritual,\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As real as the Fifth Coming that approaches,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you think an ancient ritual will heal millennia of division?\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"We think,\"",
        "line": 117
      }
    },
    {
      "type": "thought",
      "timestamp": 80,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - Unexpected Opposition\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did you think we wouldn't notice such a gathering?\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not artifacts,\"",
        "line": 141
      }
    },
    {
      "type": "thought",
      "timestamp": 103,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Working Begins\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"We need to start the ritual now,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The focus,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Grand Spire,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption beneath the city,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can. But the release must be controlled. Channeled upward through the Spire's core.\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it,\"",
        "line": 177
      }
    },
    {
      "type": "thought",
      "timestamp": 121,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Grand Working\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 201
      }
    },
    {
      "type": "thought",
      "timestamp": 145,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 48 - The Healing Spiral\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sundering ends,\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The healing begins,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By choice, not force,\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In wisdom of earth and sky united,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Written in stone, but not unchangeable,\"",
        "line": 251
      }
    },
    {
      "type": "thought",
      "timestamp": 175,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 49 of Enkialu - Dawn of New Alliances\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's beginning,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Just in time,\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"But we're ready now,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're linked now,\"",
        "line": 276
      }
    }
  ],
