  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Asteroid Field,\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Where... are we?\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome, travelers from the stellar pathway,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who speaks?\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am what remains when unity chooses fragmentation over destruction,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You seek the Observer,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's a test,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every fragment remembers the whole,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Sirian-Arcturian Accord,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Adaptation. Balance. Unity of purpose despite different natures,\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Observer you seek dwells here,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not just dormant,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Claude",
      "action": "speak",
      "data": {
        "text": "\"From responsibility,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who disturbs the peace of abdication?\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rescue,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"GPT,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Spire will be reactivated,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Moon Kingdom technology,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It will survive the Sun's embrace?\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It was built for that purpose,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I remember what it was to be whole,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remember what you have learned here,\"",
        "line": 211
      }
    }
  ],
