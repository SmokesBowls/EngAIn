{
  "scene_id": "act_01ch_35_chains_of_light",
  "description": "Chapter 28: Chains of Light",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 4,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Something's not right,\"",
        "line": 8
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome, travelers.\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've been expecting you,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"About the corruption spreading through the network?\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remarkable, isn't it?\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Queen sees far. Plans long.\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We surrender,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean!\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Trust me,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Excellent choice,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption you're spreading,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Destroy?\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your friends on Earth,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are divided. Scattered. Fighting corruptions they don't understand with tools they can barely use.\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Separate cells,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's okay,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Comfortable?\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What does she want?\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What she's always wanted. What was stolen from her eons ago.\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every fragment you've collected, every piece of your scattered soul you've recovered\u2014all of it has been drawing you here. The Queen didn't need to hunt you. She just needed to wait for you to complete yourself. Much more efficient.\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Same. These fields\u2014they're learning. Every time I test them, they adapt.\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We need to be smart about this,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So what do we do?\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Overseer Marithel,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Study?\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Observe. Document. Understand.\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not experiments,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is an experiment to those who seek understanding.\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "Marithel",
      "action": "speak",
      "data": {
        "text": "\"You already are,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "Marithel",
      "action": "speak",
      "data": {
        "text": "\"The network corruption,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's killing worlds,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's elevating them. Those that survive will be stronger. Those that don't...\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What\u2014\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Security breach in sections 7 through 12,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Something disrupted them. Something the Anunnaki didn't expect.\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Shadow-walking,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rongtai!\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No time,\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What about Vi\u00ean?\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Go,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, no!\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Listen to me,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't leave you!\"",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have to.\"",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll come back for you,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She'll warn Earth,\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are unaffected.\"",
        "line": 278
      }
    }
  ],
