    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's nervous,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or what truths might be revealed about it,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Easy,\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're being watched,\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Titanborn know we're coming,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're testing our resolve,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Threshold,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"It senses the White Fragment,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or something else calls to it,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Tran, bearer of the Dragon Mail,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I understand that the fragments must be united,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do you?\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I know that Zaron bound himself to create the armor,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Knowing and understanding are not the same,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mirrors show possibility,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are futures where we fail to unite properly,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I see it,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fear is natural,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The difference,\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We chose unity,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am what you could become,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You're what happens if I let the armor consume me,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You cannot defeat me,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's the test,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Trust me,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm accepting truth,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose,\"",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I choose us,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Truth cannot be grasped by illusion,\"",
        "line": 232
      }
    },
    {
      "type": "thought",
      "timestamp": 169,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Thank you,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Interesting,\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Is that not the point of truth?\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happens now?\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "Kronocht",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"You're coming with us?\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The last fragment will not be found through strength or wisdom alone,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Keeper of Crossroads,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"How does it feel?\"",
        "line": 294
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Become who you were meant to be,\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tell me,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Only that it represents unity and transcendence,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unity, yes,\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Whatever comes,\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Soon,\"",
        "line": 343
      }
    }
  ],
