      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of Converging Paths\"",
        "line": 4
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is the place,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mikas spoke of this,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unity through convergence,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We should\u2014\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fragment Bearer arrives,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We seek the final fragment,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seek?\"",
        "line": 38
      }
    },
    {
      "type": "thought",
      "timestamp": 30,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Path of Infinite Selves\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every choice creates a branch,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is worse than the Mirror trial,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"How do I choose?\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By understanding what each choice means,\"",
        "line": 72
      }
    },
    {
      "type": "thought",
      "timestamp": 51,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Five Convergences\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Each path has merit,\"",
        "line": 94
      }
    },
    {
      "type": "thought",
      "timestamp": 68,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Rejected Paths\"",
        "line": 101
      }
    },
    {
      "type": "thought",
      "timestamp": 84,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Choice of Unity\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The safe choice or the bold one,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We've come this far by taking risks,\"",
        "line": 140
      }
    },
    {
      "type": "thought",
      "timestamp": 101,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Violet Awakening\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To claim this fragment,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am...\"",
        "line": 172
      }
    },
    {
      "type": "thought",
      "timestamp": 121,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - Return to the World\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Tran?\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"It's us,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're intact,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"What happens now?\"",
        "line": 199
      }
    }
