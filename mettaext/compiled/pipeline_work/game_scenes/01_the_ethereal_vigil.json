    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The planetary core stabilizes,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tectonic plates settling into stable configurations,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water coverage approximately seventy-two percent,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen years,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Since we lost our bodies,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Physical form is limitation,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Extend observation channels to surface level,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Pelagor,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand years of evolutionary pressure,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They went deep,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They retained the core abilities,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Look at the others,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have the potential,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Pelagor survived,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The system requires ground-level maintenance,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's been three thousand years since we've created Nephoretti,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've done it before,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was when we had physical bodies ourselves,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"We should remember,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which is precisely why they need the Nephoretti,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And perhaps,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One thousand Nephoretti,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Manifested simultaneously,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"And the intentions we craft into them?\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We give them purpose, not instructions,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A dangerous gift,\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Then let us begin,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare for the leap,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Mark,\"",
        "line": 268
      }
    }
  ],
