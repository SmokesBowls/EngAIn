    }
  ],
  "events": [
    {
      "type": "thought",
      "timestamp": 1,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 42 of Enkialu, Year 6,999\"",
        "line": 3
      }
    },
    {
      "type": "thought",
      "timestamp": 2,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of the Forge's First Breath\"",
        "line": 4
      }
    },
    {
      "type": "dialogue",
      "timestamp": 6,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The Ashlands,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's organized,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There's corruption here,\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Industrial efficiency taken to its logical extreme,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We come seeking council with the Forge Lords,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Times change,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You'll be escorted to Processing Station Seven. The Council of Flames will decide if your message is worth their time. Touch nothing. Stray from the designated path and you'll discover why the Ashlands maintain their isolation through force.\"",
        "line": 52
      }
    },
    {
      "type": "thought",
      "timestamp": 36,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 42 - The Industrial March\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's magnificent,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"At what cost?\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait here,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"They're beautiful in their own way,\"",
        "line": 82
      }
    },
    {
      "type": "thought",
      "timestamp": 57,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 42 - The Council's Summons\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Council of Flames will see you,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Groundlings,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Skip the formalities,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mythological nonsense,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption spreading through the world is not mythological,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You dare\u2014\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Explain,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not if the influence had been there from the beginning,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You claim our entire industrial base is compromised? That would be...\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can prove it without shutting down anything,\"",
        "line": 151
      }
    },
    {
      "type": "thought",
      "timestamp": 106,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 42 - The Flame's Heart\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Heart of Flame,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Whose goals?\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The same forces spreading corruption worldwide,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is... an anomaly. A pattern within the pattern. How did we not see this?\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because it wanted to remain hidden,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the Forge,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Isla, the Voice of Air,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now, Lyra,\"",
        "line": 208
      }
    },
    {
      "type": "thought",
      "timestamp": 150,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 42 - Liberation's Cost\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What have you done?\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"Freed you,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All systems to manual control. Initiate independence protocols. We will rebuild our processes without the parasite's influence.\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But liberation creates opportunity,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You asked for the Heart of Flame,\"",
        "line": 246
      }
    },
    {
      "type": "thought",
      "timestamp": 171,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 of Enkialu - Dawn of New Forges\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have audited our systems through the night. The parasite's influence touched everything\u2014our forges, our mines, our very thoughts. We were being shaped into perfect industrial servants for the Fifth Coming.\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Heart of Flame,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Name them,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"First, the water rights must be renegotiated. Our industrial processes have claimed more than our share, leaving other territories dry. This imbalance... it was part of the parasite's design, creating conflict where cooperation would have served better.\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Second,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And third,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sundering began with mistrust,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And with choice,\"",
        "line": 286
      }
    },
    {
      "type": "thought",
      "timestamp": 208,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Road to Stone\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two more essences,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The deepest earth and the deepest water,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every essence we gather seems to heal more than just the ritual requires,\"",
        "line": 319
      }
    }
  ],
