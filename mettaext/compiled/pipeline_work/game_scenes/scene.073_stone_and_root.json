{
  "scene_id": "scene.073_stone_and_root",
  "description": "book 14",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome to the Foundation Chamber, young bridge-builder,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I can feel it,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is alive, child of two worlds,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Show me how to listen,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The lesson begins with stillness,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your human perception moves too quickly,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to perceive,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Planetary Network,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every grain of soil carries memory,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Consciousness?\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has been waiting,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your first test,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stop,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Then what do I do?\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ask the network what it needs,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"I can feel what it wants to do,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some trees,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Partnership,\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to comprehend,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beautiful,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what earth magic truly is,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And more than that,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can feel everything,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By remembering that you are the bridge, not the destination,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Young bridge-builder,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Honor is earned through service,\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The focusing crystal,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How do you feel?\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Connected,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Responsibility is the price of power,\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together, you will be formidable,\"",
        "line": 236
      }
    }
  ],
