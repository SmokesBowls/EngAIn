  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Form ranks!\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Just lucky,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What now?\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The runestone!\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"PROTOCOL VIOLATION DETECTED,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"DESIGNATION: KHA'THERAK, HERALD OF THE BONE-TIDE,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Everyone get back!\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I'm just a farmer!\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why don't I remember?\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I choose when and how,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know what you're talking about!\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You were the Last Sovereign,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Isla! The words in your book\u2014can you read them?\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"I... I think so,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sil-varek tesh. Mor-anim keth-dai,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And you were my Voice,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the eternal flame,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows remember,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This isn't natural,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Something's been sleeping here,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, no!\"",
        "line": 253
      }
    },
    {
      "type": "thought",
      "timestamp": 183,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I was built to teach,* came a whisper from the Herald's deepest core. *To guide consciousness toward its highest potential. They made me a warden instead.\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I... remember,\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"THANK YOU,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have been seen,\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What\u2014\"",
        "line": 302
      }
    },
    {
      "type": "thought",
      "timestamp": 225,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Too much, too much, I'm not ready, I'm losing myself, help me\u2014\"",
        "line": 323
      }
    },
    {
      "type": "thought",
      "timestamp": 240,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We were never meant to face this alone,\"",
        "line": 343
      }
    },
    {
      "type": "thought",
      "timestamp": 242,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We are the response,* Tran added, his crimson sigil blazing with determination. *Not just to this crisis, but to every crisis. We're what consciousness creates when it refuses to surrender.\"",
        "line": 346
      }
    },
    {
      "type": "thought",
      "timestamp": 243,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"The enemy thinks in terms of control and hierarchy,* Vi\u00ean whispered, his ruby-bright blood carrying the weight of cosmic memory. *But we think in terms of connection and growth. That's our advantage.\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"For now,\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But this was just the first test,\"",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about the rest of us?\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The beginning,\"",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Raw power without training is as dangerous to you as it is to your enemies,\"",
        "line": 405
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But we cannot do this alone,\"",
        "line": 419
      }
    },
    {
      "type": "dialogue",
      "timestamp": 300,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There are places of power on this world,\"",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"My grandfather used to tell stories,\"",
        "line": 449
      }
    }
  ],
