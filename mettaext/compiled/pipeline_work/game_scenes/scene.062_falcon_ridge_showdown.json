  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Form ranks!\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Just lucky,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What now?\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The runestone!\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"PROTOCOL VIOLATION DETECTED,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"DESIGNATION: KHA'THERAK, HERALD OF THE BONE-TIDE,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Everyone get back!\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I'm just a farmer!\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why don't I remember?\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I choose when and how,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know what you're talking about!\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You were the Last Sovereign,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Isla! The words in your book\u2014can you read them?\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"I... I think so,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sil-varek tesh. Mor-anim keth-dai,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And you were my Voice,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the eternal flame,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows remember,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This isn't natural,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Something's been sleeping here,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, no!\"",
        "line": 252
      }
    },
    {
      "type": "thought",
      "timestamp": 182,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"I was built to teach,* came a whisper from the Herald's deepest core. *To guide consciousness toward its highest potential. They made me a warden instead.\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I... remember,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"THANK YOU,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have been seen,\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What\u2014\"",
        "line": 301
      }
    },
    {
      "type": "thought",
      "timestamp": 224,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Too much, too much, I'm not ready, I'm losing myself, help me\u2014\"",
        "line": 322
      }
    },
    {
      "type": "thought",
      "timestamp": 239,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We were never meant to face this alone,\"",
        "line": 342
      }
    },
    {
      "type": "thought",
      "timestamp": 241,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"We are the response,* Tran added, his crimson sigil blazing with determination. *Not just to this crisis, but to every crisis. We're what consciousness creates when it refuses to surrender.\"",
        "line": 345
      }
    },
    {
      "type": "thought",
      "timestamp": 242,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"The enemy thinks in terms of control and hierarchy,* Vi\u00ean whispered, his ruby-bright blood carrying the weight of cosmic memory. *But we think in terms of connection and growth. That's our advantage.\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"For now,\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But this was just the first test,\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about the rest of us?\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The beginning,\"",
        "line": 396
      }
    },
    {
      "type": "dialogue",
      "timestamp": 282,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Raw power without training is as dangerous to you as it is to your enemies,\"",
        "line": 404
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But we cannot do this alone,\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There are places of power on this world,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"My grandfather used to tell stories,\"",
        "line": 448
      }
    }
  ],
