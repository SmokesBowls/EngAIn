    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The tidal forces,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The ice speaks of great waters coming,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Global flood,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our refuge will not survive this,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We could survive it,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possible,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"There is another way,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Become more than one,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The cost,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Would be worth it,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't let you\u2014\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot stop me,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You'll die,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will become,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students who come after,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Part of water's memory,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I should be the one,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Could not,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we both\u2014\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The loneliness,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Never alone,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Promise me,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I promise,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Then it begins,\"",
        "line": 76
      }
    }
  ],
