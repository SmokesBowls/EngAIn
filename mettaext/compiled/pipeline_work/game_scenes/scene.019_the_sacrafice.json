    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The tidal forces,\"",
        "line": 7
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The ice speaks of great waters coming,\"",
        "line": 10
      }
    },
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Global flood,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our refuge will not survive this,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We could survive it,\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possible,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"There is another way,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Become more than one,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The cost,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Would be worth it,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't let you\u2014\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot stop me,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You'll die,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will become,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students who come after,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Part of water's memory,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I should be the one,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Could not,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we both\u2014\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The loneliness,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Never alone,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Promise me,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I promise,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Then it begins,\"",
        "line": 73
      }
    }
  ],
