{
  "scene_id": "064_pass_through_shadow_and_flame",
  "description": "Chapter 5: Paths Through Shadow and Flame (Expanded)",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're mapping our signatures,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not just persistent,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Where are we going?\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"There's something I haven't told you about my training,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Their libraries held truths that could liberate galaxies,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Ancient network?\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To the places where knowledge itself is preserved,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How far?\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Not far now,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Northern Eye,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seven?\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It left wounds in reality itself,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Khe,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network is broken,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Compassion extinguishes suns sometimes,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Surround the perimeter!\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it requires something the network can verify,\"",
        "line": 252
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's responding,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the eternal flame,\"",
        "line": 307
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The heart of the network,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Record of Intent,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Orathiel,\"",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who arbitrates your cosmic standards?\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To access the pathways that lead between worlds,\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What exactly are we signing?\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stop!\"",
        "line": 352
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What of our right to forget?\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 401
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "Orathiel",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "Orathiel",
      "action": "speak",
      "data": {
        "text": "\"The Solar Realm,\"",
        "line": 436
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ethereal Kingdoms,\"",
        "line": 443
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And countless others,\"",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek the heir to the lunar throne,\"",
        "line": 455
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And that someone is me,\"",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 502
      }
    },
    {
      "type": "dialogue",
      "timestamp": 340,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No resonance,\"",
        "line": 504
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The pathway is collapsing,\"",
        "line": 511
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Emergency protocol! Seed Jump activation!\"",
        "line": 515
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solar Observer has gone dark,\"",
        "line": 531
      }
    }
  ],
