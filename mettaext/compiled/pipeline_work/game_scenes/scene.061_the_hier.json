    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The readings are troubling,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Show me,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So it returns,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The readings are confirmed,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Earth dwellers?\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No, Your Majesty,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The old prophecies speak of this time,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I believe what the stars have always told us,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Something's wrong,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows... they're contaminated,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It has begun,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The palace defenses are failing,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Of course they are,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rongtai,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty, I won't leave you\u2014\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will!\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is the Heart of Lyraleth,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can delay them,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The heir will need training,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty, there has to be another way\u2014\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is no other way,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have served faithfully,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Find her,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Brace yourself!\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Queen?\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Gone,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The invasion,\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're in the right place,\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Queen's final command stands,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Do you feel that?\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Earth magic,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like moonlight,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Come,\"",
        "line": 247
      }
    }
  ],
