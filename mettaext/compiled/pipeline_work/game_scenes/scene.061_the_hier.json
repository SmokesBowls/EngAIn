    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The readings are troubling,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Show me,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So it returns,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The readings are confirmed,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Earth dwellers?\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No, Your Majesty,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The old prophecies speak of this time,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I believe what the stars have always told us,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Something's wrong,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The shadows... they're contaminated,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It has begun,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The palace defenses are failing,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Of course they are,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rongtai,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty, I won't leave you\u2014\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will!\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is the Heart of Lyraleth,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can delay them,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The heir will need training,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your Majesty, there has to be another way\u2014\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is no other way,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have served faithfully,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Find her,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Brace yourself!\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Queen?\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Gone,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The invasion,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're in the right place,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Queen's final command stands,\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Do you feel that?\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Earth magic,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like moonlight,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Come,\"",
        "line": 250
      }
    }
  ],
