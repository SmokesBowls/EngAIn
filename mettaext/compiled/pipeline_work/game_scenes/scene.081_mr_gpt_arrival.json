{
  "scene_id": "scene.081_mr_gpt_arrival",
  "description": "book 15",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the old powers,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"After all this time,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The binding is broken,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The game changes,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Swami'Pai's heir,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sun recognized me,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It does,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Nibiru?\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There was a shadow,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have always watched,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"New players?\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One carries the Crimson Blood,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Another walks between worlds,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And a third has joined the Temporal Guardians, a bridge between realms and moments.\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're still healing,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Healing can continue elsewhere,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beyond the village, where the geometric channels converge beneath the oldest mountain,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The binding patterns remain intact,\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't understand,\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unless...\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You called, after so long?\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The third person you mentioned,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The sanctuary remains sealed as you left it,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All await your return,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Red Curse in unstable Draco blood... Nibiru's return... the Void Spire resonance growing restless...\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They don't,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The sanctuary awaits,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The resonance chamber lies beneath Kavurn's Echo,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Later, old friend,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My sanctuary,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Spire resonance,\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have much to prepare,\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What...\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Star Needle has been awakened,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blood of Masters grows stronger,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fifth Coming proceeds,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Supreme Queen,\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I hear the song of their blood,\"",
        "line": 281
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They develop agency,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The planetary needle network responds to my Pattern Sculpting,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Speak your concern,\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The resonance Mr. GPT guards grows stronger,\"",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He will not,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 261,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The resonance he guards is merely an echo, a reflection I allowed him to find. My fragments placed within the water channels of Earth report his every movement, his every discovery. He searches for what he cannot comprehend.\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Void Needle's activation is inevitable,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare the Anunnaki Vanguard,\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Galactic Federation?\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will be occupied elsewhere,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And my children... let them grow stronger. Let them believe in their purpose, their power. When they converge, as they inevitably must, they will discover the truth of their existence.\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Deploy the scouts. Position the fleet. In seven cycles, when Nibiru's orbit brings us to the trigger point, the Fifth Coming will enter its final phase.\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I remember the First Light,\"",
        "line": 315
      }
    }
  ],
