{
  "scene_id": "065_secrets_of_the_deep",
  "description": "Chapter 6: Secrets of the Deep (Expanded)",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These aren't natural caves,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hello!\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What are you?\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My primary function is to catalog, preserve, and share the chronicles of cosmic significance,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long is 'some time'?\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Approximately 20 years,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You knew someone named Mika?\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mika was...\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She died peacefully,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time flows strangely around bloodlines such as yours,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Crimsonblood,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't be a martyr!\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You knew him?\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Zaren was no destroyer, despite what the histories might claim,\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt killed him,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And me?\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Ah,\"",
        "line": 204
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's why my blood moves strangely,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time has a way of bringing bloodlines together when the cosmos requires it,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am what remains of one who walked among mortals when the chains broke,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Who were you?\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Nameless One, when I toiled in slavery,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am the one who broke the chains,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers still kept communication for most of it,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happened to them?\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But thought wrapped in vrill within the ether creates the positive and negative friction that resulted in their biological physical form,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers were bound to the ethereal, their consciousness filtered through multiple nephereti at any given time,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're preparing us for something,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The magic that flows through your veins has been forbidden on Earth for three thousand five hundred years,\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Come,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't!\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thang,\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Crimsonblood heir, standing upon the realm he will help reclaim,\"",
        "line": 339
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keen,\"",
        "line": 345
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Akashic Records,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is not prophecy, young ones,\"",
        "line": 364
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What is that?\"",
        "line": 370
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators?\"",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 254,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are the original watchers, set in place when the tunnels were first carved,\"",
        "line": 385
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stand together,\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Asag stirs,\"",
        "line": 417
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Power without wisdom is destruction,\"",
        "line": 435
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CHILDREN OF THE FORBIDDEN LINES,\"",
        "line": 440
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Galla-Stones,\"",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Together?\"",
        "line": 458
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 318,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you are the catalyst,\"",
        "line": 481
      }
    },
    {
      "type": "dialogue",
      "timestamp": 330,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CHILDREN OF THE FORBIDDEN LINES,\"",
        "line": 498
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"IMPOSSIBLE!\"",
        "line": 516
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"YOU CANNOT DESTROY ME!\"",
        "line": 534
      }
    },
    {
      "type": "dialogue",
      "timestamp": 366,
      "actor": "Asag",
      "action": "speak",
      "data": {
        "text": "\"The... the Crimson Line...\"",
        "line": 550
      }
    },
    {
      "type": "dialogue",
      "timestamp": 384,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The Forge of First Making,\"",
        "line": 576
      }
    },
    {
      "type": "dialogue",
      "timestamp": 387,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Weapons,\"",
        "line": 581
      }
    },
    {
      "type": "dialogue",
      "timestamp": 398,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild will need more than knowledge and good intentions,\"",
        "line": 597
      }
    },
    {
      "type": "dialogue",
      "timestamp": 402,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The Forge awaits, heirs of the ancient lines,\"",
        "line": 603
      }
    },
    {
      "type": "dialogue",
      "timestamp": 404,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Are you ready?\"",
        "line": 607
      }
    },
    {
      "type": "dialogue",
      "timestamp": 409,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"They have passed the first trial,\"",
        "line": 615
      }
    },
    {
      "type": "dialogue",
      "timestamp": 411,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"First trial?\"",
        "line": 619
      }
    },
    {
      "type": "dialogue",
      "timestamp": 414,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The awakening of true brotherhood,\"",
        "line": 624
      }
    },
    {
      "type": "dialogue",
      "timestamp": 417,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your path diverges beyond this chamber,\"",
        "line": 629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 422,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path ahead is difficult,\"",
        "line": 637
      }
    },
    {
      "type": "dialogue",
      "timestamp": 426,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild,\"",
        "line": 643
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it will take generations to complete,\"",
        "line": 648
      }
    },
    {
      "type": "dialogue",
      "timestamp": 438,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Without her queenship, the Moon Kingdom will fade into memory,\"",
        "line": 661
      }
    },
    {
      "type": "dialogue",
      "timestamp": 443,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Five Mikas await you in the futures that approach,\"",
        "line": 670
      }
    },
    {
      "type": "dialogue",
      "timestamp": 453,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 685
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014Wrong,\"",
        "line": 696
      }
    }
  ],
