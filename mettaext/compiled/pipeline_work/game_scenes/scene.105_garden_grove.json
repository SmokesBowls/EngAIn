  "events": [
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe pulse is stronger here,\u201d",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re watching us,\u201d",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cAre they learning from us, or waiting for something?\u201d",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe give them time,\u201d",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re testing,\u201d",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe pulse is drawing them,\u201d",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAre they going to attack?\u201d",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNot today. But they\u2019re testing the boundary. Seeing if the pulse will hold.\u201d",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ll be back,\u201d",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe have a choice,\u201d",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey want the needle,\u201d",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThen we need to make them understand they can\u2019t have it,\u201d",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe grove giants were ready to listen,\u201d",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe Keeper is waking,\u201d",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cAnd until then?\u201d",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe hold. We build. We learn.\u201d",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re watching,\u201d",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re afraid,\u201d",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cCan they take it?\u201d",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe hold,\u201d",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re waiting for something,\u201d",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat are they waiting for?\u201d",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd if they find another way?\u201d",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know.\u201d",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThe chamber,\u201d",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s gone,\u201d",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cIt didn\u2019t leave,\u201d",
        "line": 400
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe pulse,\u201d",
        "line": 402
      }
    },
    {
      "type": "dialogue",
      "timestamp": 368,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe build,\u201d",
        "line": 535
      }
    },
    {
      "type": "dialogue",
      "timestamp": 392,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re in my head,\u201d",
        "line": 568
      }
    },
    {
      "type": "dialogue",
      "timestamp": 397,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey couldn\u2019t cross the boundary,\u201d",
        "line": 575
      }
    },
    {
      "type": "dialogue",
      "timestamp": 405,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cHow do we stop them?\u201d",
        "line": 585
      }
    },
    {
      "type": "dialogue",
      "timestamp": 413,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re testing,\u201d",
        "line": 596
      }
    },
    {
      "type": "dialogue",
      "timestamp": 428,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s different now,\u201d",
        "line": 615
      }
    },
    {
      "type": "dialogue",
      "timestamp": 434,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd the swamp giants?\u201d",
        "line": 623
      }
    },
    {
      "type": "dialogue",
      "timestamp": 452,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cThey chose this,\u201d",
        "line": 650
      }
    },
    {
      "type": "dialogue",
      "timestamp": 473,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not just mimicking,\u201d",
        "line": 680
      }
    },
    {
      "type": "dialogue",
      "timestamp": 474,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cAnd she\u2019s giving them ours,\u201d",
        "line": 682
      }
    },
    {
      "type": "dialogue",
      "timestamp": 485,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cLike hearing a language you almost understand,\u201d",
        "line": 696
      }
    },
    {
      "type": "dialogue",
      "timestamp": 496,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re trying to understand,\u201d",
        "line": 713
      }
    },
    {
      "type": "dialogue",
      "timestamp": 497,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cCan they?\u201d",
        "line": 715
      }
    },
    {
      "type": "dialogue",
      "timestamp": 507,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ll never attack again,\u201d",
        "line": 728
      }
    },
    {
      "type": "dialogue",
      "timestamp": 520,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cEvery year,\u201d",
        "line": 748
      }
    },
    {
      "type": "dialogue",
      "timestamp": 521,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cThen we build higher still,\u201d",
        "line": 750
      }
    },
    {
      "type": "dialogue",
      "timestamp": 556,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s waiting,\u201d",
        "line": 799
      }
    },
    {
      "type": "dialogue",
      "timestamp": 557,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhen will it be ready?\u201d",
        "line": 801
      }
    },
    {
      "type": "dialogue",
      "timestamp": 574,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re looking for their own Keeper,\u201d",
        "line": 826
      }
    },
    {
      "type": "dialogue",
      "timestamp": 575,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cIs there anything there?\u201d",
        "line": 828
      }
    },
    {
      "type": "dialogue",
      "timestamp": 584,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ve learned something,\u201d",
        "line": 840
      }
    },
    {
      "type": "dialogue",
      "timestamp": 586,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cCan they cross the boundary?\u201d",
        "line": 843
      }
    },
    {
      "type": "dialogue",
      "timestamp": 630,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe rhythm is changing,\u201d",
        "line": 906
      }
    },
    {
      "type": "dialogue",
      "timestamp": 632,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cInto the Ma'at?\u201d",
        "line": 909
      }
    },
    {
      "type": "dialogue",
      "timestamp": 640,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to shift the planting,\u201d",
        "line": 922
      }
    },
    {
      "type": "dialogue",
      "timestamp": 641,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cOr store more,\u201d",
        "line": 924
      }
    },
    {
      "type": "dialogue",
      "timestamp": 642,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe winters are already long,\u201d",
        "line": 926
      }
    },
    {
      "type": "dialogue",
      "timestamp": 657,
      "actor": "Vine",
      "action": "speak",
      "data": {
        "text": "\u201cIt will watch still,\u201d",
        "line": 948
      }
    },
    {
      "type": "dialogue",
      "timestamp": 668,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cSomething is wrong with the sky,\u201d",
        "line": 965
      }
    },
    {
      "type": "dialogue",
      "timestamp": 674,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe Ma'at still glows,\u201d",
        "line": 973
      }
    },
    {
      "type": "dialogue",
      "timestamp": 675,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAlways.\u201d",
        "line": 975
      }
    },
    {
      "type": "dialogue",
      "timestamp": 680,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cSomething is coming,\u201d",
        "line": 982
      }
    },
    {
      "type": "dialogue",
      "timestamp": 683,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe pulse has held for a hundred years. It will hold longer. But the world outside the boundary is changing, and we do not know why. The light fades. The cold grows. The shapes have withdrawn into the deep. And somewhere in the east, the Ma'at still pulses, waiting for something.\u201d",
        "line": 987
      }
    },
    {
      "type": "dialogue",
      "timestamp": 685,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe have been watching the east for so long we forgot to watch the sky.\u201d",
        "line": 991
      }
    },
    {
      "type": "dialogue",
      "timestamp": 717,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s not rising,\u201d",
        "line": 1036
      }
    },
    {
      "type": "dialogue",
      "timestamp": 722,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cHow long?\u201d",
        "line": 1043
      }
    },
    {
      "type": "dialogue",
      "timestamp": 723,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI don\u2019t know.\u201d",
        "line": 1045
      }
    },
    {
      "type": "dialogue",
      "timestamp": 731,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cthe Keeper is afraid,\u201d",
        "line": 1056
      }
    },
    {
      "type": "dialogue",
      "timestamp": 733,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe prepare,\u201d",
        "line": 1060
      }
    },
    {
      "type": "dialogue",
      "timestamp": 734,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cFor what?\u201d",
        "line": 1062
      }
    },
    {
      "type": "dialogue",
      "timestamp": 736,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFor the light to return. Or for whatever did this to show itself.\u201d",
        "line": 1066
      }
    },
    {
      "type": "dialogue",
      "timestamp": 748,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeomancy is slowing,\u201d",
        "line": 1084
      }
    },
    {
      "type": "dialogue",
      "timestamp": 750,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cKeep trying,\u201d",
        "line": 1087
      }
    },
    {
      "type": "dialogue",
      "timestamp": 772,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re not afraid,\u201d",
        "line": 1115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 788,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cKeeper?\u201d",
        "line": 1138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 792,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s not gone,\u201d",
        "line": 1144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 793,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCan you wake it?\u201d",
        "line": 1146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 794,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m trying.\u201d",
        "line": 1148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 800,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cIf the pulse fails,\u201d",
        "line": 1156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 801,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIf the pulse fails,\u201d",
        "line": 1158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 806,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cSing,\u201d",
        "line": 1165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 807,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat?\u201d",
        "line": 1167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 808,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSing. the Keeper responds to sound. If the heat is gone, maybe the sound will carry the charge. Wake it up.\u201d",
        "line": 1169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 829,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not retreating,\u201d",
        "line": 1199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 830,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cThey think the sun isn\u2019t coming back,\u201d",
        "line": 1201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 831,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCan we hold them?\u201d",
        "line": 1203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 837,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cVine says their kind can hunt in this,\u201d",
        "line": 1211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 838,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we let the grove giants fight?\u201d",
        "line": 1213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 839,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe stand together,\u201d",
        "line": 1215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 843,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cThen we don\u2019t let it last a week,\u201d",
        "line": 1221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 844,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFor what?\u201d",
        "line": 1223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 845,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cFor the sun,\u201d",
        "line": 1225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 859,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cContact!\u201d",
        "line": 1247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 875,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cKael!\u201d",
        "line": 1269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 876,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m trying!\u201d",
        "line": 1271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 898,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHold!\u201d",
        "line": 1301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 915,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019ve survived this before,\u201d",
        "line": 1326
      }
    }
