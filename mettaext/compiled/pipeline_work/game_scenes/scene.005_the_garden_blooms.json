    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We built a garden by accident,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's the geometry,\"",
