      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 168
      }
    },
    {
      "type": "thought",
      "timestamp": 119,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Ulric's Arrival Description]*\"",
        "line": 178
      }
    },
    {
      "type": "thought",
      "timestamp": 127,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Survivors of Sundrift!\"",
        "line": 198
      }
    },
    {
      "type": "thought",
      "timestamp": 133,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Keen's Deception Preparation]*\"",
        "line": 200
      }
    },
    {
      "type": "thought",
      "timestamp": 142,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Protection,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unknown individuals displaying unauthorized magical capabilities!\"",
        "line": 223
      }
    },
    {
      "type": "thought",
      "timestamp": 150,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Tran's Scythe Response]*\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"*Unauthorized?*\"",
        "line": 232
      }
    },
    {
      "type": "thought",
      "timestamp": 157,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And if we decline your generous offer?\"",
        "line": 242
      }
    },
    {
      "type": "thought",
      "timestamp": 163,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Ulric's Knowledge Reveal]*\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tran and Keen, proprietors of Solis Ranch,\"",
        "line": 254
      }
    },
    {
      "type": "thought",
      "timestamp": 169,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Not a trader,\"",
        "line": 269
      }
    },
    {
      "type": "thought",
      "timestamp": 178,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Garric vs Thalia Tension]*\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"My granddaughter breathes because of you,\"",
        "line": 276
      }
    },
    {
      "type": "thought",
      "timestamp": 186,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 285
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We should go down,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Facilities,\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"There's another option,\"",
        "line": 325
      }
    },
    {
      "type": "thought",
      "timestamp": 215,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Isla's Bargaining]*\"",
        "line": 327
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll enter Ironspire,\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You're hardly in a position to negotiate,\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Aren't I?\"",
        "line": 340
      }
    },
    {
      "type": "thought",
      "timestamp": 225,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Captain Ulric!\"",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The giants,\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because some chains can't be seen,\"",
        "line": 387
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stand down,\"",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The offer of protection stands,\"",
        "line": 416
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Watch over each other,\"",
        "line": 461
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Same to you,\"",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This isn't goodbye,\"",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 314,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Because some connections transcend distance,\"",
        "line": 475
      }
    },
    {
      "type": "thought",
      "timestamp": 318,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Environmental Response to Separation]*\"",
        "line": 482
      }
    },
    {
      "type": "thought",
      "timestamp": 326,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 494
      }
    },
    {
      "type": "dialogue",
      "timestamp": 328,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do you feel that?\"",
        "line": 498
      }
    },
    {
      "type": "thought",
      "timestamp": 342,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Final Environmental Resonance]*\"",
