      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[SENSORY FLASHBACK]*\"",
        "line": 87
      }
    },
    {
      "type": "thought",
      "timestamp": 59,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Cold metal against his cheek. Blue energy restraints humming like angry wasps. A voice speaking Igigi: \"Subject Seven resisting neural calibration.\" The smell of ozone and voided bowels. A needle's bite in his neck\u2014\"",
        "line": 88
      }
    },
    {
      "type": "thought",
