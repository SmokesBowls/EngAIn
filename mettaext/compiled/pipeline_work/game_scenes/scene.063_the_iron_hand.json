      "timestamp": 79,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"So what do you think?\"",
        "line": 119
      }
    },
    {
      "type": "thought",
      "timestamp": 92,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Military Approach Details]*\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Twenty riders,\"",
        "line": 142
      }
    },
    {
      "type": "thought",
      "timestamp": 100,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[END EXPANSION]*\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"They'll come looking,\"",
        "line": 153
      }
    },
    {
      "type": "thought",
      "timestamp": 103,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"*[EXPANSION: Thalia's Memory Trigger]*\"",
        "line": 155
      }
    },
    {
      "type": "thought",
