  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't tell.\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everyone to the beach,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They don't know what we are,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some are afraid,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're teaching each other,\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They're arguing about us,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We hurt them,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We can't undo the past,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Actions, not words,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We were wrong,\"",
        "line": 265
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They want to stay,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"And the jade-greens?\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Uncertain. Torhh wants to trust. Some of the others... they need more time. More proof that we're not what they remember.\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 335
      }
    }
  ],
