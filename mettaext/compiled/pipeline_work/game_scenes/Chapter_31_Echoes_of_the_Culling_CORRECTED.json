{
  "scene_id": "Chapter_31_Echoes_of_the_Culling_CORRECTED",
  "description": "Chapter 31: Echoes of the Culling",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ashfall Plains reveal themselves differently to those who know how to look,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three cycles of ash-light,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Ashen Tide?\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The plains breathe,\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This place knows me,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We move swiftly,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The cloaks,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perception garments,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There was civilization here,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Many civilizations,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time means little on Umbrageous,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Listen carefully,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nothing,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do not engage!\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Temporal boundary breach,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are they?\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Echoes of the fallen,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to do something,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Then what do we do?\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This carries similar resonance,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What just happened?\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Wastes remember all debts,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And do I?\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Blood remembers | Time transfers | Void connects.\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A token only,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"A waypoint?\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A memory anchor,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It recognizes you,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What is it trying to do?\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To remember | To record | To preserve.\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Whose memories?\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All who carried Zaryon's blood,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can't...\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You must decide,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, wait,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Convergence\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"What did you see?\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Everything,\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"But why scatter them?\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because knowledge is power | Power attracts hunters | Hunters serve the Queen.\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We must reach the threshold before darkness,\"",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solantri,\"",
        "line": 307
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What are they saying?\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They announce your arrival,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will they help us find the Void Spire?\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If they deem you worthy,\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have detected something else,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. Something worse.\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"From native hunters, yes. From Anunnaki technology...\"",
        "line": 339
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are they saying now?\"",
        "line": 345
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They offer sanctuary,\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What price?\"",
        "line": 351
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Verification of intent. A resonance test.\"",
        "line": 354
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's invasive,\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's survival,\"",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll do it,\"",
        "line": 371
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, we don't know what this involves,\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We don't have a choice,\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Harmonic Path,\"",
        "line": 386
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What?\"",
        "line": 389
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path rejects entropy,\"",
        "line": 392
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will we see you again?\"",
        "line": 395
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When the final ash falls | When the Void calls | When the truth awakens.\"",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't like this,\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have been maneuvered since we arrived on this planet,\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Irix Thal,\"",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You who vibrate in temporal thirds,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I do,\"",
        "line": 430
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Follow,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Echo Crown,\"",
        "line": 455
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do I need to do?\"",
        "line": 462
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stand within the focus point,\"",
        "line": 464
      }
    },
    {
      "type": "dialogue",
      "timestamp": 313,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Begin verification,\"",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What did you do to him?\"",
        "line": 535
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Verification\u2014complete,\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragmented one?\"",
        "line": 541
      }
    },
    {
      "type": "dialogue",
      "timestamp": 366,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rest will be required,\"",
        "line": 549
      }
    },
    {
      "type": "dialogue",
      "timestamp": 373,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The verification is complete,\"",
        "line": 558
      }
    }
  ],
