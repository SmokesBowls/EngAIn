    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe southern needle is compromised,\u201d",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\u201cAnd the Annunaki?\u201d",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\u201cThen we send the second thousand,\u201d",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe build,\u201d",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s slowing,\u201d",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe Aeon Keepers said it was damaged,\u201d",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cBack,\u201d",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe mean no harm,\u201d",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cInside!\u201d",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cThey can\u2019t get in,\u201d",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt likes sound,\u201d",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey stop at the old road,\u201d",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cThen why did they attack us at all?\u201d",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThis wasn\u2019t just a tower,\u201d",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "Jaren",
      "action": "speak",
      "data": {
        "text": "\u201cThe Keepers didn\u2019t build this,\u201d",
        "line": 355
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe should send scouts further out,\u201d",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "Ria",
      "action": "speak",
      "data": {
        "text": "\u201cWe lost several in the first week,\u201d",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cThere\u2019s a place,\u201d",
        "line": 404
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "Ria",
      "action": "speak",
      "data": {
        "text": "\u201cThe needle is broken,\u201d",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s still there.\u201d",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to hit it,\u201d",
        "line": 424
      }
    },
    {
      "type": "dialogue",
      "timestamp": 302,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe can\u2019t shape stone. There\u2019s no stone here.\u201d",
        "line": 426
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we shape the wood. The water. We shape what we have.\u201d",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cNow!\u201d",
        "line": 437
      }
    },
    {
      "type": "dialogue",
      "timestamp": 318,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAgain!\u201d",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 322,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe leave today,\u201d",
        "line": 456
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cThe giants found us before we could find shelter,\u201d",
        "line": 479
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThere are more of us,\u201d",
        "line": 485
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cWhat was that?\u201d",
        "line": 504
      }
    },
    {
      "type": "dialogue",
      "timestamp": 367,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ve built,\u201d",
        "line": 521
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re not all here,\u201d",
        "line": 529
      }
    },
    {
      "type": "dialogue",
      "timestamp": 378,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find them,\u201d",
        "line": 537
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThere are many of us,\u201d",
        "line": 553
      }
    },
    {
      "type": "dialogue",
      "timestamp": 395,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cWe lost many,\u201d",
        "line": 563
      }
    },
    {
      "type": "dialogue",
      "timestamp": 403,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s what we make it.\u201d",
        "line": 574
      }
    },
    {
      "type": "dialogue",
      "timestamp": 423,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to bring them in,\u201d",
        "line": 601
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe thought we were the only ones,\u201d",
        "line": 613
      }
    },
    {
      "type": "dialogue",
      "timestamp": 432,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cHow many?\u201d",
        "line": 615
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cStarted with several dozen. Lost a number in the first week to the giants. The rest\u2026 we lost to the caves. To the heat. To not knowing which way was safe.\u201d",
        "line": 617
      }
    },
    {
      "type": "dialogue",
      "timestamp": 440,
      "actor": "Nessa",
      "action": "speak",
      "data": {
        "text": "\u201cThere are a few of them,\u201d",
        "line": 627
      }
    },
    {
      "type": "dialogue",
      "timestamp": 441,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd they haven\u2019t attacked?\u201d",
        "line": 629
      }
    },
    {
      "type": "dialogue",
      "timestamp": 442,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey don\u2019t need to. They\u2019re waiting for us to come out. Every time we tried to leave, they drove us back. Not killing\u2014herding. Like they\u2019re\u2026 corralling us.\u201d",
        "line": 631
      }
    },
    {
      "type": "dialogue",
      "timestamp": 446,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re not leaving the way we came,\u201d",
        "line": 637
      }
    },
    {
      "type": "dialogue",
      "timestamp": 479,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe saw you fall,\u201d",
        "line": 685
      }
    },
    {
      "type": "dialogue",
      "timestamp": 485,
      "actor": "Ione",
      "action": "speak",
      "data": {
        "text": "\u201cWe can\u2019t stay here,\u201d",
        "line": 693
      }
    },
    {
      "type": "dialogue",
      "timestamp": 489,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThen we go now,\u201d",
        "line": 699
      }
    },
    {
      "type": "dialogue",
      "timestamp": 503,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThe others are out there,\u201d",
        "line": 721
      }
    },
    {
      "type": "dialogue",
      "timestamp": 504,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find them,\u201d",
        "line": 723
      }
    },
    {
      "type": "dialogue",
      "timestamp": 510,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to understand them,\u201d",
        "line": 732
      }
    },
    {
      "type": "dialogue",
      "timestamp": 511,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThat could work for us,\u201d",
        "line": 734
      }
    },
    {
      "type": "dialogue",
      "timestamp": 517,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cRenn, you said the grove giants use tools. They herd rather than kill. That\u2019s strategy. That\u2019s thought.\u201d",
        "line": 743
      }
    },
    {
      "type": "dialogue",
      "timestamp": 518,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re smarter than the swamp ones,\u201d",
        "line": 745
      }
    },
    {
      "type": "dialogue",
      "timestamp": 520,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen maybe they\u2019re the ones we need to find. Not to fight\u2014to talk.\u201d",
        "line": 748
      }
    },
    {
      "type": "dialogue",
      "timestamp": 524,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNot yet. But someday.\u201d",
        "line": 754
      }
    },
    {
      "type": "dialogue",
      "timestamp": 535,
      "actor": "Ria",
      "action": "speak",
      "data": {
        "text": "\u201cWe lost several in the first week,\u201d",
        "line": 772
      }
    }
  ],
