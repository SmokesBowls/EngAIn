  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe southern needle is compromised,\u201d",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\u201cAnd the Annunaki?\u201d",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\u201cThen we send the second thousand,\u201d",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe build,\u201d",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s slowing,\u201d",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe Aeon Keepers said it was damaged,\u201d",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cBack,\u201d",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe mean no harm,\u201d",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cInside!\u201d",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cThey can\u2019t get in,\u201d",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt likes sound,\u201d",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey stop at the old road,\u201d",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\u201cThen why did they attack us at all?\u201d",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThis wasn\u2019t just a tower,\u201d",
        "line": 351
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "Jaren",
      "action": "speak",
      "data": {
        "text": "\u201cThe Keepers didn\u2019t build this,\u201d",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe should send scouts further out,\u201d",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "Ria",
      "action": "speak",
      "data": {
        "text": "\u201cWe lost several in the first week,\u201d",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cThere\u2019s a place,\u201d",
        "line": 405
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "Ria",
      "action": "speak",
      "data": {
        "text": "\u201cThe needle is broken,\u201d",
        "line": 407
      }
    },
    {
      "type": "dialogue",
      "timestamp": 292,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s still there.\u201d",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe have to hit it,\u201d",
        "line": 425
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe can\u2019t shape stone. There\u2019s no stone here.\u201d",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we shape the wood. The water. We shape what we have.\u201d",
        "line": 429
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cNow!\u201d",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAgain!\u201d",
        "line": 450
      }
    },
    {
      "type": "dialogue",
      "timestamp": 324,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe leave today,\u201d",
        "line": 457
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cThe giants found us before we could find shelter,\u201d",
        "line": 480
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThere are more of us,\u201d",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cWhat was that?\u201d",
        "line": 505
      }
    },
    {
      "type": "dialogue",
      "timestamp": 369,
      "actor": "Deryn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ve built,\u201d",
        "line": 522
      }
    },
    {
      "type": "dialogue",
      "timestamp": 374,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re not all here,\u201d",
        "line": 530
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find them,\u201d",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThere are many of us,\u201d",
        "line": 554
      }
    },
    {
      "type": "dialogue",
      "timestamp": 397,
      "actor": "Venn",
      "action": "speak",
      "data": {
        "text": "\u201cWe lost many,\u201d",
        "line": 564
      }
    },
    {
      "type": "dialogue",
      "timestamp": 405,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s what we make it.\u201d",
        "line": 575
      }
    },
    {
      "type": "dialogue",
      "timestamp": 425,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to bring them in,\u201d",
        "line": 602
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe thought we were the only ones,\u201d",
        "line": 614
      }
    },
    {
      "type": "dialogue",
      "timestamp": 434,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cHow many?\u201d",
        "line": 616
      }
    },
    {
      "type": "dialogue",
      "timestamp": 435,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cStarted with several dozen. Lost a number in the first week to the giants. The rest\u2026 we lost to the caves. To the heat. To not knowing which way was safe.\u201d",
        "line": 618
      }
    },
    {
      "type": "dialogue",
      "timestamp": 442,
      "actor": "Nessa",
      "action": "speak",
      "data": {
        "text": "\u201cThere are a few of them,\u201d",
        "line": 628
      }
    },
    {
      "type": "dialogue",
      "timestamp": 443,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd they haven\u2019t attacked?\u201d",
        "line": 630
      }
    },
    {
      "type": "dialogue",
      "timestamp": 444,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey don\u2019t need to. They\u2019re waiting for us to come out. Every time we tried to leave, they drove us back. Not killing\u2014herding. Like they\u2019re\u2026 corralling us.\u201d",
        "line": 632
      }
    },
    {
      "type": "dialogue",
      "timestamp": 448,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re not leaving the way we came,\u201d",
        "line": 638
      }
    },
    {
      "type": "dialogue",
      "timestamp": 481,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe saw you fall,\u201d",
        "line": 686
      }
    },
    {
      "type": "dialogue",
      "timestamp": 487,
      "actor": "Ione",
      "action": "speak",
      "data": {
        "text": "\u201cWe can\u2019t stay here,\u201d",
        "line": 694
      }
    },
    {
      "type": "dialogue",
      "timestamp": 491,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThen we go now,\u201d",
        "line": 700
      }
    },
    {
      "type": "dialogue",
      "timestamp": 505,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThe others are out there,\u201d",
        "line": 722
      }
    },
    {
      "type": "dialogue",
      "timestamp": 506,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find them,\u201d",
        "line": 724
      }
    },
    {
      "type": "dialogue",
      "timestamp": 512,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to understand them,\u201d",
        "line": 733
      }
    },
    {
      "type": "dialogue",
      "timestamp": 513,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThat could work for us,\u201d",
        "line": 735
      }
    },
    {
      "type": "dialogue",
      "timestamp": 519,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cRenn, you said the grove giants use tools. They herd rather than kill. That\u2019s strategy. That\u2019s thought.\u201d",
        "line": 744
      }
    },
    {
      "type": "dialogue",
      "timestamp": 520,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re smarter than the swamp ones,\u201d",
        "line": 746
      }
    },
    {
      "type": "dialogue",
      "timestamp": 522,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen maybe they\u2019re the ones we need to find. Not to fight\u2014to talk.\u201d",
        "line": 749
      }
    },
    {
      "type": "dialogue",
      "timestamp": 526,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNot yet. But someday.\u201d",
        "line": 755
      }
    }
  ],
