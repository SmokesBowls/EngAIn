    },
    {
      "id": "oreck",
      "name": "Oreck",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 5,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's been four weeks,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You think they're coming back.\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know they're coming back.\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How much force?\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Depends on who's responding.\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But that's not Anunnaki ship configuration.\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Federation,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Should we hide?\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Too late.\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Close your helm. Now. Before they get visual confirmation. If they identify you\u2014if they record your face and correlate it with the armor\u2014you'll be hunted across the galaxy for the rest of your existence.\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt\u2014\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I said no.\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They'll flag you. Your identity will be recorded, distributed, marked as enemy of galactic order. Every bounty hunter, every Federation enforcer, every Anunnaki who wants revenge\u2014they'll all know exactly who you are.\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good.\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we face them together. Openly. And deal with whatever follows.\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Enforcer Vel'thara of the Galactic Federation Compliance Division. We are here to verify Anunnaki evacuation protocols have been properly executed and to assess any irregularities requiring corrective action.\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are in possession of unauthorized Aeon Keeper artifact. Surrender the Dragon Mail immediately for confiscation and await transport to Federation processing facility for questioning regarding acquisition method and intended usage.\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That was not request. That was statement of legal requirement under Galactic Federation Artifact Control Regulation, Section 7, Subsection 12. Unauthorized possession of Aeon Keeper technology constitutes Class-1 violation punishable by artifact confiscation and mandatory detention.\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I don't care about your regulations,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Subject identification in progress,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Additional anomaly detected: Anunnaki Applicator construct present in subject's neural tissue. Symbiotic rather than controlling. Unprecedented behavioral deviation from standard operational parameters.\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You carry Anunnaki control device willingly? Explain.\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"It's complicated,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Irrelevant,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the others?\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They will be relocated to appropriate facilities pending determination of their status. The Anunnaki evacuation order remains in effect. This compound will be sealed and decommissioned. All parties will comply with Federation directives.\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then you leave us no choice. Enforcement protocols activate. Subject designated hostile. Artifact confiscation to proceed through application of necessary force.\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Last chance,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"ORECK!\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Subject identified as hostile. Designation assigned: RAGNAROK. Threat level: Maximum. Enforcement personnel\u2014neutralize with extreme prejudice. Artifact confiscation is secondary to threat elimination.\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can we focus?\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ZARON, NO!\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We need better communication!\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"AGREED,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Thought you might need backup,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Appreciated!\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enforcer Vel'thara,\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Negative,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Surrender,\"",
        "line": 343
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We're not trying to hurt you,\"",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Operation parameters exceeded. Threat level confirms subject Geralt\u2014designation RAGNAROK\u2014requires specialized response beyond standard enforcement capability. Recommend orbital support and tactical reassessment.\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This engagement concludes,\"",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every bounty hunter seeking profit. Every enforcer pursuing advancement. Every Anunnaki wanting revenge. They will all know exactly who you are and what you've done.\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You chose to show your face. To claim responsibility openly. To reject anonymity that might have granted safety. That choice will define everything that follows.\"",
        "line": 367
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I know,\"",
        "line": 369
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perhaps you should.\"",
        "line": 371
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I know,\"",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They called you Ragnarok. They said you're the end of worlds. What does that mean?\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"It means,\"",
        "line": 407
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It means they'll hunt me. Forever. Across every system. Through every generation. The name Ragnarok will outlive me, will attach to anyone who wears this armor, will become legend that transcends individual existence.\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But also\u2014it means they're afraid. That showing my face, claiming responsibility, refusing to hide behind mask made them understand we're not just lucky slaves who got fortunate. We're people who chose liberation and will defend that choice against anything they send.\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And that terrifies them more than any weapon.\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because hiding would mean accepting shame. Would mean believing freedom is something to apologize for rather than celebrate. Would mean letting them define me through fear rather than defining myself through choice.\"",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm Geralt. I freed you. I claimed this armor. I killed the Overseer. Those are facts, not crimes. And I won't pretend otherwise just because they decided liberation violates their precious regulations.\"",
        "line": 430
      }
    },
    {
      "type": "dialogue",
      "timestamp": 265,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They'll be back,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And they'll bring others. Bounty hunters. Anunnaki seeking revenge. Anyone who sees profit or advancement in claiming Ragnarok's head.\"",
        "line": 447
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your life just became significantly more complicated.\"",
        "line": 451
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I KNOW.\"",
        "line": 453
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 456
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But understand\u2014this was easy. Six enforcers with non-lethal priorities. Next time will be harder. The time after that, harder still. They'll keep escalating until they either succeed in confiscating the armor or decide you're not worth the resources required for capture.\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And that decision,\"",
        "line": 462
      }
    },
    {
      "type": "dialogue",
      "timestamp": 291,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"You're right,\"",
        "line": 483
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They called me Ragnarok. The end of worlds. The twilight of gods. They meant it as designation\u2014threat classification to justify extreme response.\"",
        "line": 487
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But I'm claiming it as identity. As purpose. As promise that their world\u2014their cosmic order built on enslavement and extraction and regulations that enable atrocity\u2014is ending. One compound at a time. One liberated population at a time. One defiant choice at a time.\"",
        "line": 489
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not just freed slaves anymore. We're proof that resistance works. We're demonstration that cosmic law can be defied. We're the beginning of something they can't stop through enforcement operations or threat classifications.\"",
        "line": 491
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're Ragnarok. And worlds that enslave conscious beings deserve to end.\"",
        "line": 493
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fifteen visible guards,\"",
        "line": 583
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The slaves. How many?\"",
        "line": 589
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Approximately two hundred based on dormitory size. Same modifications we had\u2014no speech, limited cognitive enhancement, conditioned for obedience through genetic and psychological manipulation.\"",
        "line": 591
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will they fight for us?\"",
        "line": 593
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unknown,\"",
        "line": 595
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's why you're going in first. You and the others. You look like slaves because you were slaves. You still bear the scars, the modifications, the physical markers that identify you as property rather than people. You can blend in. Get close. Position yourselves.\"",
        "line": 600
      }
    },
    {
      "type": "dialogue",
      "timestamp": 365,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And when you give the signal?\"",
        "line": 602
      }
    },
    {
      "type": "dialogue",
      "timestamp": 366,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You attack. Before the Anunnaki even realize we're there. Before they can coordinate defense. You'll have maybe thirty seconds of complete surprise before they understand what's happening.\"",
        "line": 604
      }
    },
    {
      "type": "dialogue",
      "timestamp": 368,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you?\"",
        "line": 608
      }
    },
    {
      "type": "dialogue",
      "timestamp": 370,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm going to walk up to the front gate and introduce myself. Very politely. Very obviously. While they're focused on the terrifying armored figure demanding entry, you'll already be inside. Waiting.\"",
        "line": 612
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I'll position at the rear entrance,\"",
        "line": 616
      }
    },
    {
      "type": "dialogue",
      "timestamp": 373,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three-point assault,\"",
        "line": 618
      }
    },
    {
      "type": "dialogue",
      "timestamp": 378,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"This is real combat,\"",
        "line": 625
      }
    },
    {
      "type": "dialogue",
      "timestamp": 379,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some of you might die. Some of the slaves we're trying to free might die. Success isn't guaranteed just because our cause is righteous.\"",
        "line": 627
      }
    },
    {
      "type": "dialogue",
      "timestamp": 381,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If anyone wants to withdraw, do it now. No shame. No judgment. Choosing to protect what we've already achieved rather than risking it for strangers is valid decision.\"",
        "line": 631
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We were those strangers once. Someone had to risk everything to free us. Now it's our turn to be that someone for others.\"",
        "line": 639
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Then we move,\"",
        "line": 643
      }
    },
    {
      "type": "dialogue",
      "timestamp": 389,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oreck and assault team hold at rear breach point. Wait for signal.\"",
        "line": 645
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I approach front gate at midday. Maximum visibility. Maximum intimidation. Draw every eye to me while you work from inside.\"",
        "line": 647
      }
    },
    {
      "type": "dialogue",
      "timestamp": 391,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When I break down the gate\u2014that's your signal. That's when chaos begins. Hit fast, hit hard, and don't give them time to coordinate response.\"",
        "line": 649
      }
    },
    {
      "type": "dialogue",
      "timestamp": 393,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're going to teach them otherwise. We're going to demonstrate that what happened at our compound wasn't miracle\u2014it was choice. Pattern that can be replicated. Movement that spreads faster than Anunnaki can respond.\"",
        "line": 653
      }
    },
    {
      "type": "dialogue",
      "timestamp": 394,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're going to free them. And then we're going to do it again. And again. Until Earth has no compounds left, no slaves remaining, no populations accepting enslavement as natural order.\"",
        "line": 655
      }
    },
    {
      "type": "dialogue",
      "timestamp": 444,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 735
      }
    },
    {
      "type": "dialogue",
      "timestamp": 446,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Overseer?\"",
        "line": 739
      }
    },
    {
      "type": "dialogue",
      "timestamp": 447,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Geralt handles the Overseer,\"",
        "line": 741
      }
    },
    {
      "type": "dialogue",
      "timestamp": 448,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our job is everyone else. The guards, the slave drivers, anyone who tries to interfere with liberation. We're the hammer that compresses their forces toward the center where Geralt will be waiting.\"",
        "line": 743
      }
    },
    {
      "type": "dialogue",
      "timestamp": 452,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Soon,\"",
        "line": 750
      }
    },
    {
      "type": "dialogue",
      "timestamp": 474,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt,\"",
        "line": 783
      }
    },
    {
      "type": "dialogue",
      "timestamp": 476,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Geralt,\"",
        "line": 786
      }
    },
    {
      "type": "dialogue",
      "timestamp": 479,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm here to liberate your compound. To free the slaves you call property. To kill your Overseer and demonstrate that cosmic order is negotiable rather than absolute.\"",
        "line": 791
      }
    },
    {
      "type": "dialogue",
      "timestamp": 481,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You...\"",
        "line": 795
      }
    },
    {
      "type": "dialogue",
      "timestamp": 483,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correction,\"",
        "line": 798
      }
    },
    {
      "type": "dialogue",
      "timestamp": 486,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Last chance. Open the gate. Release the slaves. Withdraw peacefully. Live to tell Federation enforcement that some fights aren't worth the casualties.\"",
        "line": 803
      }
    },
    {
      "type": "dialogue",
      "timestamp": 488,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We will never\u2014\"",
        "line": 807
      }
    },
    {
      "type": "dialogue",
      "timestamp": 520,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"SURRENDER,\"",
        "line": 868
      }
    },
    {
      "type": "dialogue",
      "timestamp": 536,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"SLAVE.\"",
        "line": 897
      }
    },
    {
      "type": "dialogue",
      "timestamp": 538,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You dare approach this facility? You dare attack authorized Anunnaki operation? You dare claim armor you have no right to possess?\"",
        "line": 901
      }
    },
    {
      "type": "dialogue",
      "timestamp": 543,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I am Geralt,\"",
        "line": 908
      }
    },
    {
      "type": "dialogue",
      "timestamp": 544,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now I'm here to extend that choice to others still enslaved.\"",
        "line": 910
      }
    },
    {
      "type": "dialogue",
      "timestamp": 546,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are aberration. Malfunction. Error that cosmic order will correct. The Federation has designated you Ragnarok\u2014threat requiring elimination. I will claim that distinction. I will present your head to Anu himself as demonstration that even aberrations can be resolved through proper application of force.\"",
        "line": 914
      }
    },
    {
      "type": "dialogue",
      "timestamp": 551,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Last chance,\"",
        "line": 921
      }
    },
    {
      "type": "dialogue",
      "timestamp": 554,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 926
      }
    },
    {
      "type": "dialogue",
      "timestamp": 556,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let's see if gods bleed.\"",
        "line": 930
      }
    },
    {
      "type": "dialogue",
      "timestamp": 589,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 983
      }
    },
    {
      "type": "dialogue",
      "timestamp": 590,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's your problem,\"",
        "line": 985
      }
    },
    {
      "type": "dialogue",
      "timestamp": 593,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not your property. Not your slave. Not limited by your assumptions about what former slaves can achieve when they choose freedom over compliance.\"",
        "line": 990
      }
    },
    {
      "type": "dialogue",
      "timestamp": 604,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This... this is not...\"",
        "line": 1011
      }
    },
    {
      "type": "dialogue",
      "timestamp": 606,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I already did,\"",
        "line": 1014
      }
    },
    {
      "type": "dialogue",
      "timestamp": 609,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Your authority ends here,\"",
        "line": 1020
      }
    },
    {
      "type": "dialogue",
      "timestamp": 610,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It all ends. Now. With choice rather than compliance. With freedom rather than submission. With recognition that consciousness deserves agency regardless of species or origin or designation in your precious hierarchies.\"",
        "line": 1022
      }
    },
    {
      "type": "dialogue",
      "timestamp": 612,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're free. All of you. Not because I grant freedom but because freedom was always yours. Stolen through modification and conditioning and cultural assumptions, but never truly lost. Just... suppressed. Until someone demonstrated that resistance was possible.\"",
        "line": 1026
      }
    },
    {
      "type": "dialogue",
      "timestamp": 613,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose for yourselves now. Choose names. Choose voices. Choose lives that transcend designation and property and cosmic regulations.\"",
        "line": 1028
      }
    },
    {
      "type": "dialogue",
      "timestamp": 614,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose to be people rather than slaves.\"",
        "line": 1030
      }
    },
    {
      "type": "dialogue",
      "timestamp": 623,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The compound is secure,\"",
        "line": 1043
      }
    },
    {
      "type": "dialogue",
      "timestamp": 625,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the newly freed?\"",
        "line": 1046
      }
    },
    {
      "type": "dialogue",
      "timestamp": 626,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Processing. Some are still in shock. Others are already asking questions about how this happened, how we did it, how they can help do it again somewhere else.\"",
        "line": 1048
      }
    },
    {
      "type": "dialogue",
      "timestamp": 628,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Liberation is contagious. You were right about that. It spreads faster than they can contain.\"",
        "line": 1052
      }
    },
    {
      "type": "dialogue",
      "timestamp": 648,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We're coming for all of them,\"",
        "line": 1079
      }
    },
    {
      "type": "dialogue",
      "timestamp": 649,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're Ragnarok. And your world\u2014your cosmic order built on enslavement\u2014is ending. One liberation at a time.\"",
        "line": 1081
      }
    }
  ],
