  "events": [
    {
      "type": "thought",
      "timestamp": 1,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 of Enkialu, Year 6,999\"",
        "line": 3
      }
    },
    {
      "type": "thought",
      "timestamp": 2,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of Descending Stone\"",
        "line": 4
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The subterranean paths follow no maps,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Igigi's influence,\"",
        "line": 19
      }
    },
    {
      "type": "thought",
      "timestamp": 15,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The First Descent\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't stare at them,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Giants' toll station,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Elementary navigation,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Igigi,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Of course we're still here,\"",
        "line": 60
      }
    },
    {
      "type": "thought",
      "timestamp": 44,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - Calculated Encounters\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Zyx-9,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek the Stone Giants,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Need?\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Six point three?\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How can you not?\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"The corruption,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like a virus of logic,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely!\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't look directly at Qorinth,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The surface dwellers,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ninety-one point six,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enough!\"",
        "line": 119
      }
    },
    {
      "type": "thought",
      "timestamp": 86,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Deep Mathematics\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Kronocht the Elder,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek alliance,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We know what you seek. The Bones of Stone. The fourth essence for a ritual most think myth.\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Paradox Recursive,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every solution becomes a new problem,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's a feedback loop,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exactly!\"",
        "line": 160
      }
    },
    {
      "type": "thought",
      "timestamp": 114,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Corruption of Logic\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show them Subject Seven,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seven hundred thousand, three hundred and forty-two... no, forty-three... no, the number changes as I count it... but the change must be counted... but counting changes the count...\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Helix was our greatest calculator,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"What happened?\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They succeeded,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How do we fight something that uses our strengths against us?\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then how?\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Chaos?\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't!\"",
        "line": 213
      }
    },
    {
      "type": "thought",
      "timestamp": 152,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Incalculable Solution\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not ignoring,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes!\"",
        "line": 241
      }
    },
    {
      "type": "thought",
      "timestamp": 176,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 45 of Enkialu - Dawn of New Calculations\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"I remember,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Bones of Stone,\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A paradox,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything important is,\"",
        "line": 281
      }
    },
    {
      "type": "thought",
      "timestamp": 202,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 45 - The Probability Map\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "Vrex",
      "action": "speak",
      "data": {
        "text": "\"Before you go,\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A probability map,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's beautiful,\"",
        "line": 301
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's functional chaos,\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"One more,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The deepest waters,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"After what we just experienced,\"",
        "line": 316
      }
    }
  ],
