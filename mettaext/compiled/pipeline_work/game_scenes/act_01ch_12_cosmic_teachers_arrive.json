{
  "scene_id": "act_01ch_12_cosmic_teachers_arrive",
  "description": "Chapter 12: The Cosmic Teachers Arrive",
  "entities": [],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's not just power\u2014it's communication,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And what is it saying?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That change is coming,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ah,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Young Moon-daughter,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have waited so long for this moment,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The foundation must be laid,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Passion and will forge the crown,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wisdom flows on the winds of change,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The bridge between worlds awaits your choice,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do you want from them?\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We want nothing,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your daughter is safe, Captain of Iron,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You're going to teach them magic?\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magic is not taught, young guardian,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But first,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water and flow, earth and foundation, fire and will, air and wisdom, spirit and connection,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Depths,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Roots,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Forge,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Clarity,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Unity,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about us?\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Your courage has earned you witness to beginnings, child,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We'll watch,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix!\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Veshtari elun draconis...\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Curious,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are a Dual-Souled Catalyst,\"",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're leaving. Now,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Remember this spark, child,\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Guardian\u2014your trial lies on the horizon. Seek it,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now\u2014begin in earnest,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"But which trial?\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Green,\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wisdom speaks through the youngest voice,\"",
        "line": 336
      }
    }
  ],
