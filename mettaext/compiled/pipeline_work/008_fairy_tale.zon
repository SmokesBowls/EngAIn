@id: scene.008_fairy_tale
@when: Unknown.scene_008_fairy_tale
@where: Realm/Physical/Unknown
@scope: narrative

=segments:
  - line: 1
    type: narration
    text: "Once upon a time, a big golden queen from the stars came to Earth."
  - line: 2
    type: narration
    text: "She wanted to build tall towers, but some giant green rock people lived there."
  - line: 3
    type: narration
    text: "They didn't want her to build."
  - line: 4
    type: narration
    text: "The queen tried to fight them, but it was too hard."
  - line: 5
    type: narration
    text: "So she made a sneaky plan."
  - line: 7
    type: narration
    text: "She told little lies to the rock people."
  - line: 8
    type: narration
    text: "Lies like: \"The ocean giants are making bad weather for desert giants.\" Or: \"Forest giants want to take mountain giants' homes.\" These weren't true, but she made them sound true."
  - line: 10
    type: narration
    text: "The rock people started believing the lies."
  - line: 11
    type: narration
    text: "They got mad at each other instead of the star queen."
  - line: 12
    type: narration
    text: "Slowly, over many years, they stopped being friends."
  - line: 13
    type: narration
    text: "The queen smiled because now she could build her towers without fighting."
  - line: 15
    type: narration
    text: "It's a sad story about how lies can break friendships, even between big strong rock people."

=inferred:

=narrative:
  "008_fairy_tale - 15 segments"
  blank: 3
  narration: 12