      "action": "think",
      "data": {
        "text": "\"Zoup zoup zoup.\"",
        "line": 61
      }
    },
    {
      "type": "thought",
      "timestamp": 163,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Prime.* The impression arrived like crystalline chime resonating through Senareth's awareness. Not words, but meaning compressed into pure sensation. The Aeon Keepers, reaching across dimensions to designate role and responsibility. *You are Prime. Coordinate. Understand. Bridge.\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Listen,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are here to help them,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're running from us,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Gather the others,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Why?\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"The energy signatures,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"Remembers what?\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know yet,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we need to show them we're not what they remember,\"",
        "line": 239
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We wait,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 259,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"And if they're never ready?\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We give it time,\"",
        "line": 276
      }
    },
    {
      "type": "thought",
      "timestamp": 297,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"To be continued in Part 3: First Contact\"",
        "line": 298
      }
    }
