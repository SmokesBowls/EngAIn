from __future__ import annotations

from collections.abc import Iterable

from engain_control.gate_result import GateResult


def print_gate(script_name: str, result: GateResult) -> None:
    dots = "." * max(1, 32 - len(result.gate_name))
    print(f"  {result.gate_name} {dots} {result.passed} - {result.message}")


def print_script_result(script_name: str, results: Iterable[GateResult]) -> bool:
    result_list = list(results)

    # PRODUCTION RULE: SKIPPED is a non-failing bypass. 
    # A script passes if all gates are either TRUE or SKIPPED.
    script_passed = all(
        gate.passed in ("TRUE", "SKIPPED")
        for gate in result_list
    )

    final_state = "TRUE" if script_passed else "FALSE"
    print(f"{script_name} RESULT: {final_state}")
    print("")

    return script_passed


def run_script_gates(script_name: str, gates: list) -> bool:
    print(script_name)

    results: list[GateResult] = []

    for gate in gates:
        try:
            result = gate()
        except Exception as exc:
            # A crash is always a FALSE, never a SKIPPED.
            result = GateResult(
                gate_name=gate.__name__,
                passed="FALSE",
                message=f"Gate crashed: {type(exc).__name__}: {exc}",
            )

        results.append(result)
        print_gate(script_name, result)

    return print_script_result(script_name, results)