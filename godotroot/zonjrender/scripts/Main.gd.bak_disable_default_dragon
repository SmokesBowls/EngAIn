extends Node

const ENTITY_SCENE: PackedScene = preload("res://entities/TrixelEntity3D.tscn")
const DEFAULT_AVATAR_SCENE: String = "res://assets/EngAInDragon3d.tscn"

@export_file("*.json") var scene_json_path: String = ""
@export var spawn_default_if_empty: bool = false
@export var runtime_entities_node_name: String = "RuntimeEntities"

@onready var bridge: Node = get_node_or_null("DragonAvatar3D/EngAInBridge")

var _runtime_entities_root: Node3D

func _ready() -> void:
	print("[MAIN] Loaded. Bridge at:", bridge.get_path() if bridge != null else "<missing>")
	_runtime_entities_root = _ensure_runtime_entities_root()

	if scene_json_path != "":
		var ok: bool = _load_and_spawn_scene(scene_json_path)
		if not ok and spawn_default_if_empty:
			_spawn_default_dragon()
	elif spawn_default_if_empty:
		_spawn_default_dragon()

func _ensure_runtime_entities_root() -> Node3D:
	var existing: Node = get_node_or_null(runtime_entities_node_name)
	if existing != null and existing is Node3D:
		return existing as Node3D

	var world: Node = get_node_or_null("World")
	if world != null and world is Node3D:
		var root_under_world: Node = world.get_node_or_null(runtime_entities_node_name)
		if root_under_world != null and root_under_world is Node3D:
			return root_under_world as Node3D

		var spawned_root: Node3D = Node3D.new()
		spawned_root.name = runtime_entities_node_name
		(world as Node3D).add_child(spawned_root)
		return spawned_root

	var root: Node3D = Node3D.new()
	root.name = runtime_entities_node_name
	add_child(root)
	return root

func _load_and_spawn_scene(json_path: String) -> bool:
	if not FileAccess.file_exists(json_path):
		push_warning("[MAIN] Scene JSON not found: %s" % json_path)
		return false

	var text: String = FileAccess.get_file_as_string(json_path)
	if text.is_empty():
		push_warning("[MAIN] Scene JSON empty: %s" % json_path)
		return false

	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("[MAIN] Scene JSON parse failed: %s" % json_path)
		return false

	var data: Dictionary = parsed as Dictionary
	_clear_runtime_entities()

	var entities: Array = data.get("entities", []) as Array
	if entities.is_empty():
		push_warning("[MAIN] No entities in scene JSON: %s" % json_path)
		return false

	for entity_data: Variant in entities:
		if entity_data is Dictionary:
			_spawn_entity_from_data(entity_data as Dictionary)

	print("[MAIN] Spawned %d entities from %s" % [entities.size(), json_path])
	return true

func _spawn_entity_from_data(entity_data: Dictionary) -> void:
	var entity_instance: Node = ENTITY_SCENE.instantiate()
	if entity_instance == null:
		push_warning("[MAIN] Failed to instantiate res://entities/TrixelEntity3D.tscn")
		return

	_runtime_entities_root.add_child(entity_instance)

	var entity_id: String = String(entity_data.get("id", "entity"))
	var display_name: String = String(entity_data.get("name", entity_id))
	var position_variant: Variant = entity_data.get("position", {"x": 0.0, "y": 0.0, "z": 0.0})
	var position_data: Dictionary = position_variant as Dictionary

	var plan: Dictionary = {
		"id": entity_id,
		"entity_id": entity_id,
		"display_name": display_name,
		"position": position_data,
		"render_mode": "scene_instance",
		"scene_ref": DEFAULT_AVATAR_SCENE,
		"scene_scale": {"x": 1.0, "y": 1.0, "z": 1.0},
		"scene_offset": {"x": 0.0, "y": 0.0, "z": 0.0},
		"scene_rotation": {"x": 0.0, "y": 0.0, "z": 0.0},
		"collision_profile": "character_medium",
		"interaction_radius": 1.5,
		"shadow_mode": "projected"
	}

	if entity_instance.has_method("apply_render_plan"):
		entity_instance.call("apply_render_plan", plan)
	else:
		push_warning("[MAIN] TrixelEntity3D missing apply_render_plan(): %s" % entity_id)

func _spawn_default_dragon() -> void:
	_clear_runtime_entities()

	var entity_instance: Node = ENTITY_SCENE.instantiate()
	if entity_instance == null:
		push_warning("[MAIN] Failed to instantiate default 3D entity scene")
		return

	_runtime_entities_root.add_child(entity_instance)

	var default_plan: Dictionary = {
		"id": "engain_dragon",
		"entity_id": "engain_dragon",
		"display_name": "EngAIn Dragon",
		"position": {"x": 0.0, "y": 0.0, "z": 0.0},
		"render_mode": "scene_instance",
		"scene_ref": DEFAULT_AVATAR_SCENE,
		"scene_scale": {"x": 1.0, "y": 1.0, "z": 1.0},
		"scene_offset": {"x": 0.0, "y": 0.0, "z": 0.0},
		"scene_rotation": {"x": 0.0, "y": 0.0, "z": 0.0},
		"collision_profile": "character_medium",
		"interaction_radius": 1.5,
		"shadow_mode": "projected"
	}

	if entity_instance.has_method("apply_render_plan"):
		entity_instance.call("apply_render_plan", default_plan)

	print("[MAIN] Spawned default EngAIn Dragon")

func _clear_runtime_entities() -> void:
	if _runtime_entities_root == null:
		return

	for child: Node in _runtime_entities_root.get_children():
		child.queue_free()
