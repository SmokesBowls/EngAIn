  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Five Void Spires confirmed across the stellar network,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But Earth should have one too,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So where is it?\"",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hidden,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to triangulate,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Already tried,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about the Star Needle?\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Forgotten Valley,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then that's where we look,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll prepare the airship,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I'll gather the necessary equipment,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"You've changed,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"So has Ironspire,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magic was freedom,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what are you now?\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You understand null states,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The space between definitions,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perception filters,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The null state pushes back,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"So how do we find something that doesn't want to be found?\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We don't find it,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't fight it,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"It's beautiful,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's dangerous,\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not uncontrolled,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I am Luminara,\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need your help,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Earth Spire can serve as an anchor,\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"They already know,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"What plans?\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The red curse within his blood. She means to activate it, to transform him into her anchor for controlling the entire network. If she succeeds...\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need everyone,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "Nefaretti",
      "action": "speak",
      "data": {
        "text": "\"The Giants will come,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Ironspire's forces,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild stands ready,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One day. Perhaps two. The calculations are complex when dealing with corrupted nodes.\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we have that long to gather our forces,\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "Luminara",
      "action": "speak",
      "data": {
        "text": "\"You interest me,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"I became what I needed to become,\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "Luminara",
      "action": "speak",
      "data": {
        "text": "\"And what will you become next?\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The connection is established,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And our people there? Vi\u00ean, Keen, Rongtai?\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean is... changing. The red curse grows stronger with each hour. But he resists still.\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Then we'd better make it count,\"",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Indeed,\"",
        "line": 266
      }
    }
  ],
