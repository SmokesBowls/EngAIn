  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Not ingenuity,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Without my parents,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything you see was built by skill, determination, and ingenuity,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're free to move about the city,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Be careful what you go looking for, young scholar,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Some questions,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Living censorship,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's... beautiful,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Payment for discipline,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oh! Are you here for the library too?\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I found it in the ruins beneath Echo Temple during one of our family expeditions,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Older than orthodox chronology?\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've read references to that site,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Papa thinks it might date back to the First Kingdom,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Though if you're interested in really old things,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Unreadable symbols?\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Here we are,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Most of these were found during construction projects around the city,\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They're beautiful,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I need to study this,\"",
        "line": 295
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra and I can explore the upper levels,\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Watch the candle, little one,\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix,\"",
        "line": 344
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't understand!\"",
        "line": 349
      }
    },
    {
      "type": "dialogue",
      "timestamp": 237,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But why won't it work for me?\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will I really be able to make fire dance?\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When will that be?\"",
        "line": 385
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They knew,\"",
        "line": 440
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I need to find Keen,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Something's different about you,\"",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 323,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ooh, scholarly secrets!\"",
        "line": 491
      }
    },
    {
      "type": "dialogue",
      "timestamp": 331,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Of course,\"",
        "line": 503
      }
    },
    {
      "type": "dialogue",
      "timestamp": 348,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue,\"",
        "line": 527
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"More than knew about it,\"",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which means they weren't just farmers who happened to take you in,\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The sphere,\"",
        "line": 546
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You felt something,\"",
        "line": 550
      }
    },
    {
      "type": "dialogue",
      "timestamp": 381,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Has anyone seen my daughter?\"",
        "line": 580
      }
    }
  ],
