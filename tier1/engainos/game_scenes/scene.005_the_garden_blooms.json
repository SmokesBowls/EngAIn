      "action": "speak",
      "data": {
        "text": "\"Expansion coefficient miscalculation,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"So we adjust,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not discouraged,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Accidental discovery,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We built a garden by accident,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's the geometry,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"This is what we build when fear doesn't rule us,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Natural architecture,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're building the network,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"We built this,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers built it,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are we?\"",
        "line": 271
      }
    }
