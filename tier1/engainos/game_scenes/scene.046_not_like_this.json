  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cOne more,\u201d",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey know we\u2019re coming.\u201d",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey know three encampments have gone dark. They\u2019ll be ready. Not complacent. Not sloppy. Ready.\u201d",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s the only idea,\u201d",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cYes,\u201d",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll find out,\u201d",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cThey also know the odds,\u201d",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen they know this is what we are. This is the line. One more. Then we rest.\u201d",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ve had time to prepare,\u201d",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cTwo hundred and ninety,\u201d",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCould infiltrate,\u201d",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cScans show the core\u2019s deep inside the central tower,\u201d",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cThen we don\u2019t use our pattern,\u201d",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou\u2019re joking,\u201d",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "Kress",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019ll have the walls fortified, the approaches mined,\u201d",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYes,\u201d",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cExactly. While the main force is tangling at the gate, a small team\u2014five, six max\u2014goes in here.\u201d",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cThe team in the conduit will be trapped,\u201d",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey will,\u201d",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019ll lead the diversion,\u201d",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAbsolutely not\u2014\u201d",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s the right tactical choice, Geralt, and you know it.\u201d",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI know.\u201d",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIf you\u2019re late\u2026\u201d",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we die in the pipes, and you die at the gate, and the slaves stay in chains.\u201d",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLEGION! WITH ME!\u201d",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cKEEP MOVING! DON\u2019T STOP!\u201d",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSir! Left flank!\u201d",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "Kress",
      "action": "speak",
      "data": {
        "text": "\u201cOh, gods,\u201d",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cScatter!\u201d",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOT. LIKE. THIS.\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOT. LIKE. THIS.\"",
        "line": 358
      }
    },
    {
      "type": "dialogue",
      "timestamp": 321,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FLY!\"",
        "line": 433
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WITH THE COMMANDER! FOR THE LEGION!\"",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can we fly?\"",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 389,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThey don\u2019t fly,\u201d",
        "line": 526
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGood enough.\u201d",
        "line": 528
      }
    },
    {
      "type": "dialogue",
      "timestamp": 395,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGet the slaves clear,\u201d",
        "line": 535
      }
    },
    {
      "type": "dialogue",
      "timestamp": 415,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou break the vessels, but the wine is already spilled.\u201d",
        "line": 562
      }
    },
    {
      "type": "dialogue",
      "timestamp": 418,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI did not conquer time. I became it.\u201d",
        "line": 567
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\u201cTake down the golems!\u201d",
        "line": 592
      }
    },
    {
      "type": "dialogue",
      "timestamp": 445,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHe\u2019s only healing if we attack from one angle!\u201d",
        "line": 603
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cClever weed.\u201d",
        "line": 622
      }
    },
    {
      "type": "dialogue",
      "timestamp": 467,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou cherish your past choices. Let us see which one you cannot live without.\u201d",
        "line": 633
      }
    },
    {
      "type": "dialogue",
      "timestamp": 483,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGeralt!\u201d",
        "line": 655
      }
    },
    {
      "type": "dialogue",
      "timestamp": 501,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe shield!\u201d",
        "line": 679
      }
    },
    {
      "type": "dialogue",
      "timestamp": 511,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to align them!\u201d",
        "line": 692
      }
    },
    {
      "type": "dialogue",
      "timestamp": 519,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cMika! Grenn! Everyone! Scar the glyphs! Break the patterns! Don\u2019t destroy\u2014alter!\u201d",
        "line": 703
      }
    },
    {
      "type": "dialogue",
      "timestamp": 529,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cYou introduce\u2026 noise.\u201d",
        "line": 717
      }
    },
    {
      "type": "dialogue",
      "timestamp": 535,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI offer you a perfect future, Geralt of the Dragon. The one you secretly crave.\u201d",
        "line": 726
      }
    },
    {
      "type": "dialogue",
      "timestamp": 549,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThis is logical. This is optimal. Why choose suffering?\u201d",
        "line": 743
      }
    },
    {
      "type": "dialogue",
      "timestamp": 561,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cI reject your future,\u201d",
        "line": 760
      }
    },
    {
      "type": "dialogue",
      "timestamp": 579,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI am\u2026 removed from the equation. Alive\u2026 but irrelevant.\u201d",
        "line": 786
      }
    },
    {
      "type": "dialogue",
      "timestamp": 584,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGET CLEAR!\u201d",
        "line": 794
      }
    },
    {
      "type": "dialogue",
      "timestamp": 597,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cSoon,\u201d",
        "line": 813
      }
    }
  ],
