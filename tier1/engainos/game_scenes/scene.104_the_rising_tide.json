      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s coming,\u201d",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHow bad?\u201d",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBad enough.\u201d",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe prepare,\u201d",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019ll take Sera,\u201d",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cBring them home,\u201d",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cHow far?\u201d",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cAnother day,\u201d",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe knew someone would come,\u201d",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cHow many?\u201d",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAbout a dozen. Started with nearly thirty. Lost the others to the cliffs, to the giants, to\u2026\u201d",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to move,\u201d",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to go. Now.\u201d",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe exit is blocked!\u201d",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThere,\u201d",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cWe don\u2019t know where it goes,\u201d",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWe don\u2019t have a choice.\u201d",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "Theran",
      "action": "speak",
      "data": {
        "text": "\u201cWhat is this place?\u201d",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to keep moving,\u201d",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSera!\u201d",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to get down,\u201d",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re coming! Open the gate!\u201d",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cAll of them,\u201d",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAnd you.\u201d",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cLater,\u201d",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s holding,\u201d",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt will last as long as it lasts.\u201d",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cHave we?\u201d",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWhat did you find?\u201d",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWaiting for what?\u201d",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFor us. For the right song.\u201d",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s holding,\u201d",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBarely.\u201d",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cWe need more heat,\u201d",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe burn them,\u201d",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cThe fissure is clear,\u201d",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cSera goes,\u201d",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cAgreed.\u201d",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cFor what?\u201d",
        "line": 375
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFor the right voice. The right song.\u201d",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat?\u201d",
        "line": 385
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s aware. Not awake, but aware. It knows we\u2019re here.\u201d",
        "line": 388
      }
    },
    {
      "type": "dialogue",
      "timestamp": 263,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cWe should go,\u201d",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe come back,\u201d",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cMore than we\u2019ve ever seen at once,\u201d",
        "line": 447
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re testing,\u201d",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re waiting for something,\u201d",
        "line": 459
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to find survivors,\u201d",
        "line": 466
      }
    },
    {
      "type": "dialogue",
      "timestamp": 312,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019ll need scouts,\u201d",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 313,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we start with scouts,\u201d",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cCan you do it? Call to them? Let them know we\u2019re here?\u201d",
        "line": 475
      }
    },
    {
      "type": "dialogue",
      "timestamp": 321,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen sing.\u201d",
        "line": 482
      }
    },
    {
      "type": "dialogue",
      "timestamp": 333,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey heard. They\u2019re coming.\u201d",
        "line": 500
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe grove giants are moving,\u201d",
        "line": 523
      }
    },
    {
      "type": "dialogue",
      "timestamp": 349,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWhat kind of structures?\u201d",
        "line": 526
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI don\u2019t know. But they\u2019re organized. They have leaders. The smaller ones take orders from the bigger ones, and they all work together. If they decide to come at us again\u2026\u201d",
        "line": 528
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to make a decision,\u201d",
        "line": 536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThe grove giants are the most intelligent,\u201d",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cOr maybe they\u2019re the ones we should fear most,\u201d",
        "line": 540
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cThen we show them,\u201d",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cHow?\u201d",
        "line": 550
      }
    },
    {
      "type": "dialogue",
      "timestamp": 371,
      "actor": "Darian",
      "action": "speak",
      "data": {
        "text": "\u201cAnd if they don\u2019t?\u201d",
        "line": 559
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThen we try again. And again. Until they understand.\u201d",
        "line": 561
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe try,\u201d",
        "line": 568
      }
    },
    {
      "type": "dialogue",
      "timestamp": 381,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cSpring is here,\u201d",
        "line": 574
      }
    },
    {
      "type": "dialogue",
      "timestamp": 389,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not attacking,\u201d",
        "line": 587
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re watching,\u201d",
        "line": 589
      }
    },
    {
      "type": "dialogue",
      "timestamp": 394,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cRenn\u2019s scouts say they\u2019ve built something in the highlands,\u201d",
        "line": 595
      }
    },
    {
      "type": "dialogue",
      "timestamp": 399,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to make contact,\u201d",
        "line": 602
      }
    },
    {
      "type": "dialogue",
      "timestamp": 400,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cSera\u2019s been practicing,\u201d",
        "line": 604
      }
    },
    {
      "type": "dialogue",
      "timestamp": 403,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cTomorrow,\u201d",
        "line": 609
      }
    },
    {
      "type": "dialogue",
      "timestamp": 447,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re leaving,\u201d",
        "line": 673
      }
    },
    {
      "type": "dialogue",
      "timestamp": 448,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cNot leaving,\u201d",
        "line": 675
      }
    },
    {
      "type": "dialogue",
      "timestamp": 451,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat did you say to them?\u201d",
        "line": 680
      }
    },
    {
      "type": "dialogue",
      "timestamp": 462,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re agitated,\u201d",
        "line": 697
      }
    },
    {
      "type": "dialogue",
      "timestamp": 468,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cOr desperate,\u201d",
        "line": 705
      }
    },
    {
      "type": "dialogue",
      "timestamp": 469,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cHeard it how?\u201d",
        "line": 707
      }
    },
    {
      "type": "dialogue",
      "timestamp": 478,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThe chamber,\u201d",
        "line": 719
      }
    },
    {
      "type": "dialogue",
      "timestamp": 479,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe fissure is clear,\u201d",
        "line": 721
      }
    },
    {
      "type": "dialogue",
      "timestamp": 498,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWhat is it?\u201d",
        "line": 748
      }
    },
    {
      "type": "dialogue",
      "timestamp": 499,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe heart,\u201d",
        "line": 750
      }
    },
    {
      "type": "dialogue",
      "timestamp": 526,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cWe need to go,\u201d",
        "line": 788
      }
    },
    {
      "type": "dialogue",
      "timestamp": 530,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWhat did you see?\u201d",
        "line": 795
      }
    },
    {
      "type": "dialogue",
      "timestamp": 535,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cThe Keeper,\u201d",
        "line": 802
      }
    },
    {
      "type": "dialogue",
      "timestamp": 538,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cThen we keep singing,\u201d",
        "line": 807
      }
    },
    {
      "type": "dialogue",
      "timestamp": 561,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cWe\u2019re going to need a name for this place,\u201d",
        "line": 839
      }
    },
    {
      "type": "dialogue",
      "timestamp": 564,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cSeems like a lot of work for a garden.\u201d",
        "line": 844
      }
    },
    {
      "type": "dialogue",
      "timestamp": 566,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe best gardens are.\u201d",
        "line": 847
      }
    },
    {
      "type": "dialogue",
      "timestamp": 572,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cIt\u2019s beginning,\u201d",
        "line": 856
      }
    },
    {
      "type": "dialogue",
      "timestamp": 593,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe grove giants,\u201d",
        "line": 886
      }
    },
    {
      "type": "dialogue",
      "timestamp": 599,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHow many?\u201d",
        "line": 894
      }
    },
    {
      "type": "dialogue",
      "timestamp": 600,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHard to say. Dozens. Maybe more.\u201d",
        "line": 896
      }
    },
    {
      "type": "dialogue",
      "timestamp": 609,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cNot against us,\u201d",
        "line": 911
      }
    },
    {
      "type": "dialogue",
      "timestamp": 613,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe swamp giants are watching,\u201d",
        "line": 917
      }
    },
    {
      "type": "dialogue",
      "timestamp": 617,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re going to fight,\u201d",
        "line": 923
      }
    },
    {
      "type": "dialogue",
      "timestamp": 618,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cCan we stop them?\u201d",
        "line": 925
      }
    },
    {
      "type": "dialogue",
      "timestamp": 619,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\u201cWe barely understand them,\u201d",
        "line": 927
      }
    },
    {
      "type": "dialogue",
      "timestamp": 622,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cSera,\u201d",
        "line": 932
      }
    },
    {
      "type": "dialogue",
      "timestamp": 630,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cCan we talk to them?\u201d",
        "line": 942
      }
    },
    {
      "type": "dialogue",
      "timestamp": 636,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat kind of sign?\u201d",
        "line": 950
      }
    },
    {
      "type": "dialogue",
      "timestamp": 645,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cWe don\u2019t have weeks,\u201d",
        "line": 962
      }
    },
    {
      "type": "dialogue",
      "timestamp": 646,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNo,\u201d",
        "line": 964
      }
    },
    {
      "type": "dialogue",
      "timestamp": 653,
      "actor": "Teryn",
      "action": "speak",
      "data": {
        "text": "\u201cWe do it tomorrow,\u201d",
        "line": 973
      }
    },
    {
      "type": "dialogue",
      "timestamp": 661,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cSing what you know,\u201d",
        "line": 986
      }
    },
    {
      "type": "dialogue",
      "timestamp": 694,
      "actor": "Renn",
      "action": "speak",
      "data": {
        "text": "\u201cThe ones who want to protect the needle,\u201d",
        "line": 1036
      }
    },
    {
      "type": "dialogue",
      "timestamp": 695,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\u201cWhat do they want?\u201d",
        "line": 1038
      }
    },
    {
      "type": "dialogue",
      "timestamp": 704,
      "actor": "Sera",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re asking for help,\u201d",
        "line": 1050
      }
    },
    {
      "type": "dialogue",
      "timestamp": 707,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cOpen the gate,\u201d",
        "line": 1055
      }
    }
  ],
