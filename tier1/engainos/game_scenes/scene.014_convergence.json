  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When it begins,\"",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Easy to say when you're at the center where conditions are balanced,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 25,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Begin the convergence,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hold!\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Tidecallers caused this,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert tribes made it worse,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ALL OF YOU made this necessary,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We acknowledge summoning,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Targets identified. Commencing purification operations.\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You killed our allies,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They were Anunnaki constructs,\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If the ASH GIANTS hadn't been so WEAK,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH!\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm breaking connection,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WAIT\u2014\"",
        "line": 167
      }
    }
  ],
