    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You felt it too,\"",
        "line": 9
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"A falling star,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"We care,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"South-southwest,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert is always uncooperative,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We rest here,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Survivors,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torn",
      "action": "speak",
      "data": {
        "text": "\"Then we'd better hurry,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra Tidecaller,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Sage Zephyr,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As did we.\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If help is possible,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Your friendship is gift enough,\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will be done.\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good people,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The best often are,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Territorial,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And stupid,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Buttholes,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Always have been,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Philosophy later. Walking now.\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mountain Giants,\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the crash site\u2014\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014will still be there. Your people won't appreciate a lowland giant arriving with an unknown mage and ignoring diplomatic courtesy. Go. Explain we mean no harm. Smooth the way.\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When have I ever?\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do you want the list chronologically or by severity?\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Help,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't... legs...\"",
        "line": 224
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll handle it.\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thank you,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Find shelter away from the fires. There are others who need help.\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What\u2014who\u2014don't take us back!\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who are you?\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Someone who finds it remarkable that you slept through a spaceship crash,\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did we...\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You did,\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 231,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Kael,\"",
        "line": 339
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How did YOU?\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're free,\"",
        "line": 350
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are likely dead, scattered, or dealing with their own problems,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Were,\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Roric. Look.\"",
        "line": 359
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\"We could build there,\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A home,\"",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You should go,\"",
        "line": 383
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Come on, Kael. Let's go build a home.\"",
        "line": 392
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You were one of his,\"",
        "line": 422
      }
    },
    {
      "type": "dialogue",
      "timestamp": 326,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Check the aft sections. Command said there might be salvage worth taking before the official teams arrive.\"",
        "line": 470
      }
    },
    {
      "type": "dialogue",
      "timestamp": 327,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Screw official teams. We were here first. Finder's keepers.\"",
        "line": 472
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hey! Someone's over here!\"",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's a body you're moving, old man.\"",
        "line": 490
      }
    },
    {
      "type": "dialogue",
      "timestamp": 340,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"An observation worthy of commendation,\"",
        "line": 492
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Dead bodies can have valuable gear.\"",
        "line": 494
      }
    },
    {
      "type": "dialogue",
      "timestamp": 343,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You will not.\"",
        "line": 497
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"'These specific dead?'\"",
        "line": 509
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These warriors deserve better than being stripped by scavengers.\"",
        "line": 512
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Warriors?\"",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I'm going to give you the same courtesy,\"",
        "line": 520
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Take him,\"",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 376,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What... what are you?\"",
        "line": 545
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Someone trying to do something important,\"",
        "line": 547
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're gone,\"",
        "line": 552
      }
    },
    {
      "type": "dialogue",
      "timestamp": 414,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Damn,\"",
        "line": 599
      }
    },
    {
      "type": "dialogue",
      "timestamp": 425,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt! By order of the Anunnaki Security Forces, halt and identify yourself!\"",
        "line": 616
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I said halt!\"",
        "line": 622
      }
    },
    {
      "type": "dialogue",
      "timestamp": 434,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're trespassing in a restricted salvage zone. This crash site is under Anunnaki jurisdiction until the official investigation is complete. You will surrender yourself for questioning regarding unauthorized presence and use of magical\u2014\"",
        "line": 630
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're him,\"",
        "line": 636
      }
    },
    {
      "type": "dialogue",
      "timestamp": 441,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These bodies. Why are you taking them?\"",
        "line": 642
      }
    },
    {
      "type": "dialogue",
      "timestamp": 442,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because they deserve better than to be catalogued as salvage.\"",
        "line": 644
      }
    },
    {
      "type": "dialogue",
      "timestamp": 446,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are you really going to finish that sentence?\"",
        "line": 650
      }
    },
    {
      "type": "dialogue",
      "timestamp": 453,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those bodies,\"",
        "line": 659
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll bring them to the proper authorities myself. After I've given them the rites they're owed.\"",
        "line": 662
      }
    },
    {
      "type": "dialogue",
      "timestamp": 456,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's not acceptable\u2014\"",
        "line": 664
      }
    },
    {
      "type": "dialogue",
      "timestamp": 457,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Counter-offer,\"",
        "line": 666
      }
    },
    {
      "type": "dialogue",
      "timestamp": 462,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've been pulling people out of wreckage while your forces were still organizing. Yes, I'm certain. Forward sections, decks three through six. Some are critical. Go. Now.\"",
        "line": 673
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You didn't see him,\"",
        "line": 678
      }
    },
    {
      "type": "dialogue",
      "timestamp": 467,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Forward sections, move out. Triple time.\"",
        "line": 682
      }
    },
    {
      "type": "dialogue",
      "timestamp": 469,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They will be. You have my word.\"",
        "line": 685
      }
    },
    {
      "type": "dialogue",
      "timestamp": 494,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You served him in life,\"",
        "line": 722
      }
    }
  ],
