  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's maddening,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't understand how to control it,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fragmentation,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Draco essence rebels against limitation,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which is why,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Young Master of Chaos,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Control is the illusion, young guardian. Flow is the truth. Watch.\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know how!\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time is not a river,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stop fighting,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then learn by letting go.\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Breathe with the current,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"While I learn flow,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your friend learns foundation,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together, you will be unstoppable,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Watch the portal,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But I didn't directly interfere, I just made a hopeful guess,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have a long way to go.. but the more rigid foundations you learned to should at least be able to show me the web around this moment,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The man or family who saved her as a child,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And forward?\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If she succeeds... the earth itself becomes her ally. Not just magic, but a living partnership that connects her to every growing thing on the planet. She becomes not just a queen but a living bridge between consciousness and creation.\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Well read,\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Flow mastery is only part of the foundation,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Move through the temporal maze,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Temporal Web,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time is not linear,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Understanding dawns,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Raw Draco essence without training is like trying to drink an ocean,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The first trial is complete,\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have learned the most fundamental truth of temporal guardianship: we do not control time\u2014we serve it. We help it flow toward outcomes that preserve growth, possibility, and hope.\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The student was ready to learn,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"How do you feel?\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201c\u2018Less fractured,\u2019 Vi\u00ean replied\u2026 \u2018for the moment, the noise has quieted.\u2019\u201d",
        "line": 264
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Foundation,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201c\u2018The first stabilization,\u2019 Voss observed cautiously. \"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Next, you learn foundation,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Temporal Foundation Grid,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She grows stronger with each trial,\"",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Foundation,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "Nyssa",
      "action": "speak",
      "data": {
        "text": "\"Understanding dawns,\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But that's tomorrow's lesson,\"",
        "line": 312
      }
    }
  ],
