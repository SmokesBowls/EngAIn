  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are conclusive,\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot?\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The fire burns,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Flight,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Run.\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In the fourteenth iteration of galactic seeding,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are extinct. Their worlds are ash. Their courage is remembered by no one, because no one survived to carry the memory forward. The Devourers consumed their civilization so completely that even their names were forgotten. Honor without survival is just... silence.\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"It survives,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki have detected our council session,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those who choose honor,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those who choose survival,\"",
        "line": 89
      }
    }
  ],
