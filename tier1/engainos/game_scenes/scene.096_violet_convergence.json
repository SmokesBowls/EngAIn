      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seek?\"",
        "line": 41
      }
    },
    {
      "type": "thought",
      "timestamp": 32,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Path of Infinite Selves\"",
