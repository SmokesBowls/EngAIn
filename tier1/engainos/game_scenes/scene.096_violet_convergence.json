    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fragment Bearer arrives,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We seek the final fragment,\"",
