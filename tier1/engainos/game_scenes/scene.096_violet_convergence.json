    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By understanding what each choice means,\"",
        "line": 75
      }
    },
    {
      "type": "thought",
      "timestamp": 53,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Five Convergences\"",
