    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The safe choice or the bold one,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We've come this far by taking risks,\"",
        "line": 143
      }
    },
    {
      "type": "thought",
      "timestamp": 103,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Violet Awakening\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To claim this fragment,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am...\"",
        "line": 175
      }
    },
    {
      "type": "thought",
      "timestamp": 123,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - Return to the World\"",
