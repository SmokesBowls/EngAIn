  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"The reports were accurate,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ironspire,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"But the Forest Giants haven't retaliated?\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They can't,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is worse than I expected,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Something's in pain,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those are vril extraction arrays,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to move,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"A Nephoretti,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"That's not possible,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Please,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Can you break them?\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not without killing the creature,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There has to be a way,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Isla,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know if I\u2014\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You can,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now, Lyra,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Thank you,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're the one from Ironspire,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Who?\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ironspire's researchers. The Circle of Progress.\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can you walk?\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I... I think so.\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"You'll come with us,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "one",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 188
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Send the secondaries,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I need a name,\"",
        "line": 196
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Names have power,\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sathinee,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Look,\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your very existence is antithetical to the void extraction,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to reach the Heartwood as quickly as possible,\"",
        "line": 230
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's all right,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"The Fifth Coming,\"",
        "line": 241
      }
    }
  ],
