  "events": [
    {
      "type": "thought",
      "timestamp": 2,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 of Enkialu, Year 6,999\"",
        "line": 4
      }
    },
    {
      "type": "thought",
      "timestamp": 3,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of Descending Stone\"",
        "line": 5
      }
    },
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The subterranean paths follow no maps,\"",
        "line": 12
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Igigi's influence,\"",
        "line": 20
      }
    },
    {
      "type": "thought",
      "timestamp": 16,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The First Descent\"",
        "line": 23
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't stare at them,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Giants' toll station,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Elementary navigation,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Igigi,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Of course we're still here,\"",
        "line": 61
      }
    },
    {
      "type": "thought",
      "timestamp": 45,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - Calculated Encounters\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Zyx-9,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek the Stone Giants,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Need?\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Six point three?\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How can you not?\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"The corruption,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like a virus of logic,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely!\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't look directly at Qorinth,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The surface dwellers,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ninety-one point six,\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enough!\"",
        "line": 120
      }
    },
    {
      "type": "thought",
      "timestamp": 87,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Deep Mathematics\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Kronocht the Elder,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek alliance,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We know what you seek. The Bones of Stone. The fourth essence for a ritual most think myth.\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption,\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Paradox Recursive,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every solution becomes a new problem,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's a feedback loop,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 113,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Exactly!\"",
        "line": 161
      }
    },
    {
      "type": "thought",
      "timestamp": 115,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Corruption of Logic\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show them Subject Seven,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seven hundred thousand, three hundred and forty-two... no, forty-three... no, the number changes as I count it... but the change must be counted... but counting changes the count...\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Helix was our greatest calculator,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"What happened?\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They succeeded,\"",
        "line": 184
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How do we fight something that uses our strengths against us?\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then how?\"",
        "line": 198
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Chaos?\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't!\"",
        "line": 214
      }
    },
    {
      "type": "thought",
      "timestamp": 153,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 44 - The Incalculable Solution\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not ignoring,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes!\"",
        "line": 242
      }
    },
    {
      "type": "thought",
      "timestamp": 177,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 45 of Enkialu - Dawn of New Calculations\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"I remember,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Bones of Stone,\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A paradox,\"",
        "line": 279
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything important is,\"",
        "line": 282
      }
    },
    {
      "type": "thought",
      "timestamp": 203,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 45 - The Probability Map\"",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "Vrex",
      "action": "speak",
      "data": {
        "text": "\"Before you go,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A probability map,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's beautiful,\"",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's functional chaos,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "Sathinee",
      "action": "speak",
      "data": {
        "text": "\"One more,\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The deepest waters,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"After what we just experienced,\"",
        "line": 317
      }
    }
  ],
