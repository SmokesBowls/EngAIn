  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Has anyone seen my daughter?\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We saw her earlier,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Near the main entrance,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Echo Temple?\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ancient ruins about an hour's ride north of the city,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what?\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We can help,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your men won't go there after dark,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Besides,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The ruins are spread across several acres,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That's how she found the sphere?\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three years ago, in what she insists was a hidden chamber beneath the central temple,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Captain,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because I can feel something,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"We don't fully understand what we are,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The ground,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"What do you mean?\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"It's... hollow,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Lyra!\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We need to split up,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Absolutely not,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's her,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sorry,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Focus on finding Lyra,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Here!\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Papa!\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "Ulric",
      "action": "speak",
      "data": {
        "text": "\"Just stay calm,\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I can't,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Captain, what do you see?\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A chamber,\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 207,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Papa, you have to see this!\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We have to get down there,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I said I couldn't control it,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Easy,\"",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That was different,\"",
        "line": 345
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra,\"",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But Papa, don't you see?\"",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 245,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Aeon Keepers,\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 275,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You carry the spark of earth magic, young one,\"",
        "line": 422
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"The sphere,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have been more than a guardian,\"",
        "line": 431
      }
    },
    {
      "type": "dialogue",
      "timestamp": 284,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it was not meant for you, faithful guardian,\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Me?\"",
        "line": 444
      }
    },
    {
      "type": "dialogue",
      "timestamp": 289,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I don't fully understand what's happening,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 302,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"What will it do to me?\"",
        "line": 467
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will awaken what sleeps within you,\"",
        "line": 469
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The choice is yours, daughter of two worlds,\"",
        "line": 474
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"My whole life,\"",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 317,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fear is wisdom,\"",
        "line": 490
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 533
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are you all right? You've been motionless for almost ten minutes.\"",
        "line": 536
      }
    },
    {
      "type": "dialogue",
      "timestamp": 351,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 543
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The earth magic,\"",
        "line": 553
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And what is it saying?\"",
        "line": 557
      }
    },
    {
      "type": "dialogue",
      "timestamp": 361,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"That change is coming,\"",
        "line": 560
      }
    },
    {
      "type": "dialogue",
      "timestamp": 365,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're all connected to this,\"",
        "line": 567
      }
    },
    {
      "type": "dialogue",
      "timestamp": 372,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The choice is before you,\"",
        "line": 578
      }
    },
    {
      "type": "dialogue",
      "timestamp": 376,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What would you choose?\"",
        "line": 584
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"I'm a scholar,\"",
        "line": 586
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lyra?\"",
        "line": 592
      }
    },
    {
      "type": "dialogue",
      "timestamp": 381,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Adventure!\"",
        "line": 594
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Together, then,\"",
        "line": 602
      }
    }
  ],
