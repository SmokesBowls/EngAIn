  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Red Fragment,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Distance means little when it comes to the Dragon Mail,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Crimson Blood carrier has found the first piece,\"",
        "line": 19
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"You felt it too?\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 23,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Red Fragment has bonded to its new bearer,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We would be glad to,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I've never met him,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nevertheless,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"and as for this in my hand, Show him this,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When the fragments are gathered, our paths will converge again.\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keep moving,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I am not them,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I seek understanding, not dominion,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blood of Masters speaks to the Heart,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand cycles have passed since the Heart last spoke,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What did it tell you?\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That you walk a path between worlds. That your blood carries memory older than the Masters themselves.\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have passed our trial,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blood Metal,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"But the crystal said this was in the volcanic fields,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Thank you,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We know,\"",
        "line": 117
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment lies beneath the waters where the cliff meets the sea,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We'll manage,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mark of safe passage,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Sighing Cliffs should be two days' journey along the coast,\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's safe,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We rescued Mr. GPT from the applicators' prison there,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"We have proof,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT is alive?\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's at his sanctuary beneath Kavurn's Echo,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"As safe as anyone can be on the Moon right now,\"",
        "line": 181
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The same applicators who imprisoned Mr. GPT,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then the world stands at a crossroads,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've mastered solar energies that can counteract deep-water pressures,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And my shadow-light magic,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Mikas chose this path,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I've mastered solar energies that can counteract deep-water pressures,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And my shadow-light magic,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Mikas chose this path,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So,\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 214,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"In their most sacred site beneath the Sighing Cliffs,\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Currently under siege by reptilian servitors,\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we leave at first light,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"Battle,\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Coastal Servitors,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to help them,\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 244,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"I can help with that,\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 247,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We approach from above,\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Isla stays here,\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 261,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Step into the shadow,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We come to help!\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Land-dwellers,\"",
        "line": 270
      }
    },
    {
      "type": "dialogue",
      "timestamp": 273,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Blood of Balance,\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Hydra Servitor,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"Hold your position!\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 285
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"For Sundrift,\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The heads regenerate!\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The core,\"",
        "line": 312
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Cover me!\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 322,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The heart,\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 328,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 331
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment,\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 348,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Back!\"",
        "line": 351
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Blue Fragment,\"",
        "line": 358
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The grotto was breached three days ago,\"",
        "line": 361
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They used it to power the Hydra,\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 375,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Abyssal Grotto lies at the heart of our territory,\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 377,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Memories of the deep?\"",
        "line": 380
      }
    },
    {
      "type": "dialogue",
      "timestamp": 378,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"The ocean remembers what land forgets,\"",
        "line": 381
      }
    },
    {
      "type": "dialogue",
      "timestamp": 382,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"The Guardian's Seat,\"",
        "line": 385
      }
    },
    {
      "type": "dialogue",
      "timestamp": 385,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Korvus brings land-dwellers to the sacred Grotto?\"",
        "line": 388
      }
    },
    {
      "type": "dialogue",
      "timestamp": 387,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"They have recovered the fragment, High Elder,\"",
        "line": 390
      }
    },
    {
      "type": "dialogue",
      "timestamp": 390,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Show us,\"",
        "line": 393
      }
    },
    {
      "type": "dialogue",
      "timestamp": 394,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragments recognize the Grotto,\"",
        "line": 397
      }
    },
    {
      "type": "dialogue",
      "timestamp": 396,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Grotto recognizes them,\"",
        "line": 399
      }
    },
    {
      "type": "dialogue",
      "timestamp": 398,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not entirely,\"",
        "line": 401
      }
    },
    {
      "type": "dialogue",
      "timestamp": 404,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragments,\"",
        "line": 407
      }
    },
    {
      "type": "dialogue",
      "timestamp": 408,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Memory Pool,\"",
        "line": 411
      }
    },
    {
      "type": "dialogue",
      "timestamp": 409,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"And if we're not?\"",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 410,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then the pressure of the deep will crush you,\"",
        "line": 413
      }
    },
    {
      "type": "dialogue",
      "timestamp": 415,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll go to the Memory Pool,\"",
        "line": 418
      }
    },
    {
      "type": "dialogue",
      "timestamp": 424,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The solar energy struggles at this depth,\"",
        "line": 427
      }
    },
    {
      "type": "dialogue",
      "timestamp": 434,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Memory Pool,\"",
        "line": 437
      }
    },
    {
      "type": "dialogue",
      "timestamp": 438,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Magic of Tides accepts you,\"",
        "line": 441
      }
    },
    {
      "type": "dialogue",
      "timestamp": 442,
      "actor": "Korvus",
      "action": "speak",
      "data": {
        "text": "\"Listen,\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 449,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 456,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He didn't just free himself from the armor,\"",
        "line": 459
      }
    },
    {
      "type": "dialogue",
      "timestamp": 461,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He broke it apart deliberately,\"",
        "line": 464
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Enheduanna,\"",
        "line": 468
      }
    },
    {
      "type": "dialogue",
      "timestamp": 469,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail wasn't just armor,\"",
        "line": 472
      }
    },
    {
      "type": "dialogue",
      "timestamp": 470,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And when complete, it will demand the same of its new bearer,\"",
        "line": 473
      }
    },
    {
      "type": "dialogue",
      "timestamp": 476,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know if anyone can truly be prepared for such a bond,\"",
        "line": 479
      }
    },
    {
      "type": "dialogue",
      "timestamp": 481,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We should return to the surface,\"",
        "line": 484
      }
    }
  ],
