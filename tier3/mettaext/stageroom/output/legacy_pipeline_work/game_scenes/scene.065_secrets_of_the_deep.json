    {
      "id": "tran",
      "name": "Tran",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 5,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These aren't natural caves,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hello!\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What are you?\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My primary function is to catalog, preserve, and share the chronicles of cosmic significance,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long is 'some time'?\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Approximately 20 years,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You knew someone named Mika?\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mika was...\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She died peacefully,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time flows strangely around bloodlines such as yours,\"",
        "line": 149
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Crimsonblood,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't be a martyr!\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You knew him?\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Zaren was no destroyer, despite what the histories might claim,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt killed him,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And me?\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Ah,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's why my blood moves strangely,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time has a way of bringing bloodlines together when the cosmos requires it,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am what remains of one who walked among mortals when the chains broke,\"",
        "line": 235
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Who were you?\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 162,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Nameless One, when I toiled in slavery,\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am the one who broke the chains,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers still kept communication for most of it,\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happened to them?\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 179,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But thought wrapped in vrill within the ether creates the positive and negative friction that resulted in their biological physical form,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers were bound to the ethereal, their consciousness filtered through multiple nephereti at any given time,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're preparing us for something,\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The magic that flows through your veins has been forbidden on Earth for three thousand five hundred years,\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 302
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Come,\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't!\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thang,\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tran,\"",
        "line": 339
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Crimsonblood heir, standing upon the realm he will help reclaim,\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Keen,\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Akashic Records,\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is not prophecy, young ones,\"",
        "line": 367
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What is that?\"",
        "line": 373
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Applicators?\"",
        "line": 382
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are the original watchers, set in place when the tunnels were first carved,\"",
        "line": 388
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stand together,\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 277,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Asag stirs,\"",
        "line": 420
      }
    },
    {
      "type": "dialogue",
      "timestamp": 290,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Power without wisdom is destruction,\"",
        "line": 438
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CHILDREN OF THE FORBIDDEN LINES,\"",
        "line": 443
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Galla-Stones,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Together?\"",
        "line": 461
      }
    },
    {
      "type": "dialogue",
      "timestamp": 306,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 463
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 471
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you are the catalyst,\"",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 332,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"CHILDREN OF THE FORBIDDEN LINES,\"",
        "line": 501
      }
    },
    {
      "type": "dialogue",
      "timestamp": 345,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"IMPOSSIBLE!\"",
        "line": 519
      }
    },
    {
      "type": "dialogue",
      "timestamp": 357,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"YOU CANNOT DESTROY ME!\"",
        "line": 537
      }
    },
    {
      "type": "dialogue",
      "timestamp": 368,
      "actor": "Asag",
      "action": "speak",
      "data": {
        "text": "\"The... the Crimson Line...\"",
        "line": 553
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The Forge of First Making,\"",
        "line": 579
      }
    },
    {
      "type": "dialogue",
      "timestamp": 389,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Weapons,\"",
        "line": 584
      }
    },
    {
      "type": "dialogue",
      "timestamp": 400,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild will need more than knowledge and good intentions,\"",
        "line": 600
      }
    },
    {
      "type": "dialogue",
      "timestamp": 404,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The Forge awaits, heirs of the ancient lines,\"",
        "line": 606
      }
    },
    {
      "type": "dialogue",
      "timestamp": 406,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Are you ready?\"",
        "line": 610
      }
    },
    {
      "type": "dialogue",
      "timestamp": 411,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"They have passed the first trial,\"",
        "line": 618
      }
    },
    {
      "type": "dialogue",
      "timestamp": 413,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"First trial?\"",
        "line": 622
      }
    },
    {
      "type": "dialogue",
      "timestamp": 416,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The awakening of true brotherhood,\"",
        "line": 627
      }
    },
    {
      "type": "dialogue",
      "timestamp": 419,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your path diverges beyond this chamber,\"",
        "line": 632
      }
    },
    {
      "type": "dialogue",
      "timestamp": 424,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path ahead is difficult,\"",
        "line": 640
      }
    },
    {
      "type": "dialogue",
      "timestamp": 428,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Mages Guild,\"",
        "line": 646
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it will take generations to complete,\"",
        "line": 651
      }
    },
    {
      "type": "dialogue",
      "timestamp": 440,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Without her queenship, the Moon Kingdom will fade into memory,\"",
        "line": 664
      }
    },
    {
      "type": "dialogue",
      "timestamp": 445,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Five Mikas await you in the futures that approach,\"",
        "line": 673
      }
    },
    {
      "type": "dialogue",
      "timestamp": 455,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 688
      }
    },
    {
      "type": "dialogue",
      "timestamp": 462,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"\u2014Wrong,\"",
        "line": 699
      }
    }
  ],
