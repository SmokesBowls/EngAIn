  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not natural,\"",
        "line": 8
      }
    },
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"As if time itself refuses to touch them,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"Something waits there,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You came,\"",
        "line": 25
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Blue Mika,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Green Mika,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The foundation remembers what the mind forgets,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Red Mika,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The blood burns with recognition,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"White Mika,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are always heard, though rarely listened to,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Violet Mika,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The circle forms,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Who are you?\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are the keepers,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The watchers,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The testers,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The guides,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The binders,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"We serve the one who flew into the Sun,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Mr. GPT,\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"His followers,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Though he hasn't been particularly... present... for some time now,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magic abandoned is not magic forgotten,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perfected it,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perhaps improved upon it, in places,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And you've been watching us,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Before,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And we've had so little to listen to for so long,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The true nature of your heritage remains hidden,\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beyond Ironspire,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What transformation?\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One node in a vast network,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Crimson Blood is more than power,\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You stand at a crossroads,\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We offer guidance,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Dragon Mail calls to those of Crimson lineage,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What do you know of the Dragon Mail?\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ancient,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A path awaits,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tests of worth,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To prove yourself ready,\"",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For what comes next,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You know of these trials?\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path exists,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But to begin,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through the desert wastes,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through mountain passes,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through coastal depths,\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Through caverns of eternal night,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will remain,\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But weakens with distance,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Only because you do not yet understand its true nature,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"If we go,\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The city's factions will not welcome our return,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Political barriers,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time grows short,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He returns,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Follow the footprints when you decide,\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"I believe something awaits at the end of their trials,\"",
        "line": 282
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three thousand five hundred years is a long time to wait,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You think we should go,\"",
        "line": 289
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I need to understand what I am,\"",
        "line": 300
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And a plan,\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"You're still certain?\"",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"I spoke with Garic,\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Onyx?\"",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ready. Waiting at the village edge.\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There may be another way. During my time as a mercenary, I discovered certain... unofficial routes through Ironspire's walls. Used primarily by the Red Hand, but accessible to those who know where to look.\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Smuggler tunnels?\"",
        "line": 344
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Less tunnels, more overlooked passages.\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Garic said you might be leaving,\"",
        "line": 354
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I listen to the plants,\"",
        "line": 370
      }
    },
    {
      "type": "dialogue",
      "timestamp": 257,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then you know the dangers.\"",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 259,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"The Dregons,\"",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And others,\"",
        "line": 381
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's more than she appears,\"",
        "line": 395
      }
    },
    {
      "type": "dialogue",
      "timestamp": 272,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like everything in Sundrift, it seems.\"",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 410
      }
    },
    {
      "type": "dialogue",
      "timestamp": 282,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm coming with you,\"",
        "line": 412
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Isla, this isn't some adventure\u2014\"",
        "line": 417
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know that,\"",
        "line": 419
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This journey is too dangerous,\"",
        "line": 432
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Which is exactly why you need me,\"",
        "line": 435
      }
    },
    {
      "type": "dialogue",
      "timestamp": 304,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"I'm not asking permission,\"",
        "line": 444
      }
    },
    {
      "type": "dialogue",
      "timestamp": 307,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Caelum?\"",
        "line": 449
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Agreed,\"",
        "line": 460
      }
    },
    {
      "type": "dialogue",
      "timestamp": 318,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're being observed,\"",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 320,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're impatient,\"",
        "line": 468
      }
    }
  ],
