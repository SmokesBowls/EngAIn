    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Corruption spread is exponential here,\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We rest for three days, the Plains die,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mathematics are cruel, Geralt,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We push,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Proto-Dregan,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"TOGETHER OR WE ALL DIE!\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOW!\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Precisely,\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\"We tried for the Needle three months back,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 151,
      "actor": "Kael",
      "action": "speak",
      "data": {
        "text": "\"Now I'm tired of surviving,\"",
        "line": 208
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"The cost?\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We hit them from three sides at once,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "Lyra",
      "action": "speak",
      "data": {
        "text": "\"Water,\"",
        "line": 281
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or immense blunt force trauma,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Forest Needle burned pieces of me, Geralt,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we stop. We find another way.\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There is no other way. Only a faster death, or a slower one. I can protect the soldiers. Create harmonic shields against the sonic attacks. Disrupt the construct\u2019s coordination. But each act\u2026 fragments me further.\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I have learned what caring means,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's not a choice. That's suicide.\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 242,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 331
      }
    },
    {
      "type": "dialogue",
      "timestamp": 282,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt, they are dying too fast,\"",
        "line": 384
      }
    },
    {
      "type": "dialogue",
      "timestamp": 284,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can you help him? Just him?\"",
        "line": 387
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It will cost.\"",
        "line": 389
      }
    },
    {
      "type": "dialogue",
      "timestamp": 286,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do it.\"",
        "line": 391
      }
    },
    {
      "type": "dialogue",
      "timestamp": 302,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Focus fire! Break them!\"",
        "line": 415
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "Kessa",
      "action": "speak",
      "data": {
        "text": "\"Layered! Reinforced!\"",
        "line": 432
      }
    },
    {
      "type": "dialogue",
      "timestamp": 326,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Geralt, the shield harmonics\u2026 I can disrupt them,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 327,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're already fading.\"",
        "line": 448
      }
    },
    {
      "type": "dialogue",
      "timestamp": 328,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are dying NOW. Decide.\"",
        "line": 450
      }
    },
    {
      "type": "dialogue",
      "timestamp": 401,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It has adapted!\"",
        "line": 550
      }
    },
    {
      "type": "dialogue",
      "timestamp": 414,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"TOGETHER! NOW!\"",
        "line": 567
      }
    },
    {
      "type": "dialogue",
      "timestamp": 430,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Next time,\"",
        "line": 590
      }
    },
    {
      "type": "dialogue",
      "timestamp": 440,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"The protocols are interwoven,\"",
        "line": 605
      }
    },
    {
      "type": "dialogue",
      "timestamp": 483,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One more Needle,\"",
        "line": 663
      }
    },
    {
      "type": "dialogue",
      "timestamp": 492,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Day 9 - The Burning Tower",
        "line": 676
      }
    }
  ],
