    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"Keen!\"",
        "line": 14
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's not just power\u2014it's communication,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And what is it saying?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That change is coming,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Ah,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Young Moon-daughter,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have waited so long for this moment,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The foundation must be laid,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Passion and will forge the crown,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wisdom flows on the winds of change,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The bridge between worlds awaits your choice,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do you want from them?\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We want nothing,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your daughter is safe, Captain of Iron,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You're going to teach them magic?\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magic is not taught, young guardian,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But first,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Water and flow, earth and foundation, fire and will, air and wisdom, spirit and connection,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Depths,\"",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Roots,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Forge,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Clarity,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Trial of Unity,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What about us?\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Your courage has earned you witness to beginnings, child,\"",
        "line": 221
      }
    },
    {
      "type": "dialogue",
      "timestamp": 133,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We'll watch,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sek'han vel thara nix!\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Veshtari elun draconis...\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Curious,\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are a Dual-Souled Catalyst,\"",
        "line": 291
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're leaving. Now,\"",
        "line": 299
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Remember this spark, child,\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Guardian\u2014your trial lies on the horizon. Seek it,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now\u2014begin in earnest,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "Isla",
      "action": "speak",
      "data": {
        "text": "\"But which trial?\"",
        "line": 324
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Green,\"",
        "line": 330
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wisdom speaks through the youngest voice,\"",
        "line": 336
      }
    }
  ],
