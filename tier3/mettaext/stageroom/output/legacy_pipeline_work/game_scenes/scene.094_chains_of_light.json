  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 5,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Something's not right,\"",
        "line": 9
      }
    },
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome, travelers.\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 12,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've been expecting you,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"About the corruption spreading through the network?\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Don't,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remarkable, isn't it?\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Queen sees far. Plans long.\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We surrender,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean!\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Trust me,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Excellent choice,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The corruption you're spreading,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Destroy?\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your friends on Earth,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are divided. Scattered. Fighting corruptions they don't understand with tools they can barely use.\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Separate cells,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's okay,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Comfortable?\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What does she want?\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What she's always wanted. What was stolen from her eons ago.\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every fragment you've collected, every piece of your scattered soul you've recovered\u2014all of it has been drawing you here. The Queen didn't need to hunt you. She just needed to wait for you to complete yourself. Much more efficient.\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm...\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Same. These fields\u2014they're learning. Every time I test them, they adapt.\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We need to be smart about this,\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So what do we do?\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Overseer Marithel,\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Study?\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Observe. Document. Understand.\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not experiments,\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Everything is an experiment to those who seek understanding.\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Marithel",
      "action": "speak",
      "data": {
        "text": "\"You already are,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "Marithel",
      "action": "speak",
      "data": {
        "text": "\"The network corruption,\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's killing worlds,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's elevating them. Those that survive will be stronger. Those that don't...\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What\u2014\"",
        "line": 191
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Security breach in sections 7 through 12,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Something disrupted them. Something the Anunnaki didn't expect.\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Shadow-walking,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rongtai!\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No time,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What about Vi\u00ean?\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Go,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, no!\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Listen to me,\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't leave you!\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You have to.\"",
        "line": 253
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll come back for you,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She'll warn Earth,\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Are unaffected.\"",
        "line": 279
      }
    }
  ],
