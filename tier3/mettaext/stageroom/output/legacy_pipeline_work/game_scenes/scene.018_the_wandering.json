  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 30
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Magic,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Teach me,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then teach me to listen.\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can learn,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Many seasons ago, before the dark-world brought endless winter, Tidecaller Giants had great cities by the water-places. Had families. Had purposes larger than surviving alone in caves carved from ice and stubbornness.\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All Giants who could adapt to endless winter learned to listen to forces larger than themselves. But listening is... solitary work. Cannot teach group-magic to single minds. Cannot share water-wisdom with those who think in fire-patterns.\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you could teach. If you chose to.\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Teaching changes both student and teacher,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"And you?\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematics-mind is very loud,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot stop mathematics-mind entirely,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to hear,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematics-mind builds walls,\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"This,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Is this what freedom feels like?\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 144,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The water remembers everything,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And mathematics,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Magic,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All things vibrate,\"",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot think the Deep Tongue,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Now you understand,\"",
        "line": 258
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Before consciousness?\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 172,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The ice speaks of change,\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are destabilizing,\"",
        "line": 293
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 296
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematical uncertainty extends across multiple probability branches, but convergence suggests... not long. Years, perhaps. Possibly less.\"",
        "line": 298
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"We could try to maintain the refuge,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Could,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The knowledge we've developed,\"",
        "line": 314
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will not die,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone must carry it forward.\"",
        "line": 318
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematical magic requires precision,\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nor through demonstration alone,\"",
        "line": 341
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the framework can be provided. The initial understanding that makes such discovery possible.\"",
        "line": 344
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And practical demonstrations,\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students will face the same choice we faced,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Some will choose safety,\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And others?\"",
        "line": 359
      }
    }
  ],
