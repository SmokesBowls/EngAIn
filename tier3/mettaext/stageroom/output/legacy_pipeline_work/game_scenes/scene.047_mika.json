  "events": [
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Ironspire,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"We did,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"Where are the founders?\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "Celly",
      "action": "speak",
      "data": {
        "text": "\"More survivors keep arriving,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Again?\"",
        "line": 146
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Again,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"The place we missed by fifty meters,\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How is this here?\"",
        "line": 174
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Welcome to Falcon Ridge,\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perimeter's good,\"",
        "line": 222
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue isn't spoken,\"",
        "line": 237
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One of them. The one this world was sung in.\"",
        "line": 242
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Sek'han,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 200,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"It felt natural,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not built for quiet,\"",
        "line": 303
      }
    },
    {
      "type": "dialogue",
      "timestamp": 228,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Where will you go?\"",
        "line": 306
      }
    },
    {
      "type": "dialogue",
      "timestamp": 229,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Somewhere that needs defending. Somewhere that needs... action.\"",
        "line": 308
      }
    },
    {
      "type": "dialogue",
      "timestamp": 231,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You saved us as much as we saved you,\"",
        "line": 311
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're even, then.\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The book's done,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 249,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm done.\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 255,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 346
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 274,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For Mika,\"",
        "line": 375
      }
    },
    {
      "type": "dialogue",
      "timestamp": 276,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She'd like those,\"",
        "line": 378
      }
    }
  ],
