    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's nervous,\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or what truths might be revealed about it,\"",
        "line": 20
      }
    },
    {
      "type": "dialogue",
      "timestamp": 17,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Easy,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're being watched,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Titanborn know we're coming,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're testing our resolve,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The First Threshold,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"It senses the White Fragment,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Or something else calls to it,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"So,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Tran, bearer of the Dragon Mail,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I understand that the fragments must be united,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do you?\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I know that Zaron bound himself to create the armor,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Knowing and understanding are not the same,\"",
        "line": 107
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mirrors show possibility,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"These are futures where we fail to unite properly,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"I see it,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fear is natural,\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The difference,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We chose unity,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 114,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am what you could become,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"You're what happens if I let the armor consume me,\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You cannot defeat me,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's the test,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Trust me,\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 201
      }
    },
    {
      "type": "dialogue",
      "timestamp": 138,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm accepting truth,\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Choose,\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I choose us,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Truth cannot be grasped by illusion,\"",
        "line": 235
      }
    },
    {
      "type": "thought",
      "timestamp": 171,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Thank you,\"",
        "line": 251
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Interesting,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Is that not the point of truth?\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"What happens now?\"",
        "line": 267
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "Kronocht",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"You're coming with us?\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The last fragment will not be found through strength or wisdom alone,\"",
        "line": 273
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"The Keeper of Crossroads,\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"How does it feel?\"",
        "line": 297
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Become who you were meant to be,\"",
        "line": 304
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tell me,\"",
        "line": 316
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Only that it represents unity and transcendence,\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 219,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unity, yes,\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"Whatever comes,\"",
        "line": 328
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Soon,\"",
        "line": 346
      }
    }
  ],
