{
  "scene_id": "scene.090_echoes_of_the_culling_corrected",
  "description": "book 17",
  "entities": [
    {
      "id": "keen",
      "name": "Keen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "type": "character"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ashfall Plains reveal themselves differently to those who know how to look,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 13,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three cycles of ash-light,\"",
        "line": 21
      }
    },
    {
      "type": "dialogue",
      "timestamp": 15,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Ashen Tide?\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 16,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The plains breathe,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This place knows me,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We move swiftly,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The cloaks,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perception garments,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There was civilization here,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Many civilizations,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Time means little on Umbrageous,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Listen carefully,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nothing,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Do not engage!\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Temporal boundary breach,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are they?\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Echoes of the fallen,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to do something,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Then what do we do?\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This carries similar resonance,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 106,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What just happened?\"",
        "line": 162
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Wastes remember all debts,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And do I?\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Blood remembers | Time transfers | Void connects.\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A token only,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"A waypoint?\"",
        "line": 192
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A memory anchor,\"",
        "line": 194
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It recognizes you,\"",
        "line": 200
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What is it trying to do?\"",
        "line": 203
      }
    },
    {
      "type": "dialogue",
      "timestamp": 134,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To remember | To record | To preserve.\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 136,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Whose memories?\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All who carried Zaryon's blood,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can't...\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You must decide,\"",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, wait,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Convergence\"",
        "line": 275
      }
    },
    {
      "type": "dialogue",
      "timestamp": 188,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"What did you see?\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Everything,\"",
        "line": 285
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 287
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"But why scatter them?\"",
        "line": 290
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because knowledge is power | Power attracts hunters | Hunters serve the Queen.\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We must reach the threshold before darkness,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solantri,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What are they saying?\"",
        "line": 315
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They announce your arrival,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will they help us find the Void Spire?\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If they deem you worthy,\"",
        "line": 323
      }
    },
    {
      "type": "dialogue",
      "timestamp": 217,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have detected something else,\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. Something worse.\"",
        "line": 335
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"From native hunters, yes. From Anunnaki technology...\"",
        "line": 342
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are they saying now?\"",
        "line": 348
      }
    },
    {
      "type": "dialogue",
      "timestamp": 232,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They offer sanctuary,\"",
        "line": 351
      }
    },
    {
      "type": "dialogue",
      "timestamp": 234,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What price?\"",
        "line": 354
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Verification of intent. A resonance test.\"",
        "line": 357
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's invasive,\"",
        "line": 360
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's survival,\"",
        "line": 363
      }
    },
    {
      "type": "dialogue",
      "timestamp": 248,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll do it,\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean, we don't know what this involves,\"",
        "line": 377
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We don't have a choice,\"",
        "line": 380
      }
    },
    {
      "type": "dialogue",
      "timestamp": 258,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Harmonic Path,\"",
        "line": 389
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What?\"",
        "line": 392
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The path rejects entropy,\"",
        "line": 395
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will we see you again?\"",
        "line": 398
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When the final ash falls | When the Void calls | When the truth awakens.\"",
        "line": 401
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't like this,\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have been maneuvered since we arrived on this planet,\"",
        "line": 409
      }
    },
    {
      "type": "dialogue",
      "timestamp": 281,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Irix Thal,\"",
        "line": 423
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You who vibrate in temporal thirds,\"",
        "line": 430
      }
    },
    {
      "type": "dialogue",
      "timestamp": 287,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I do,\"",
        "line": 433
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I understand,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Follow,\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 305,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Echo Crown,\"",
        "line": 458
      }
    },
    {
      "type": "dialogue",
      "timestamp": 310,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What do I need to do?\"",
        "line": 465
      }
    },
    {
      "type": "dialogue",
      "timestamp": 311,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stand within the focus point,\"",
        "line": 467
      }
    },
    {
      "type": "dialogue",
      "timestamp": 315,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Begin verification,\"",
        "line": 473
      }
    },
    {
      "type": "dialogue",
      "timestamp": 358,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What did you do to him?\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 360,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Verification\u2014complete,\"",
        "line": 541
      }
    },
    {
      "type": "dialogue",
      "timestamp": 362,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The fragmented one?\"",
        "line": 544
      }
    },
    {
      "type": "dialogue",
      "timestamp": 368,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rest will be required,\"",
        "line": 552
      }
    },
    {
      "type": "dialogue",
      "timestamp": 375,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The verification is complete,\"",
        "line": 561
      }
    }
  ],
