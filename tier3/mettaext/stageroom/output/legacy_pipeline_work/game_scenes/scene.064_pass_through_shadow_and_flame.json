  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 27,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're mapping our signatures,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're not just persistent,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Where are we going?\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"There's something I haven't told you about my training,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Their libraries held truths that could liberate galaxies,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"Ancient network?\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To the places where knowledge itself is preserved,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How far?\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Not far now,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Northern Eye,\"",
        "line": 186
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seven?\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It left wounds in reality itself,\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Khe,\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network is broken,\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Compassion extinguishes suns sometimes,\"",
        "line": 232
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Surround the perimeter!\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 169,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But it requires something the network can verify,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 176,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"It's responding,\"",
        "line": 265
      }
    },
    {
      "type": "dialogue",
      "timestamp": 206,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the eternal flame,\"",
        "line": 310
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The heart of the network,\"",
        "line": 313
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Record of Intent,\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 216,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am Orathiel,\"",
        "line": 326
      }
    },
    {
      "type": "dialogue",
      "timestamp": 218,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who arbitrates your cosmic standards?\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To access the pathways that lead between worlds,\"",
        "line": 341
      }
    },
    {
      "type": "dialogue",
      "timestamp": 231,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What exactly are we signing?\"",
        "line": 349
      }
    },
    {
      "type": "dialogue",
      "timestamp": 235,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Stop!\"",
        "line": 355
      }
    },
    {
      "type": "dialogue",
      "timestamp": 243,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What of our right to forget?\"",
        "line": 366
      }
    },
    {
      "type": "dialogue",
      "timestamp": 270,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Together,\"",
        "line": 404
      }
    },
    {
      "type": "dialogue",
      "timestamp": 279,
      "actor": "Orathiel",
      "action": "speak",
      "data": {
        "text": "\"It is done,\"",
        "line": 416
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "Orathiel",
      "action": "speak",
      "data": {
        "text": "\"The Solar Realm,\"",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 299,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Ethereal Kingdoms,\"",
        "line": 446
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And countless others,\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 307,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek the heir to the lunar throne,\"",
        "line": 458
      }
    },
    {
      "type": "dialogue",
      "timestamp": 317,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"And that someone is me,\"",
        "line": 471
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 505
      }
    },
    {
      "type": "dialogue",
      "timestamp": 342,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No resonance,\"",
        "line": 507
      }
    },
    {
      "type": "dialogue",
      "timestamp": 347,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"The pathway is collapsing,\"",
        "line": 514
      }
    },
    {
      "type": "dialogue",
      "timestamp": 349,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Emergency protocol! Seed Jump activation!\"",
        "line": 518
      }
    },
    {
      "type": "dialogue",
      "timestamp": 359,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solar Observer has gone dark,\"",
        "line": 534
      }
    }
  ],
