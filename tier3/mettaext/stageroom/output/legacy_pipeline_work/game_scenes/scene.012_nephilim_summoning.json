  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 9,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are losing,\"",
        "line": 15
      }
    },
    {
      "type": "dialogue",
      "timestamp": 11,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert is worse,\"",
        "line": 18
      }
    },
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You ally with Anunnaki creatures while we die,\"",
        "line": 28
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Brajor chose alliance,\"",
        "line": 31
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Convenient distinction,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're doomed,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're doomed if we accept them,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't cross the Veil without their permission,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the planet can touch both sides,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And ask for what?\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The old defenses,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We attempt communion,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Saresh",
      "action": "speak",
      "data": {
        "text": "\"And if the cost is too high?\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"Whatever they demand,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We'll maintain it,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We understand cost. Show us anyway.\"",
        "line": 131
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek any weapon that can oppose the golden ones,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Explain the requirements.\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This will kill us,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 128,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And if it doesn't survive? If we fracture?\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have no real choice,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 137,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I disagree,\"",
        "line": 198
      }
    }
  ],
