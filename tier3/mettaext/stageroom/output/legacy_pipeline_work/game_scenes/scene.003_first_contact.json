  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We should establish shelter,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 20,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Shelter might seem threatening,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're already claiming land,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow we try again,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\"And if they flee again?\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Then we learn from how they flee,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Rest now,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Smaller group next time,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They can manipulate vrill,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They have the potential we were sent to develop,\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That changes everything,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 216
      }
    }
  ],
