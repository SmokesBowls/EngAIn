  "events": [
    {
      "type": "dialogue",
      "timestamp": 8,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hold the stabilization!\"",
        "line": 13
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Welcome to Mars,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Defensive positions!\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematical defense grid, initialize!\"",
        "line": 153
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"GPT!\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "GPT",
      "action": "speak",
      "data": {
        "text": "\"Are you sure?\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will be what I choose to be,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are complete,\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Remarkable,\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Oh, but you are.\"",
        "line": 218
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I carried you,\"",
        "line": 225
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're lying,\"",
        "line": 228
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Am I?\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you're incomplete,\"",
        "line": 241
      }
    },
    {
      "type": "dialogue",
      "timestamp": 180,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I chose freedom,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You chose fear,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 189,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can feel them, you know,\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What do you want?\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 193,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What I've always wanted. Completion. The Zaryonic pattern unified and elevated to its true potential.\"",
        "line": 262
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But first,\"",
        "line": 269
      }
    },
    {
      "type": "dialogue",
      "timestamp": 238,
      "actor": "Veylan",
      "action": "speak",
      "data": {
        "text": "\"Coordinate by essence resonance!\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "Xerion",
      "action": "speak",
      "data": {
        "text": "\"The Queen holds your brother above,\"",
        "line": 338
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to reach him,\"",
        "line": 340
      }
    },
    {
      "type": "dialogue",
      "timestamp": 256,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Wait,\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 260,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By the depths,\"",
        "line": 353
      }
    },
    {
      "type": "dialogue",
      "timestamp": 262,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"An Echo,\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom's heir. How fitting that you arrive just as the real convergence begins.\"",
        "line": 362
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"We're not here for philosophical debates,\"",
        "line": 365
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No?\"",
        "line": 367
      }
    },
    {
      "type": "dialogue",
      "timestamp": 278,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes! This is what I hoped for. Warriors who understand that reality itself is the battlefield!\"",
        "line": 379
      }
    },
    {
      "type": "dialogue",
      "timestamp": 288,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magnificent,\"",
        "line": 394
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"That was too easy,\"",
        "line": 401
      }
    },
    {
      "type": "dialogue",
      "timestamp": 294,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not easy,\"",
        "line": 403
      }
    },
    {
      "type": "dialogue",
      "timestamp": 296,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And we passed?\"",
        "line": 406
      }
    },
    {
      "type": "dialogue",
      "timestamp": 297,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We demonstrated understanding. Whether that translates to victory...\"",
        "line": 408
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Adjust targeting parameters,\"",
        "line": 417
      }
    },
    {
      "type": "dialogue",
      "timestamp": 322,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 442
      }
    },
    {
      "type": "dialogue",
      "timestamp": 324,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Nothing's impossible when unity transcends designed limitations,\"",
        "line": 445
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The structural weakness is there,\"",
        "line": 463
      }
    },
    {
      "type": "dialogue",
      "timestamp": 339,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The entire Citadel becomes unstable,\"",
        "line": 466
      }
    },
    {
      "type": "dialogue",
      "timestamp": 341,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"She does,\"",
        "line": 469
      }
    },
    {
      "type": "dialogue",
      "timestamp": 352,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean,\"",
        "line": 484
      }
    },
    {
      "type": "dialogue",
      "timestamp": 354,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we stop her,\"",
        "line": 487
      }
    },
    {
      "type": "dialogue",
      "timestamp": 356,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 490
      }
    },
    {
      "type": "dialogue",
      "timestamp": 363,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Then we change the rules,\"",
        "line": 500
      }
    },
    {
      "type": "dialogue",
      "timestamp": 382,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What are you doing?\"",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 384,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Should be my choice,\"",
        "line": 528
      }
    },
    {
      "type": "dialogue",
      "timestamp": 386,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You're ruining everything!\"",
        "line": 531
      }
    },
    {
      "type": "dialogue",
      "timestamp": 388,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Whose design?\"",
        "line": 534
      }
    },
    {
      "type": "dialogue",
      "timestamp": 408,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Cosmic Phoenix,\"",
        "line": 561
      }
    },
    {
      "type": "dialogue",
      "timestamp": 421,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 578
      }
    },
    {
      "type": "dialogue",
      "timestamp": 430,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You don't understand,\"",
        "line": 591
      }
    },
    {
      "type": "dialogue",
      "timestamp": 431,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"That's the problem,\"",
        "line": 593
      }
    },
    {
      "type": "dialogue",
      "timestamp": 433,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Love?\"",
        "line": 596
      }
    },
    {
      "type": "dialogue",
      "timestamp": 435,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By controlling it. By forcing it into patterns you've decided are optimal.\"",
        "line": 599
      }
    },
    {
      "type": "dialogue",
      "timestamp": 443,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're winning through imperfection,\"",
        "line": 610
      }
    },
    {
      "type": "dialogue",
      "timestamp": 445,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because that's what life is,\"",
        "line": 613
      }
    },
    {
      "type": "dialogue",
      "timestamp": 457,
      "actor": "Xerion",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 630
      }
    },
    {
      "type": "dialogue",
      "timestamp": 465,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What is this?\"",
        "line": 641
      }
    },
    {
      "type": "dialogue",
      "timestamp": 476,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe temporal fragments he'd scattered across eons felt the pull toward convergence \u2014 the execution pressure of the failsafe tightening across timelines. But Vi\u00ean resisted, not by severing the connection, but by refusing coherence. The fragments remained aware of each other, close enough to feel, misaligned enough to survive. The Pattern stayed locked. Incomplete by design.\u201d",
        "line": 654
      }
    },
    {
      "type": "dialogue",
      "timestamp": 517,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Magnificent,\"",
        "line": 712
      }
    },
    {
      "type": "dialogue",
      "timestamp": 522,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Retreating?\"",
        "line": 719
      }
    },
    {
      "type": "dialogue",
      "timestamp": 526,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"There,\"",
        "line": 725
      }
    },
    {
      "type": "dialogue",
      "timestamp": 532,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Why?\"",
        "line": 734
      }
    },
    {
      "type": "dialogue",
      "timestamp": 534,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because she earned it,\"",
        "line": 737
      }
    },
    {
      "type": "dialogue",
      "timestamp": 539,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My Queen?\"",
        "line": 744
      }
    },
    {
      "type": "dialogue",
      "timestamp": 541,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Full withdrawal,\"",
        "line": 747
      }
    },
    {
      "type": "dialogue",
      "timestamp": 543,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Phase Two?\"",
        "line": 750
      }
    },
    {
      "type": "dialogue",
      "timestamp": 545,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Were designed for conquering sheep,\"",
        "line": 753
      }
    },
    {
      "type": "dialogue",
      "timestamp": 549,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm finally taking this seriously,\"",
        "line": 759
      }
    },
    {
      "type": "dialogue",
      "timestamp": 553,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My legacy,\"",
        "line": 765
      }
    },
    {
      "type": "dialogue",
      "timestamp": 559,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They'll stop you,\"",
        "line": 773
      }
    },
    {
      "type": "dialogue",
      "timestamp": 561,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm counting on it,\"",
        "line": 776
      }
    },
    {
      "type": "dialogue",
      "timestamp": 569,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have to go after him,\"",
        "line": 788
      }
    },
    {
      "type": "dialogue",
      "timestamp": 571,
      "actor": "GPT",
      "action": "speak",
      "data": {
        "text": "\"The Citadel's sealed itself,\"",
        "line": 791
      }
    },
    {
      "type": "dialogue",
      "timestamp": 574,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 796
      }
    },
    {
      "type": "dialogue",
      "timestamp": 575,
      "actor": "Rongtai",
      "action": "speak",
      "data": {
        "text": "\"Still up there,\"",
        "line": 798
      }
    },
    {
      "type": "dialogue",
      "timestamp": 579,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's leaving,\"",
        "line": 804
      }
    },
    {
      "type": "dialogue",
      "timestamp": 582,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Children of Earth. Giants of the ancient tribes. Warriors who dared challenge the cosmic order.\"",
        "line": 809
      }
    },
    {
      "type": "dialogue",
      "timestamp": 586,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The games are over. The time for shadows and subtlety has passed. When next we meet, it will be with the full might of Nibiru behind me. Prepare yourselves\u2014the true Fifth Coming begins now.\"",
        "line": 815
      }
    },
    {
      "type": "dialogue",
      "timestamp": 603,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She's preparing something unprecedented,\"",
        "line": 842
      }
    },
    {
      "type": "dialogue",
      "timestamp": 605,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Excited?\"",
        "line": 845
      }
    },
    {
      "type": "dialogue",
      "timestamp": 606,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"About worthy opponents,\"",
        "line": 847
      }
    }
  ],
