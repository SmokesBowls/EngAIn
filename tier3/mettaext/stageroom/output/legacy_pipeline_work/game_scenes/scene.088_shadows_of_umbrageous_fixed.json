  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vi\u00ean?\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Where are we?\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your homeland,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I feel it,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We should find shelter,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"What is it?\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Temporal patterns,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're not alone,\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This way,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt, travelers,\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"We seek passage,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not what. Who.\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"My name is Vi\u00ean,\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 95,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Not me,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Umbral Stalkers,\"",
        "line": 150
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Entropy markers,\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now we may speak freely,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Thank you for your help,\"",
        "line": 171
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Purpose is known | Blood is recognized | Void calls to void.\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 123,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All who remember the Culling know of the spires,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't understand,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 202
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We need to find the dormant Void Spire,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The spire sleeps beneath the City of Echoes,\"",
        "line": 212
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"And how do we awaken this Observer?\"",
        "line": 215
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Resonance | Sacrifice | Recognition.\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We've done something like this before,\"",
        "line": 223
      }
    },
    {
      "type": "dialogue",
      "timestamp": 160,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"The light shifts?\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Permanent, yes. Unchanging, no.\"",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Do you trust this... person?\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I saw...\"",
        "line": 260
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possibilities of what?\"",
        "line": 263
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Sustenance,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When we reach the City of Echoes,\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Solantri know,\"",
        "line": 277
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And Lentharis? The Observer?\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Lost between words. Between realities.\"",
        "line": 283
      }
    },
    {
      "type": "dialogue",
      "timestamp": 199,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To awaken Lentharis, you must synchronize your dual natures,\"",
        "line": 288
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes. Lentharis will demand truth | memory | sacrifice.\"",
        "line": 295
      }
    },
    {
      "type": "dialogue",
      "timestamp": 220,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Of course I've noticed,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know what I'm looking for,\"",
        "line": 322
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "Keen",
      "action": "speak",
      "data": {
        "text": "\"Searching for what?\"",
        "line": 325
      }
    },
    {
      "type": "dialogue",
      "timestamp": 226,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know.\"",
        "line": 327
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cProgress?\u201d",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 246,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cBegin sync sequence,\u201d",
        "line": 357
      }
    }
  ],
