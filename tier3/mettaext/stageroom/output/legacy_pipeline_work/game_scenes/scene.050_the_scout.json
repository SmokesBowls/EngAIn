  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 7,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Inversion threshold holding at 55.7%,\"",
        "line": 11
      }
    },
    {
      "type": "dialogue",
      "timestamp": 10,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThey\u2019re not patrolling,\u201d",
        "line": 16
      }
    },
    {
      "type": "dialogue",
      "timestamp": 14,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\u201cHis signature is five kilometers northeast,\u201d",
        "line": 22
      }
    },
    {
      "type": "dialogue",
      "timestamp": 26,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cWeeks old,\u201d",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cHe thinks we\u2019re recruitment,\u201d",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cHe is not incorrect,\u201d",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cHe is phasing,\u201d",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cHe\u2019s here,\u201d",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI\u2019m not coming back, Oreck,\u201d",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cYour name was Vek\u2019tar,\u201d",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWas,\u201d",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI could feel all the shapes!\u201d",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\u201cYou navigated seventeen jumps for the Legion,\u201d",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 112,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI also lost sixteen men and women in the eighteenth jump at Mir\u2019s Reach,\u201d",
        "line": 158
      }
    },
    {
      "type": "dialogue",
      "timestamp": 124,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cLuminaire can\u2019t fix chroniton rot!\u201d",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cI cannot reverse it.\u201d",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhat,\u201d",
        "line": 183
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cThe Keeper is active, but its authority has been usurped. This is not Anunnaki corruption. It is older. Primordial. The Umbra Sovereign\u2014an entity born in the places before light\u2014has claimed the node. It is weaving the spire\u2019s power into the fabric of its own shadow realm.\u201d",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\u201cCan you do it?\u201d",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cTwo days,\u201d",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cFederation fleet! They triangulated the network access spike from the map projection! Three cruisers, twelve fighters. Converging. ETA: Twenty minutes.\u201d",
        "line": 220
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cVek\u2019tar! Can you phase us out?\u201d",
        "line": 233
      }
    },
    {
      "type": "dialogue",
      "timestamp": 168,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cNot all three! Not this distance!\u201d",
        "line": 236
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cGERALT OF THE DRAGON. YOU ARE IN VIOLATION OF FEDERATION CONTAINMENT PROTOCOL ALPHA. SURRENDER THE COORDINATES OF THE ACTIVATED SPIRE AND SUBMIT TO DETAINMENT. ANY RESISTANCE WILL BE MET WITH LETHAL FORCE. THIS IS YOUR FINAL WARNING.\u201d",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 174,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\u201cI can create a gate,\u201d",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 175,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cUntargeted?\u201d",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\u201cWhere the dimensional stress is greatest. Where the shadow bleed pulls strongest.\u201d",
        "line": 250
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\u201cDo it!\u201d",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 205,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Where is she?\"",
        "line": 292
      }
    },
    {
      "type": "dialogue",
      "timestamp": 215,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three attempts,\"",
        "line": 305
      }
    },
    {
      "type": "dialogue",
      "timestamp": 266,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anchor arrives. Luminaire's vessel. You are expected.\"",
        "line": 374
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Are you the Keeper?\"",
        "line": 376
      }
    },
    {
      "type": "dialogue",
      "timestamp": 268,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am the Herald. The Umbra Sovereign will see you now.\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 283,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The past is not fixed here,\"",
        "line": 400
      }
    },
    {
      "type": "dialogue",
      "timestamp": 293,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Welcome, Light-Bearer. You come to reclaim MY Spire. How delightfully... mortal.\"",
        "line": 414
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This node,\"",
        "line": 423
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You built your towers on our territory. You drew power from wells we guarded. Without asking. Without even acknowledging. And now you dare to tell me the spire is 'destabilizing'?\"",
        "line": 428
      }
    },
    {
      "type": "dialogue",
      "timestamp": 303,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It destabilizes because it was never yours to stabilize. The 'corruption' you detect? That is the spire remembering its true nature. Shadow. Void. The quiet that existed before the first arrogant photon.\"",
        "line": 432
      }
    },
    {
      "type": "dialogue",
      "timestamp": 308,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It serves WHO CLAIMS IT!\"",
        "line": 439
      }
    },
    {
      "type": "dialogue",
      "timestamp": 316,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because I am not your enemy. The cascade failure you fear? I fear it more. If your network inverts, it does not simply destroy your reality. It drags the Umbra Planes with it. Light and shadow, merged without consent. Without order. That annihilates my domain as thoroughly as yours. We are, for this moment, in the same crumbling house.\"",
        "line": 452
      }
    },
    {
      "type": "dialogue",
      "timestamp": 319,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I propose an alternative,\"",
        "line": 457
      }
    },
    {
      "type": "dialogue",
      "timestamp": 324,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For convenience!\"",
        "line": 464
      }
    },
    {
      "type": "dialogue",
      "timestamp": 332,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your words are persuasive, Anchor. Your logic is sound. A partnership could benefit us both.\"",
        "line": 477
      }
    },
    {
      "type": "dialogue",
      "timestamp": 335,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Umbra Planes were not always as you see. Once, we had Light. A gentle, primal radiance that existed before stars. It was stolen from us, taken to the Deep Vaults by those who feared what we might become with both shadow and light at our command.\"",
        "line": 482
      }
    },
    {
      "type": "dialogue",
      "timestamp": 337,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Retrieve the Shard of First Dawn. Bring it to me. This will prove your intent is not merely to stabilize your network, but to restore balance.\"",
        "line": 486
      }
    },
    {
      "type": "dialogue",
      "timestamp": 342,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then I honor our accord. The Spire will be shared. Dual authorization. Light and shadow in harmony.\"",
        "line": 494
      }
    },
    {
      "type": "dialogue",
      "timestamp": 350,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Because without it, I have no reason to trust you. And without my cooperation...\"",
        "line": 505
      }
    },
    {
      "type": "dialogue",
      "timestamp": 355,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Three may enter the Deep Vaults,\"",
        "line": 512
      }
    },
    {
      "type": "dialogue",
      "timestamp": 364,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He'll have the key to corrupting the entire network from within,\"",
        "line": 525
      }
    },
    {
      "type": "dialogue",
      "timestamp": 374,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Here begins your test,\"",
        "line": 538
      }
    },
    {
      "type": "dialogue",
      "timestamp": 380,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Stay sharp,\"",
        "line": 547
      }
    },
    {
      "type": "dialogue",
      "timestamp": 405,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"My architects,\"",
        "line": 586
      }
    },
    {
      "type": "dialogue",
      "timestamp": 412,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Not killed by traps or guardians,\"",
        "line": 597
      }
    },
    {
      "type": "dialogue",
      "timestamp": 428,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"It's... peaceful,\"",
        "line": 621
      }
    },
    {
      "type": "dialogue",
      "timestamp": 429,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"It was never meant to be a weapon,\"",
        "line": 623
      }
    },
    {
      "type": "dialogue",
      "timestamp": 434,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"MORE VESSELS. MORE LIGHT TO CONSUME.\"",
        "line": 631
      }
    },
    {
      "type": "dialogue",
      "timestamp": 437,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's not a guardian,\"",
        "line": 636
      }
    },
    {
      "type": "dialogue",
      "timestamp": 445,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"It's drawing power from the Shard!\"",
        "line": 647
      }
    },
    {
      "type": "dialogue",
      "timestamp": 454,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I can sever the connection,\"",
        "line": 660
      }
    },
    {
      "type": "dialogue",
      "timestamp": 457,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Phase into the Shard itself. Disrupt the bond from the inside.\"",
        "line": 665
      }
    },
    {
      "type": "dialogue",
      "timestamp": 458,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Vek, no\u2014\"",
        "line": 667
      }
    },
    {
      "type": "dialogue",
      "timestamp": 460,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Raw Light energy will burn through my chroniton structure. I know. I'm at ninety-four percent decay anyway. Weeks left, at best.\"",
        "line": 670
      }
    },
    {
      "type": "dialogue",
      "timestamp": 473,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 689
      }
    },
    {
      "type": "dialogue",
      "timestamp": 485,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"His chroniton signature is... inside,\"",
        "line": 708
      }
    },
    {
      "type": "dialogue",
      "timestamp": 488,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know. The Shard is ancient, pre-network. Its internal structure is beyond my understanding. But his consciousness is there. I can feel it.\"",
        "line": 713
      }
    },
    {
      "type": "dialogue",
      "timestamp": 491,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We'll figure it out,\"",
        "line": 718
      }
    },
    {
      "type": "dialogue",
      "timestamp": 496,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sovereign is pleased. You succeeded where others failed.\"",
        "line": 727
      }
    },
    {
      "type": "dialogue",
      "timestamp": 498,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Shard,\"",
        "line": 731
      }
    },
    {
      "type": "dialogue",
      "timestamp": 502,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Well done, mortals.\"",
        "line": 737
      }
    },
    {
      "type": "dialogue",
      "timestamp": 509,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did you think I would share?\"",
        "line": 749
      }
    },
    {
      "type": "dialogue",
      "timestamp": 513,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's forcing synchronization!\"",
        "line": 755
      }
    },
    {
      "type": "dialogue",
      "timestamp": 515,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your reality ends!\"",
        "line": 758
      }
    },
    {
      "type": "dialogue",
      "timestamp": 526,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The cascade completes! Inversion BEGINS\u2014\"",
        "line": 774
      }
    },
    {
      "type": "dialogue",
      "timestamp": 533,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Told you... I'd try not to die...\"",
        "line": 785
      }
    },
    {
      "type": "dialogue",
      "timestamp": 538,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thanks... for believing I could be more than broken. I see it now... the right path. The one where we WIN.\"",
        "line": 794
      }
    },
    {
      "type": "dialogue",
      "timestamp": 548,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NO! THE SHARD WAS MINE! MINE BEFORE\u2014\"",
        "line": 811
      }
    },
    {
      "type": "dialogue",
      "timestamp": 558,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good fight... tell them I saw... the better timeline... it was real...\"",
        "line": 826
      }
    },
    {
      "type": "dialogue",
      "timestamp": 569,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"He's really gone,\"",
        "line": 844
      }
    },
    {
      "type": "dialogue",
      "timestamp": 576,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Umbra Spire is stabilized, but sealed. The Sovereign's corruption is purged, but the protocols are locked. We cannot use it for transit.\"",
        "line": 854
      }
    },
    {
      "type": "dialogue",
      "timestamp": 577,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"So we walk,\"",
        "line": 856
      }
    },
    {
      "type": "dialogue",
      "timestamp": 578,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Pyroclast,\"",
        "line": 858
      }
    }
  ],
