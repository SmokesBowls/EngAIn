    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't just observe genocide!\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prime Directive protects all life. Even theirs.\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 105,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Non-intervention is complicity!\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 107,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki claim proprietary rights over their creations. Galactic law upholds\u2014\"",
        "line": 143
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Galactic law is a coward's excuse!\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We observe. We report. We do not interfere with indigenous development, no matter how... unpleasant the circumstances.\"",
        "line": 148
      }
    }
  ],
