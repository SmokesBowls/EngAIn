  "events": [
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What do you touch?\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Show me,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ohhhh\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"uhhhhh\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"These are not words,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematics... tries to describe patterns that already exist,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue is consciousness speaking reality into fuller existence,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We have been teaching backwards,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now you begin to hear what the Deep Waters have always been whispering,\"",
        "line": 69
      }
    }
  ],
