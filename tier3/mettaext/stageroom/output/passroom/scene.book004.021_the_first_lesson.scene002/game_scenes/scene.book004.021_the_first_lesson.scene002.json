  "events": [
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh-ohhhh\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Better,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Like music,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I want to learn the complete grammar,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Dangerous request,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"More dangerous than remaining limited to current capabilities when convergences approach that will require consciousness evolution beyond anything we have achieved?\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Then we begin the Deep Teaching,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"eeeee\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"iiiii\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"aaaaa\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"This is what the advanced students will need to learn,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Foundation, development, synthesis, collaboration,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The teaching curriculum,\"",
        "line": 74
      }
    }
  ],
