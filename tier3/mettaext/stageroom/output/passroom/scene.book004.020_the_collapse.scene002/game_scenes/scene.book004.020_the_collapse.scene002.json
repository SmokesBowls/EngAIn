{
  "scene_id": "scene.book004.020_the_collapse.scene002",
  "description": "@scene_id: scene.book004.020_the_collapse.scene002",
  "entities": [
    {
      "id": "torrhen",
      "name": "Torrhen",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      },
