    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters remember everything,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And framework without experience becomes rigidity,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"Prison,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Three millennia of isolation,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Not entirely alone,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Purpose,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"You've seen it too,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Seen it, felt it, dreamed it in the deep places where stone remembers the birth of worlds,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We could build something unprecedented,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"More than that,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The students who will come,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"They will need teachers who are themselves still learning,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 76
      }
    }
  ],
