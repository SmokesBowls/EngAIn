    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are conclusive,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot?\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The fire burns,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Flight,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Run.\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"In the fourteenth iteration of galactic seeding,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are extinct. Their worlds are ash. Their courage is remembered by no one, because no one survived to carry the memory forward. The Devourers consumed their civilization so completely that even their names were forgotten. Honor without survival is just... silence.\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"It survives,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki have detected our council session,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Those who choose honor,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Those who choose survival,\"",
        "line": 106
      }
    }
  ],
