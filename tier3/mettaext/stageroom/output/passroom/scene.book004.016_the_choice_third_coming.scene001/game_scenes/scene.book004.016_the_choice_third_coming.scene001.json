  "events": [
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are conclusive,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Cannot?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The fire burns,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Flight,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Run.\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"In the fourteenth iteration of galactic seeding,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They are extinct. Their worlds are ash. Their courage is remembered by no one, because no one survived to carry the memory forward. The Devourers consumed their civilization so completely that even their names were forgotten. Honor without survival is just... silence.\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"It survives,\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Anunnaki have detected our council session,\"",
        "line": 88
      }
    }
  ],
