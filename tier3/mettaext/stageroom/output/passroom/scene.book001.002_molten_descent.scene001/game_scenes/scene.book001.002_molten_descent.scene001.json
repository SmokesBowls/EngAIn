  "events": [
    {
      "type": "dialogue",
      "timestamp": 164,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Listen,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 165,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We are here to help them,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're running from us,\"",
        "line": 209
      }
    },
    {
      "type": "dialogue",
      "timestamp": 182,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Gather the others,\"",
        "line": 229
      }
    },
    {
      "type": "dialogue",
      "timestamp": 195,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Why?\"",
        "line": 246
      }
    },
    {
      "type": "dialogue",
      "timestamp": 201,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"The energy signatures,\"",
        "line": 255
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"Remembers what?\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 203,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"I don't know yet,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 208,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Then we need to show them we're not what they remember,\"",
        "line": 266
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 222,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We wait,\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 223,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"And if they're never ready?\"",
        "line": 286
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We give it time,\"",
        "line": 302
      }
    }
  ],
