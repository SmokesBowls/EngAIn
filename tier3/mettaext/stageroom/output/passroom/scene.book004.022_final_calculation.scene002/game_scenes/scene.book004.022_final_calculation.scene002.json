    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters remember everything,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you cease to exist as individual awareness,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Transforms,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The students who will come,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And I become... what?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You become what teaching was always pointing toward,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The loneliness will be different,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The mathematical precision that defines your approach to consciousness-crafting,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the mystical intuition you have taught me,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the convergences require,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And this is what friendship becomes when it serves evolution rather than individual connection,\"",
        "line": 62
      }
    }
  ],
