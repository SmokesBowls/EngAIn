  "events": [
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The asteroid field surrounding the Shattered Mind is not merely a physical hazard,\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Kyh",
      "action": "speak",
      "data": {
        "text": "\"No ship we possess could navigate that field and survive,\"",
        "line": 145
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then where?\"",
        "line": 147
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"They didn't build here,\"",
        "line": 168
      }
    }
  ],
