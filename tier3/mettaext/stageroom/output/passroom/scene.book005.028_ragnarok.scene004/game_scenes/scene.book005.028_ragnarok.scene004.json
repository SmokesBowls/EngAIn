  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Remember,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And the Overseer?\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Geralt handles the Overseer,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Our job is everyone else. The guards, the slave drivers, anyone who tries to interfere with liberation. We're the hammer that compresses their forces toward the center where Geralt will be waiting.\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"Soon,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Halt,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I am Geralt,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm here to liberate your compound. To free the slaves you call property. To kill your Overseer and demonstrate that cosmic order is negotiable rather than absolute.\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You...\"",
        "line": 127
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Correction,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Last chance. Open the gate. Release the slaves. Withdraw peacefully. Live to tell Federation enforcement that some fights aren't worth the casualties.\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We will never\u2014\"",
        "line": 138
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"SURRENDER,\"",
        "line": 197
      }
    }
  ],
