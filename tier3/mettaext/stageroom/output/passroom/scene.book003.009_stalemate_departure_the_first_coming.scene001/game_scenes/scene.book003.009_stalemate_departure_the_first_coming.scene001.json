    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Flag all sites for Second Coming priority completion,\"",
        "line": 96
      }
    }
  ],
