    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WE'RE HERE FOR THE SPIRE!\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Liar! Everyone wants the spire! For conquest! For fire!\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NOW, LUMINAIRE!\"",
        "line": 164
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You... you're with the Spire? Not just another scavenger?\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're here for Aetheric Coil.\"",
        "line": 175
      }
    },
    {
