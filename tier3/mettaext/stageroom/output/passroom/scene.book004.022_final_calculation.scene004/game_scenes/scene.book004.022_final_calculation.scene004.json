    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Enter and be recognized,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I am called Aethon,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I am the Sage,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Aethon",
      "action": "speak",
      "data": {
        "text": "\"My home,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Aethon",
      "action": "speak",
      "data": {
        "text": "\"I destroyed them,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Sit,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tell me about the power itself,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Aethon",
      "action": "speak",
      "data": {
        "text": "\"Like... like I was everything,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Universal consciousness,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Aethon",
      "action": "speak",
      "data": {
        "text": "\"It becomes overwhelming,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Synthesis requires consciousness that can exist simultaneously as individual awareness and universal consciousness,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what teaching becomes,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Aethon",
      "action": "speak",
      "data": {
        "text": "\"And this is what learning becomes,\"",
        "line": 66
      }
    }
  ],
