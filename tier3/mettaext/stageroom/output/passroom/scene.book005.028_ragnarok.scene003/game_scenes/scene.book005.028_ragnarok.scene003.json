{
  "scene_id": "scene.book005.028_ragnarok.scene003",
  "description": "@scene_id: scene.book005.028_ragnarok.scene003",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
