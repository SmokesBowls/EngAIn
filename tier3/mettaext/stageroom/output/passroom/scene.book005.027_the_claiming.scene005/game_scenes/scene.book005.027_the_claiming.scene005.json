{
  "scene_id": "scene.book005.027_the_claiming.scene005",
  "description": "@scene_id: scene.book005.027_the_claiming.scene005",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      },
