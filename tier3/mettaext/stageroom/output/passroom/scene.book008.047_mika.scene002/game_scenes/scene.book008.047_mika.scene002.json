    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"The place we missed by fifty meters,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"How is this here?\"",
