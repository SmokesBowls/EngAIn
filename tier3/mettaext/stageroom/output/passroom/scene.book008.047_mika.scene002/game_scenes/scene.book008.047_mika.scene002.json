      "type": "dialogue",
      "timestamp": 62,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Welcome to Falcon Ridge,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perimeter's good,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue isn't spoken,\"",
        "line": 129
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One of them. The one this world was sung in.\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 102,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
