  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The tidal forces,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The ice speaks of great waters coming,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Global flood,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Our refuge will not survive this,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We could survive it,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Possible,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"There is another way,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"No,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Become more than one,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The cost,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Would be worth it,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I won't let you\u2014\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Cannot stop me,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"You'll die,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will become,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The students who come after,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Part of water's memory,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I should be the one,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Could not,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we both\u2014\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The loneliness,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Never alone,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Promise me,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I promise,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Then it begins,\"",
        "line": 88
      }
    }
  ],
