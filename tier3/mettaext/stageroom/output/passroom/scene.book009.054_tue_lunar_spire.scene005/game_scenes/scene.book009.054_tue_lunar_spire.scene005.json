  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Hello, Geralt,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The armor remembers me,\"",
        "line": 139
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This is for you,\"",
        "line": 151
      }
    },
    {
      "type": "dialogue",
      "timestamp": 143,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"A seed. A promise. A beginning.\"",
        "line": 156
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"What time?\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"In less than three thousand years,\"",
        "line": 161
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't\u2014\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "She",
      "action": "speak",
      "data": {
        "text": "\"You will.\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"That's my kiss,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 152,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Wait\u2014\"",
        "line": 173
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Moon Kingdom fell to protect this,\"",
        "line": 176
      }
    }
  ],
