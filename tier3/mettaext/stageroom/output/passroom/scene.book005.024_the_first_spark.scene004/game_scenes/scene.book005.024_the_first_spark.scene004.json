    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Flawed,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No.\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The specimen is flawed,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Social bonding is a defect in tools,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precisely.\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Correct. Let it live. Let it struggle. Let it draw other defective units into visibility so we may observe which genetic sequences correlate with rebellion tendency.\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And if it succeeds?\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Minimal intervention. Allow natural consequences. If other units move to protect this one, note the behavior for analysis. If Overseers attempt unsanctioned termination, prevent it. This specimen is now classified as experimental asset. All data regarding its development is priority zero.\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Acknowledged.\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Acknowledged.\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"Fascinating,\"",
        "line": 102
      }
    }
  ],
