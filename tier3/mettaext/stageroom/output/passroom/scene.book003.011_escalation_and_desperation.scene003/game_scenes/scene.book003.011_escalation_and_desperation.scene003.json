    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"They are not soldiers,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"Can you bridge the silence?\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Pazuzu translated, his mathematical mind finding patterns in the raw sensory data. \"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then they are adrift,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"They do not want to fight us,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The Queen's logic is binary,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"Then we offer them what we offered you three thousand years ago,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The other tribes will see it as a bargain struck while they bleed,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"Then we must make this alliance a bridge, not a wall,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we coordinate,\"",
        "line": 81
      }
    }
  ],
