    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No. Remain permeable. He must feel this.\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Two kilometers,\"",
        "line": 141
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Scars,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"The Ghost Spire,\"",
        "line": 175
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"And I have to touch it,\"",
        "line": 177
      }
    },
    {
      "type": "dialogue",
      "timestamp": 158,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are the Anchor. At 80% symbiosis, your resonance will harmonize with its null state. You will, for a moment, become a 'zero' with it. And from that nothing, we can redefine something.\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 161,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Cost unknown,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Symbiosis is not surrender,\"",
        "line": 213
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Begin,\"",
        "line": 227
      }
    },
    {
      "type": "dialogue",
      "timestamp": 224,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FORECLOSURE PROCEEDINGS INITIATED. ASSETS: ONE ANCHOR, ONE PARTITIONED FUNCTION, ONE NULL-STATE SPIRE. ALL ARE HEREBY CLAIMED FOR LIQUIDATION.\"",
        "line": 271
      }
    },
    {
      "type": "dialogue",
      "timestamp": 227,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 7, SUB-SECTION 3: ELEMENTAL INTERFERENCE IN COSMIC REPOSSESSION IS VOID.\"",
        "line": 276
      }
    },
    {
      "type": "dialogue",
      "timestamp": 230,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 12: PHYSICAL OBSTRUCTION OF A DULY APPOINTED AUDITOR IS NULL.\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 233,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 1: ALL ENERGY WITHIN THE DISPUTED REALM IS SUBJECT TO AUDIT.\"",
        "line": 284
      }
    },
    {
      "type": "dialogue",
      "timestamp": 236,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ARTICLE 0: REALITY ITSELF IS A SIGNATORY TO THIS CONTRACT.\"",
        "line": 288
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The final threshold is not physiological. It is a choice. Do you trust me, Geralt? Not to preserve you, but to become something new with you? Completely?\"",
        "line": 309
      }
    },
    {
      "type": "dialogue",
      "timestamp": 259,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 320
      }
    },
    {
      "type": "dialogue",
      "timestamp": 267,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"SOUND,\"",
        "line": 332
      }
    },
    {
      "type": "dialogue",
      "timestamp": 269,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"LIGHT.\"",
        "line": 334
      }
    },
    {
      "type": "dialogue",
      "timestamp": 271,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ANCHOR.\"",
        "line": 336
      }
    },
    {
      "type": "dialogue",
      "timestamp": 280,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ERROR. PARADIGM SHIFT DETECTED. SUBJECT STATUS: REASSEMBLED. DEBT PARAMETERS: UNDEFINED. LEDGER CONTEXT: CORRUPTED.\"",
        "line": 347
      }
    },
    {
      "type": "dialogue",
      "timestamp": 285,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You audit a debt. I will show you the payment.\"",
        "line": 356
      }
    },
    {
      "type": "dialogue",
      "timestamp": 295,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"These are the transactions,\"",
        "line": 369
      }
    },
    {
      "type": "dialogue",
      "timestamp": 298,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"RECALCULATING... RECALCULATING... CLASSIFICATION ERROR. SUBJECTS ARE NOT DEBTORS. THEY ARE... CREDITORS. THE UNIVERSAL BALANCE SHEET IS IN THEIR FAVOR. THE UNIVERSE OWES THEM A DEBT.\"",
        "line": 373
      }
    },
    {
      "type": "dialogue",
      "timestamp": 301,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FORECLOSURE VOIDED. CONTRACT NULLIFIED. THE SPIRE AND ITS ARCHITECT ARE HEREBY GRANTED SOVEREIGN STATUS, EXEMPT FROM COSMIC ACCOUNTING. WE APOLOGIZE FOR THE INCONVENIENCE.\"",
        "line": 378
      }
    },
    {
      "type": "dialogue",
      "timestamp": 309,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It is done. The Anchor holds. The network is stable. The debt is paid. The Ledger will trouble us no more.\"",
        "line": 390
      }
    }
  ],
