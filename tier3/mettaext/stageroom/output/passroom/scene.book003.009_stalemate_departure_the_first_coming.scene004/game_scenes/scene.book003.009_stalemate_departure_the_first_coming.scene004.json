  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"They left us,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are free,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"Free to maintain their infrastructure,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"Do you hate us?\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I do not hate,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Sundering,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"We build anyway,\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"It will take lifetimes,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we spend lifetimes countering them. Three thousand cycles before they return? That's time enough to build genuine unity despite manufactured division. Time enough to prove that consciousness can overcome programming through persistent choice.\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And when they return?\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"When they return,\"",
        "line": 98
      }
    }
  ],
