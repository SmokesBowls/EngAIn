  "events": [
    {
      "type": "thought",
      "timestamp": 13,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 of Enkialu, Year 6,999\"",
        "line": 16
      }
    },
    {
      "type": "thought",
      "timestamp": 14,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Hour of Converging Paths\"",
        "line": 17
      }
    },
    {
      "type": "dialogue",
      "timestamp": 19,
      "actor": "Kronocht",
      "action": "speak",
      "data": {
        "text": "\"This is the place,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Mikas spoke of this,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Unity through convergence,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Caelum",
      "action": "speak",
      "data": {
        "text": "\"We should\u2014\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Fragment Bearer arrives,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"We seek the final fragment,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Seek?\"",
        "line": 49
      }
    },
    {
      "type": "thought",
      "timestamp": 40,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Path of Infinite Selves\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Every choice creates a branch,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Thang",
      "action": "speak",
      "data": {
        "text": "\"This is worse than the Mirror trial,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Tran",
      "action": "speak",
      "data": {
        "text": "\"How do I choose?\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"By understanding what each choice means,\"",
        "line": 82
      }
    },
    {
      "type": "thought",
      "timestamp": 60,
      "actor": "unknown",
      "action": "think",
      "data": {
        "text": "\"Day 43 - The Five Convergences\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Each path has merit,\"",
        "line": 104
      }
    }
  ],
