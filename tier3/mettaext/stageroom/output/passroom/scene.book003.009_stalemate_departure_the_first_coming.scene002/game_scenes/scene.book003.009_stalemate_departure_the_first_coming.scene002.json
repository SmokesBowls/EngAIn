    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This pattern,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The First Tongue,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti taught us fragments of this,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"When they leave,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Orbital mechanics suggest departure within eight cycles. They cannot remain indefinitely\u2014their vessel follows gravitational trajectories that don't permit extended planetary position.\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To continue their work?\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"To serve as permanent garrison. To maintain the structures they've built. To...\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And when you understood?\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We built the Garden together. Five hundred years of cooperation that transformed both our peoples. We became something neither could have achieved alone.\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"I would like that,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"Then we will try,\"",
        "line": 81
      }
    }
  ],
