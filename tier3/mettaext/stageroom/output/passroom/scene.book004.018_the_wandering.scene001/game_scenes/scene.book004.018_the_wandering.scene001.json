  "events": [
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Magic,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Teach me,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then teach me to listen.\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"I can learn,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Many seasons ago, before the dark-world brought endless winter, Tidecaller Giants had great cities by the water-places. Had families. Had purposes larger than surviving alone in caves carved from ice and stubbornness.\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"All Giants who could adapt to endless winter learned to listen to forces larger than themselves. But listening is... solitary work. Cannot teach group-magic to single minds. Cannot share water-wisdom with those who think in fire-patterns.\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But you could teach. If you chose to.\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Teaching changes both student and teacher,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"And you?\"",
        "line": 116
      }
    }
  ],
