    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Sovereign is pleased. You succeeded where others failed.\"",
        "line": 133
      }
    },
    {
      "type": "dialogue",
      "timestamp": 132,
      "actor": "it",
      "action": "speak",
      "data": {
        "text": "\"The Shard,\"",
        "line": 137
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Well done, mortals.\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 142,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did you think I would share?\"",
        "line": 154
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"He's forcing synchronization!\"",
        "line": 160
      }
    },
    {
      "type": "dialogue",
      "timestamp": 148,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Your reality ends!\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The cascade completes! Inversion BEGINS\u2014\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 166,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Told you... I'd try not to die...\"",
        "line": 190
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thanks... for believing I could be more than broken. I see it now... the right path. The one where we WIN.\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NO! THE SHARD WAS MINE! MINE BEFORE\u2014\"",
        "line": 216
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Good fight... tell them I saw... the better timeline... it was real...\"",
        "line": 231
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"He's really gone,\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Umbra Spire is stabilized, but sealed. The Sovereign's corruption is purged, but the protocols are locked. We cannot use it for transit.\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 210,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"So we walk,\"",
        "line": 261
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"Pyroclast,\"",
        "line": 263
      }
    }
  ],
