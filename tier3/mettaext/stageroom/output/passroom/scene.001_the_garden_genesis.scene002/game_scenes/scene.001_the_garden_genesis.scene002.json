  "events": [
    {
      "type": "dialogue",
      "timestamp": 18,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The planetary core stabilizes,\"",
        "line": 24
      }
    },
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tectonic plates settling into stable configurations,\"",
        "line": 29
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Water coverage approximately seventy-two percent,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen years,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"Since we lost our bodies,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"Physical form is limitation,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Extend observation channels to surface level,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"Pelagor,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"Three thousand years of evolutionary pressure,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"They went deep,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"They retained the core abilities,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"Look at the others,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"They have the potential,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"The Pelagor survived,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"And we,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The system requires ground-level maintenance,\"",
        "line": 116
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"It's been three thousand years since we've created Nephoretti,\"",
        "line": 120
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"We've done it before,\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"That was when we had physical bodies ourselves,\"",
        "line": 124
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"We should remember,\"",
        "line": 155
      }
    },
    {
      "type": "dialogue",
      "timestamp": 109,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"Which is precisely why they need the Nephoretti,\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 110,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"And perhaps,\"",
        "line": 159
      }
    },
    {
      "type": "dialogue",
      "timestamp": 115,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"One thousand Nephoretti,\"",
        "line": 166
      }
    },
    {
      "type": "dialogue",
      "timestamp": 116,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"Manifested simultaneously,\"",
        "line": 168
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"And the intentions we craft into them?\"",
        "line": 170
      }
    },
    {
      "type": "dialogue",
      "timestamp": 129,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We give them purpose, not instructions,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 130,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"A dangerous gift,\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 131,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Then let us begin,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare for the leap,\"",
        "line": 249
      }
    },
    {
      "type": "dialogue",
      "timestamp": 177,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Mark,\"",
        "line": 255
      }
    }
  ],
