  "events": [
    {
      "type": "dialogue",
      "timestamp": 22,
      "actor": "Mika",
      "action": "speak",
      "data": {
        "text": "\"It felt natural,\"",
        "line": 26
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not built for quiet,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Where will you go?\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Somewhere that needs defending. Somewhere that needs... action.\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"You saved us as much as we saved you,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We're even, then.\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 65,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The book's done,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm done.\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I know.\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"See you tomorrow,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 96,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"For Mika,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 98,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"She'd like those,\"",
        "line": 135
      }
    }
  ],
