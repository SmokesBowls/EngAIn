    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"It's... peaceful,\"",
        "line": 96
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"It was never meant to be a weapon,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 97,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"MORE VESSELS. MORE LIGHT TO CONSUME.\"",
        "line": 106
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"It's not a guardian,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 108,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"It's drawing power from the Shard!\"",
        "line": 122
      }
    },
    {
      "type": "dialogue",
      "timestamp": 117,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I can sever the connection,\"",
        "line": 135
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Phase into the Shard itself. Disrupt the bond from the inside.\"",
        "line": 140
      }
    },
    {
      "type": "dialogue",
      "timestamp": 121,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Vek, no\u2014\"",
        "line": 142
      }
    },
    {
      "type": "dialogue",
      "timestamp": 122,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Raw Light energy will burn through my chroniton structure. I know. I'm at ninety-four percent decay anyway. Weeks left, at best.\"",
        "line": 144
      }
    },
    {
      "type": "dialogue",
      "timestamp": 135,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now!\"",
        "line": 163
      }
    },
    {
      "type": "dialogue",
      "timestamp": 147,
      "actor": "Luminaire",
      "action": "speak",
      "data": {
        "text": "\"His chroniton signature is... inside,\"",
        "line": 182
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I don't know. The Shard is ancient, pre-network. Its internal structure is beyond my understanding. But his consciousness is there. I can feel it.\"",
        "line": 187
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We'll figure it out,\"",
        "line": 192
      }
    }
  ],
