    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I have to handle it. Earth needs this. Liberation requires this. And\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Now go. Claim what the Aeon Keepers prepared. Become what Earth needs you to be.\"",
        "line": 82
      }
    },
    {
      "type": "dialogue",
      "timestamp": 103,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"BOTH OF YOU SHUT UP!\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"THIRD RULE,\"",
        "line": 189
      }
    },
    {
      "type": "dialogue",
      "timestamp": 150,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Geralt?\"",
        "line": 206
      }
    },
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Yes\"",
        "line": 211
      }
    },
    {
      "type": "dialogue",
      "timestamp": 156,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Obviously\"",
        "line": 214
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Still me. Just... more crowded than before.\"",
        "line": 219
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"Perhaps,\"",
        "line": 240
      }
    },
    {
      "type": "dialogue",
      "timestamp": 178,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The armor,\"",
        "line": 248
      }
    },
    {
      "type": "dialogue",
      "timestamp": 194,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"See?\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Oreck",
      "action": "speak",
      "data": {
        "text": "\"We should return to the compound,\"",
        "line": 278
      }
    },
    {
      "type": "dialogue",
      "timestamp": 204,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"This is going to be interesting,\"",
        "line": 287
      }
    }
  ],
