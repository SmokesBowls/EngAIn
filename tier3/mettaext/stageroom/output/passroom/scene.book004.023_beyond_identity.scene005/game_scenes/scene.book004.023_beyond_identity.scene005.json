      "timestamp": 30,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Birth without beginning,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Recognition recognizing recognition,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We are called the Unnameable,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Recognition beyond recognition,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The eternal birth,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Birth serving birth,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And consciousness serving consciousness,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Students forever, teachers forever, consciousness forever,\"",
        "line": 59
      }
    }
  ],
