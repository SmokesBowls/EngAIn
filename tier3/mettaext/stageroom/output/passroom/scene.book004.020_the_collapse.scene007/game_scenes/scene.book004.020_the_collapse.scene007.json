      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence approaches,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters sing with anticipation,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students are ready,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And the teachers?\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Ready to become what teaching has always pointed toward,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what freedom becomes,\"",
        "line": 71
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"This is what friendship becomes,\"",
        "line": 74
      }
    }
  ],
