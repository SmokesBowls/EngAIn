    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"We are losing,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Saresh",
      "action": "speak",
      "data": {
        "text": "\"The desert is worse,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You ally with Anunnaki creatures while we die,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"The Brajor chose alliance,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"Convenient distinction,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're doomed,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"We're doomed if we accept them,\"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The Aeon Keepers,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We can't cross the Veil without their permission,\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"But the planet can touch both sides,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And ask for what?\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"The old defenses,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"We attempt communion,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 77,
      "actor": "Saresh",
      "action": "speak",
      "data": {
        "text": "\"And if the cost is too high?\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"Whatever they demand,\"",
        "line": 105
      }
    }
  ],
