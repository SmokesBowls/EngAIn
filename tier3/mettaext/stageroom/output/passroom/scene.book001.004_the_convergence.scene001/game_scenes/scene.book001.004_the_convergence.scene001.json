  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't tell.\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Everyone to the beach,\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"They don't know what we are,\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Some are afraid,\"",
        "line": 113
      }
    },
    {
      "type": "dialogue",
      "timestamp": 111,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"They're teaching each other,\"",
        "line": 148
      }
    },
    {
      "type": "dialogue",
      "timestamp": 157,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They're arguing about us,\"",
        "line": 207
      }
    },
    {
      "type": "dialogue",
      "timestamp": 181,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We hurt them,\"",
        "line": 238
      }
    },
    {
      "type": "dialogue",
      "timestamp": 196,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We can't undo the past,\"",
        "line": 257
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"Actions, not words,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 213,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We were wrong,\"",
        "line": 280
      }
    },
    {
      "type": "dialogue",
      "timestamp": 250,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They want to stay,\"",
        "line": 329
      }
    },
    {
      "type": "dialogue",
      "timestamp": 251,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"And the jade-greens?\"",
        "line": 331
      }
    },
    {
      "type": "dialogue",
      "timestamp": 252,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Uncertain. Torhh wants to trust. Some of the others... they need more time. More proof that we're not what they remember.\"",
        "line": 333
      }
    },
    {
      "type": "dialogue",
      "timestamp": 264,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 349
      }
    }
  ],
