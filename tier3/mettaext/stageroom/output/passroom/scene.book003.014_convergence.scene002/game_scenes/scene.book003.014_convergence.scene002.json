  "events": [
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We acknowledge summoning,\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Targets identified. Commencing purification operations.\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"No!\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You killed our allies,\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They were Anunnaki constructs,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"If the ASH GIANTS hadn't been so WEAK,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH!\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"I'm breaking connection,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"WAIT\u2014\"",
        "line": 100
      }
    }
  ],
