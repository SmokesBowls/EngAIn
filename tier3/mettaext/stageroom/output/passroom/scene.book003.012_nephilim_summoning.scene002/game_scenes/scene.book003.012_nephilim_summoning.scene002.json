  "events": [
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"We'll maintain it,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We understand cost. Show us anyway.\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We seek any weapon that can oppose the golden ones,\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Explain the requirements.\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"This will kill us,\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And if it doesn't survive? If we fracture?\"",
        "line": 111
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We have no real choice,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Korrhan",
      "action": "speak",
      "data": {
        "text": "\"I disagree,\"",
        "line": 124
      }
    }
  ],
