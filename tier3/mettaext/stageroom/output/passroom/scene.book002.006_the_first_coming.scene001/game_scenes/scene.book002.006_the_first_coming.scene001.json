  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Analysis,\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Primary Dominion designation confirmed,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Indigenous capability assessment,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Threat level?\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Minimal. The stone-entities possess significant physical strength and apparent vrill-conductivity, but lack coordinated military structure. The luminescent forms show sophisticated consciousness-crafting abilities but minimal defensive applications. Neither species demonstrates awareness of our presence. Recommended containment protocols: standard biological management with optional selective harvesting for vrill-extraction purposes.\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Deployment authorization,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Acknowledged. Dispatching Overseer Council for ground coordination. Initiating manufacturing protocol authorization. Preparing Igigi transport vessels and Reptilian genesis facilities.\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Standard protocol: monitor, assess, contain if interference occurs. Harvest if vrill-extraction becomes necessary. Eliminate only if direct threat to construction objectives is confirmed.\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Efficient,\"",
        "line": 77
      }
    }
  ],
