  "events": [
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Pythagoras",
      "action": "speak",
      "data": {
        "text": "\"Students achieve synthesis breakthrough at accelerated rates,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Synthesis",
      "action": "speak",
      "data": {
        "text": "\"Diversity enhances harmony when guided by wisdom sufficient for coordination rather than competition,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The network has achieved sustainability,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And evolution serves consciousness by creating ever-more sophisticated opportunities for transcendence,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Forty-seven advanced practitioners,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Beautiful chaos,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ooooo-aaaaa-uuuuu-eeeee-iiiii-ohhhhh-ahhhhhh-uhhhhhhh\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is graduation,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"This is what teaching was always pointing toward,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students have surpassed their teachers,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The network achieves independence,\"",
        "line": 71
      }
    }
  ],
