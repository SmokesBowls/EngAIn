    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Beyond",
      "action": "speak",
      "data": {
        "text": "\"Recognition,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what birth achieves,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Beyond",
      "action": "speak",
      "data": {
        "text": "\"And this is what students teach teachers,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 59,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Students and teachers,\"",
        "line": 62
