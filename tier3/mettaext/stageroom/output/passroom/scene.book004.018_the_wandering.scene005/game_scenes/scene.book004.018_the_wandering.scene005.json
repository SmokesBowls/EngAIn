  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The ice speaks of change,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are destabilizing,\"",
        "line": 41
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"How long?\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematical uncertainty extends across multiple probability branches, but convergence suggests... not long. Years, perhaps. Possibly less.\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"We could try to maintain the refuge,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Could,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The knowledge we've developed,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will not die,\"",
        "line": 62
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Someone must carry it forward.\"",
        "line": 64
      }
    }
  ],
