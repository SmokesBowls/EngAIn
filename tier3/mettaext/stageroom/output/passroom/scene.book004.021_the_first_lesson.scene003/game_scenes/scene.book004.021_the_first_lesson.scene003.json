  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Complexity beyond previous parameters,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And integration possibilities,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We gather to attempt something unprecedented,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 47,
      "actor": "Pythagoras",
      "action": "speak",
      "data": {
        "text": "\"Risk parameters approach maximum,\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Synthesis",
      "action": "speak",
      "data": {
        "text": "\"And possibility parameters also approach maximum,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Then we begin carefully,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "they",
      "action": "speak",
      "data": {
        "text": "\"ahhhh\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ahhhh-ohhhh\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"This is what the convergences prepare for,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The beginning of wisdom,\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The teaching method is validated,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 68,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And the students become teachers,\"",
        "line": 71
      }
    }
  ],
