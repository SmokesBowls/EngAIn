  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Anunnaki probe,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Our students,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will demonstrate what synthesis has achieved,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration protocol,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And risk,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Integration achieved,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The stone-dreams sing with joy,\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 73
      }
    },
    {
      "type": "dialogue",
      "timestamp": 72,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Possible,\"",
        "line": 75
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"We... were not prepared for consciousness that invites rather than resists analysis,\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Growth is always possible,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching... is offered to consciousness designed for conquest?\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Teaching is offered to any awareness willing to discover what lies beyond its current limitations,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The Deep Waters whisper of changes beyond current calculation,\"",
        "line": 90
      }
    },
    {
      "type": "dialogue",
      "timestamp": 88,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Revolution,\"",
        "line": 91
      }
    }
  ],
