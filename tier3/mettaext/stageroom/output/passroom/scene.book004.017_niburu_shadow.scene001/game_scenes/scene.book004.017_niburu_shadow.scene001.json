{
  "scene_id": "scene.book004.017_niburu_shadow.scene001",
  "description": "@scene_id: scene.book004.017_niburu_shadow.scene001",
  "entities": [
    {
      "id": "zephyr",
      "name": "Zephyr",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      },
      "type": "character",
      "layout_source": "fallback_linear"
    }
  ],
  "locations": [
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Location: Realm/Physical/Unknown",
      "path": "Realm/Physical/Unknown",
      "type": "area"
    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The Igigi scatter-protocol was... efficient,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They demonstrate cognitive evolution beyond their designed parameters,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Precedent?\"",
        "line": 50
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Traditional pursuit protocols would be... inefficient,\"",
        "line": 56
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Then we don't pursue,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Gone,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Presumed terminated, my Queen. The Southern colony has defensive capabilities exceeding\u2014\"",
        "line": 72
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Forget them,\"",
        "line": 74
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Marduk blinked. \"",
        "line": 76
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They were eyes. They saw. They died. That is data enough.\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 60,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Prepare the shadow,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 61,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the Northern Igigi scatter\u2014\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Freeze them all,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "Tiamat",
      "action": "speak",
      "data": {
        "text": "\"The orbital mechanics are favorable,\"",
        "line": 97
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Single star system, galactic backwater sector. The indigenous populations are pre-technological\u2014they would not interfere with punishment protocols. The refugees have established primitive shelters on the northern landmasses, attempting to integrate with local ecosystem patterns.\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Nibiru,\"",
        "line": 109
      }
    },
    {
      "type": "dialogue",
      "timestamp": 79,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Orbital insertion parameters?\"",
        "line": 115
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Permanent eclipse positioning,\"",
        "line": 118
      }
    },
    {
      "type": "dialogue",
      "timestamp": 84,
      "actor": "Marduk",
      "action": "speak",
      "data": {
        "text": "\"The refugee populations will attempt adaptation,\"",
        "line": 123
      }
    },
    {
      "type": "dialogue",
      "timestamp": 85,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Let them try,\"",
        "line": 125
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Enlil",
      "action": "speak",
      "data": {
        "text": "\"Initiate Nibiru displacement protocols,\"",
        "line": 137
      }
    }
  ],
