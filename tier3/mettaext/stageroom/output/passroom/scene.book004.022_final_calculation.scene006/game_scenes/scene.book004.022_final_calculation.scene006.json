  "events": [
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"They will not need teachers,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The work is complete,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 53,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The work is never complete,\"",
        "line": 64
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Until all consciousness everywhere learns to dance,\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Until consciousness discovers what it becomes when all dancing becomes one dance,\"",
        "line": 69
      }
    }
  ],
