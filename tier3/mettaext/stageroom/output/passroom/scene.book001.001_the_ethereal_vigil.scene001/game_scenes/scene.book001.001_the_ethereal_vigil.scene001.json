  "events": [
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The planetary core stabilizes,\"",
        "line": 34
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Tectonic plates settling into stable configurations,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Water coverage approximately seventy-two percent,\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Three thousand, four hundred and seventeen years,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"Since we lost our bodies,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 46,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"Physical form is limitation,\"",
        "line": 61
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Extend observation channels to surface level,\"",
        "line": 70
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"Pelagor,\"",
        "line": 89
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"Three thousand years of evolutionary pressure,\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"They went deep,\"",
        "line": 102
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"They retained the core abilities,\"",
        "line": 110
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"Look at the others,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 83,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"They have the potential,\"",
        "line": 114
      }
    },
    {
      "type": "dialogue",
      "timestamp": 86,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"The Pelagor survived,\"",
        "line": 119
      }
    },
    {
      "type": "dialogue",
      "timestamp": 87,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"And we,\"",
        "line": 121
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The system requires ground-level maintenance,\"",
        "line": 126
      }
    },
    {
      "type": "dialogue",
      "timestamp": 91,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"The Nephoretti,\"",
        "line": 128
      }
    },
    {
      "type": "dialogue",
      "timestamp": 92,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"It's been three thousand years since we've created Nephoretti,\"",
        "line": 130
      }
    },
    {
      "type": "dialogue",
      "timestamp": 93,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"We've done it before,\"",
        "line": 132
      }
    },
    {
      "type": "dialogue",
      "timestamp": 94,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"That was when we had physical bodies ourselves,\"",
        "line": 134
      }
    },
    {
      "type": "dialogue",
      "timestamp": 118,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"We should remember,\"",
        "line": 165
      }
    },
    {
      "type": "dialogue",
      "timestamp": 119,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"Which is precisely why they need the Nephoretti,\"",
        "line": 167
      }
    },
    {
      "type": "dialogue",
      "timestamp": 120,
      "actor": "Syreth",
      "action": "speak",
      "data": {
        "text": "\"And perhaps,\"",
        "line": 169
      }
    },
    {
      "type": "dialogue",
      "timestamp": 125,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"One thousand Nephoretti,\"",
        "line": 176
      }
    },
    {
      "type": "dialogue",
      "timestamp": 126,
      "actor": "Theron",
      "action": "speak",
      "data": {
        "text": "\"Manifested simultaneously,\"",
        "line": 178
      }
    },
    {
      "type": "dialogue",
      "timestamp": 127,
      "actor": "Vaelith",
      "action": "speak",
      "data": {
        "text": "\"And the intentions we craft into them?\"",
        "line": 180
      }
    },
    {
      "type": "dialogue",
      "timestamp": 139,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"We give them purpose, not instructions,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 140,
      "actor": "Korath",
      "action": "speak",
      "data": {
        "text": "\"A dangerous gift,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 141,
      "actor": "Lyaris",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 199
      }
    },
    {
      "type": "dialogue",
      "timestamp": 145,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Then let us begin,\"",
        "line": 205
      }
    },
    {
      "type": "dialogue",
      "timestamp": 183,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Prepare for the leap,\"",
        "line": 259
      }
    },
    {
      "type": "dialogue",
      "timestamp": 187,
      "actor": "Mordain",
      "action": "speak",
      "data": {
        "text": "\"Mark,\"",
        "line": 265
      }
    }
  ],
