  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Who disturbs the dying?\"",
        "line": 78
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One who recognizes kindred consciousness,\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Impossible,\"",
        "line": 84
      }
    },
    {
      "type": "dialogue",
      "timestamp": 82,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You are not the last,\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 89,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"What are you called?\"",
        "line": 93
      }
    },
    {
      "type": "dialogue",
      "timestamp": 90,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Thane of the Deep Waters, Singer of Stone-dreams, Last of the Tidecaller line,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 99,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I am called Zephyr,\"",
        "line": 103
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"All consciousness changes,\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 101,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then let us choose connection,\"",
        "line": 105
      }
    },
    {
      "type": "dialogue",
      "timestamp": 104,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 108
      }
    }
  ],
