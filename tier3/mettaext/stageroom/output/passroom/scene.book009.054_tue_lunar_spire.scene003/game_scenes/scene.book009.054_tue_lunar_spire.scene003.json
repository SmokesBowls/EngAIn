  "events": [
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"The Anchor arrives,\"",
        "line": 152
      }
    },
    {
      "type": "dialogue",
      "timestamp": 149,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I trained him. I watched him believe he could bear the weight of time through sheer will. I watched the moment his certainty shattered him.\"",
        "line": 157
      }
    },
    {
      "type": "dialogue",
      "timestamp": 159,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You don't move through time. You decide what resists change.\"",
        "line": 172
      }
    },
    {
      "type": "dialogue",
      "timestamp": 163,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"This fall is an event,\"",
        "line": 179
      }
    },
    {
      "type": "dialogue",
      "timestamp": 167,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Now,\"",
        "line": 185
      }
    },
    {
      "type": "dialogue",
      "timestamp": 173,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Causal Inertia Control,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Be in multiple outcomes at once\u2014and choose later.\"",
        "line": 210
      }
    },
    {
      "type": "dialogue",
      "timestamp": 209,
      "actor": "Kaelen",
      "action": "speak",
      "data": {
        "text": "\"Superposition,\"",
        "line": 244
      }
    },
    {
      "type": "dialogue",
      "timestamp": 221,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ENOUGH.\"",
        "line": 261
      }
    }
  ],
