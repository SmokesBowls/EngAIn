      "actor": "Ishara",
      "action": "speak",
      "data": {
        "text": "\"Are you well?\"",
        "line": 79
      }
    },
    {
      "type": "dialogue",
      "timestamp": 62,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"I... yes,\"",
        "line": 81
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Did she give you any insight into her strategic planning?\"",
        "line": 83
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I've been thinking about the Giant factions,\"",
        "line": 88
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Perhaps. Or perhaps the ocean-adapted ones don't realize their rituals are creating environmental conditions that harm their desert cousins. It's subtle. Easy to miss unless you're calculating cross-site atmospheric patterns.\"",
        "line": 94
      }
    }
  ],
