  "events": [
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"When it begins,\"",
        "line": 39
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Easy to say when you're at the center where conditions are balanced,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"Begin the convergence,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"Hold!\"",
        "line": 86
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The Tidecallers caused this,\"",
        "line": 92
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The desert tribes made it worse,\"",
        "line": 95
      }
    },
    {
      "type": "dialogue",
      "timestamp": 75,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"ALL OF YOU made this necessary,\"",
        "line": 98
      }
    }
  ],
