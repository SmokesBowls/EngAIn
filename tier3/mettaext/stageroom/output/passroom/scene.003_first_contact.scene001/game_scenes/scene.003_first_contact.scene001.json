  "events": [
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We should establish shelter,\"",
        "line": 45
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Shelter might seem threatening,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"We're already claiming land,\"",
        "line": 49
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow we try again,\"",
        "line": 63
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "someone",
      "action": "speak",
      "data": {
        "text": "\"And if they flee again?\"",
        "line": 65
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Then we learn from how they flee,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Rest now,\"",
        "line": 73
      }
    }
  ],
