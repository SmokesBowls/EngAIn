    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Torhh",
      "action": "speak",
      "data": {
        "text": "\"We shouldn't have to adjust our sacred practices for their comfort,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
