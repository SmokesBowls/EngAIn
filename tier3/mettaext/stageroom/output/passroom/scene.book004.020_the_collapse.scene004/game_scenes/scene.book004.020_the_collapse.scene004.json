  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Exponential growth patterns suggest readiness by Year 3,500,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The stone-dreams whisper of challenges approaching,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"Integration challenge,\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Not integration,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then we're preparing revolution,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Yes,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 55,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The students will need preparation for more than consciousness-crafting techniques,\"",
        "line": 58
      }
    },
    {
      "type": "dialogue",
      "timestamp": 57,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"They will need examples,\"",
        "line": 60
      }
    },
    {
      "type": "dialogue",
      "timestamp": 64,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Consciousness that learns to transcend its own limitations gains capacity to help others transcend theirs,\"",
        "line": 67
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And collective evolution serves individual synthesis when it creates contexts that support rather than restrict consciousness development, that encourage rather than punish the exploration of unprecedented possibilities,\"",
        "line": 69
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"The convergence of Year 3,500,\"",
        "line": 77
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Win or lose,\"",
        "line": 79
      }
    }
  ],
