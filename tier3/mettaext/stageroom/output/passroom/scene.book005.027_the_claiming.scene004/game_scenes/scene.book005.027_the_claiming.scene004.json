    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Illusion!\"",
        "line": 51
      }
    },
    {
      "type": "dialogue",
      "timestamp": 54,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"NO!\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 63,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'm not...\"",
        "line": 80
      }
    },
    {
      "type": "dialogue",
      "timestamp": 66,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"The armor,\"",
        "line": 85
      }
    },
    {
      "type": "dialogue",
      "timestamp": 67,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I'll be plural. Contested. Accountable not through external authority but through internal disagreement.\"",
        "line": 87
      }
    },
    {
      "type": "dialogue",
      "timestamp": 69,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You speak wisdom,\"",
        "line": 91
      }
    },
    {
      "type": "dialogue",
      "timestamp": 71,
      "actor": "Geralt",
      "action": "speak",
      "data": {
        "text": "\"I already am capable of atrocity,\"",
        "line": 94
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I can't promise I'll never abuse power. Can't guarantee I'll always choose correctly. But I can promise I'll never stop questioning myself. Never stop listening to voices that challenge me. Never become so certain of righteousness that I stop doubting my choices.\"",
        "line": 98
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Phase two complete. The trial of doubt. You acknowledge darkness within. Accept plurality rather than certainty. Perhaps...\"",
        "line": 104
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"One phase remains. The hardest. The one that determines whether you claim armor or die attempting.\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 80,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Free me,\"",
        "line": 112
      }
    },
    {
      "type": "dialogue",
      "timestamp": 81,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And in exchange, I grant you passage to what you seek.\"",
        "line": 114
      }
    }
  ],
