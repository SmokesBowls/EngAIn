  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 21,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Something's coming,\"",
        "line": 27
      }
    },
    {
      "type": "dialogue",
      "timestamp": 24,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Can't tell.\"",
        "line": 32
      }
    },
    {
      "type": "dialogue",
      "timestamp": 31,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Everyone to the beach,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 73,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"They don't know what we are,\"",
        "line": 99
      }
    },
    {
      "type": "dialogue",
      "timestamp": 74,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"Some are afraid,\"",
        "line": 101
      }
    },
    {
      "type": "dialogue",
      "timestamp": 100,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"They're teaching each other,\"",
        "line": 136
      }
    },
    {
      "type": "dialogue",
      "timestamp": 146,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They're arguing about us,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 170,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We hurt them,\"",
        "line": 226
      }
    },
    {
      "type": "dialogue",
      "timestamp": 185,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"We can't undo the past,\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 186,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"Actions, not words,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 202,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We were wrong,\"",
        "line": 268
      }
    },
    {
      "type": "dialogue",
      "timestamp": 239,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"They want to stay,\"",
        "line": 317
      }
    },
    {
      "type": "dialogue",
      "timestamp": 240,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"And the jade-greens?\"",
        "line": 319
      }
    },
    {
      "type": "dialogue",
      "timestamp": 241,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Uncertain. Torhh wants to trust. Some of the others... they need more time. More proof that we're not what they remember.\"",
        "line": 321
      }
    },
    {
      "type": "dialogue",
      "timestamp": 253,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Tomorrow,\"",
        "line": 337
      }
    }
  ],
