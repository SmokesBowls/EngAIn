  "events": [
    {
      "type": "dialogue",
      "timestamp": 153,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Listen,\"",
        "line": 193
      }
    },
    {
      "type": "dialogue",
      "timestamp": 154,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We are here to help them,\"",
        "line": 195
      }
    },
    {
      "type": "dialogue",
      "timestamp": 155,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"They're running from us,\"",
        "line": 197
      }
    },
    {
      "type": "dialogue",
      "timestamp": 171,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Gather the others,\"",
        "line": 217
      }
    },
    {
      "type": "dialogue",
      "timestamp": 184,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Why?\"",
        "line": 234
      }
    },
    {
      "type": "dialogue",
      "timestamp": 190,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"The energy signatures,\"",
        "line": 243
      }
    },
    {
      "type": "dialogue",
      "timestamp": 191,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"Remembers what?\"",
        "line": 245
      }
    },
    {
      "type": "dialogue",
      "timestamp": 192,
      "actor": "Elyraen",
      "action": "speak",
      "data": {
        "text": "\"I don't know yet,\"",
        "line": 247
      }
    },
    {
      "type": "dialogue",
      "timestamp": 197,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"Then we need to show them we're not what they remember,\"",
        "line": 254
      }
    },
    {
      "type": "dialogue",
      "timestamp": 198,
      "actor": "Olythae",
      "action": "speak",
      "data": {
        "text": "\"How?\"",
        "line": 256
      }
    },
    {
      "type": "dialogue",
      "timestamp": 211,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We wait,\"",
        "line": 272
      }
    },
    {
      "type": "dialogue",
      "timestamp": 212,
      "actor": "Vairis",
      "action": "speak",
      "data": {
        "text": "\"And if they're never ready?\"",
        "line": 274
      }
    },
    {
      "type": "dialogue",
      "timestamp": 225,
      "actor": "Senareth",
      "action": "speak",
      "data": {
        "text": "\"We give it time,\"",
        "line": 290
      }
    }
  ],
