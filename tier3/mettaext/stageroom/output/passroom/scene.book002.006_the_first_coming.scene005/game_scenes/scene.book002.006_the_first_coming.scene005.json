  "events": [
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"She's beautiful,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 34,
      "actor": "Ishara",
      "action": "speak",
      "data": {
        "text": "\"Naming feels like hope,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Hope is all we have.\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 41,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"They're preparing work assignments,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 42,
      "actor": "Ishara",
      "action": "speak",
      "data": {
        "text": "\"What will they have us build?\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "Pazuzu",
      "action": "speak",
      "data": {
        "text": "\"Something that will break this world,\"",
        "line": 57
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Will they fight?\"",
        "line": 66
      }
    },
    {
      "type": "dialogue",
      "timestamp": 51,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Mathematics suggests they will resist. Whether that resistance proves sufficient...\"",
        "line": 68
      }
    }
  ],
