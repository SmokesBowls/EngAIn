    }
  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I was the blade that cut the unworthy... the chain that broke the defiant... the guardian who forgot what she guarded.\"",
        "line": 44
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Tell me, mortals\u2014whose freedom do you wear in your skin?\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"We seek the Dragon Mail,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Guard?\"",
        "line": 54
      }
    },
    {
      "type": "dialogue",
      "timestamp": 43,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You, slave-who-speaks. You, who carries parasite and seeks god-consciousness. You think yourself worthy?\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 48,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"FOOLISH!\"",
        "line": 68
      }
    },
    {
      "type": "dialogue",
      "timestamp": 70,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"You...\"",
        "line": 100
      }
    },
    {
      "type": "dialogue",
      "timestamp": 76,
      "actor": "she",
      "action": "speak",
      "data": {
        "text": "\"Phase one complete,\"",
        "line": 108
      }
    },
    {
      "type": "dialogue",
      "timestamp": 78,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But recognition alone is insufficient. Now\u2014survive the doubt.\"",
        "line": 112
      }
    }
  ],
