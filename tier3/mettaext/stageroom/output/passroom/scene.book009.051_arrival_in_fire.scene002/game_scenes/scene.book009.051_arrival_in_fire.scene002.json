  "scene_id": "scene.book009.051_arrival_in_fire.scene002",
  "description": "@scene_id: scene.book009.051_arrival_in_fire.scene002",
  "entities": [
    {
      "id": "geralt",
      "name": "Geralt",
      "health": 100.0,
      "max_health": 100.0,
      "position": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      },
