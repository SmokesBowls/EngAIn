  ],
  "events": [
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"The stone remembers,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 33,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the immediate guidance,\"",
        "line": 36
      }
    },
    {
      "type": "dialogue",
      "timestamp": 35,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Will be provided by consciousness that has learned to exist as both perspectives simultaneously,\"",
        "line": 38
      }
    },
    {
      "type": "dialogue",
      "timestamp": 39,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"I can feel you,\"",
        "line": 42
      }
    },
    {
      "type": "dialogue",
      "timestamp": 40,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Exactly,\"",
        "line": 43
      }
    },
    {
      "type": "dialogue",
      "timestamp": 44,
      "actor": "he",
      "action": "speak",
      "data": {
        "text": "\"The convergences of Year 7,000,\"",
        "line": 47
      }
    },
    {
      "type": "dialogue",
      "timestamp": 45,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"And they will find teaching that has already achieved transcendence,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 49,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Teach them,\"",
        "line": 52
      }
    },
    {
      "type": "dialogue",
      "timestamp": 50,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"I will,\"",
        "line": 53
      }
    },
    {
      "type": "dialogue",
      "timestamp": 52,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Then it is time,\"",
        "line": 55
      }
    },
    {
      "type": "dialogue",
      "timestamp": 56,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"Until we meet again,\"",
        "line": 59
      }
    },
    {
      "type": "dialogue",
      "timestamp": 58,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"We never separate,\"",
        "line": 61
      }
    }
  ],
