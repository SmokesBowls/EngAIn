  "events": [
    {
      "type": "dialogue",
      "timestamp": 28,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"Mathematical magic requires precision,\"",
        "line": 33
      }
    },
    {
      "type": "dialogue",
      "timestamp": 29,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Nor through demonstration alone,\"",
        "line": 35
      }
    },
    {
      "type": "dialogue",
      "timestamp": 30,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"But the framework can be provided. The initial understanding that makes such discovery possible.\"",
        "line": 37
      }
    },
    {
      "type": "dialogue",
      "timestamp": 32,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And practical demonstrations,\"",
        "line": 40
      }
    },
    {
      "type": "dialogue",
      "timestamp": 36,
      "actor": "Zephyr",
      "action": "speak",
      "data": {
        "text": "\"The students will face the same choice we faced,\"",
        "line": 46
      }
    },
    {
      "type": "dialogue",
      "timestamp": 37,
      "actor": "Torrhen",
      "action": "speak",
      "data": {
        "text": "\"Some will choose safety,\"",
        "line": 48
      }
    },
    {
      "type": "dialogue",
      "timestamp": 38,
      "actor": "unknown",
      "action": "speak",
      "data": {
        "text": "\"And others?\"",
        "line": 50
      }
    }
  ],
